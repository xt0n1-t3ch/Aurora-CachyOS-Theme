+/// Width of a graph line, in pixels.
+const STROKE_WIDTH: f32 = 1.5;
+
+/// How much of the fill's opacity is left at the far end of the gradient: the fill fades away from
+/// the line, so the line stays the strongest mark and stacked areas stay readable.
+const FILL_FADE: f32 = 0.25;
+
+/// Fills `path` with `color`, at full fill opacity at the highest point of the curve and fading toward
+/// the baseline. The gradient spans the filled area, not the whole graph, so a low curve keeps a
+/// visible fill.
+fn append_gradient_fill(
+    snapshot: &Snapshot,
+    path: &Path,
+    color: &gdk::RGBA,
+    width: f32,
+    height: f32,
+    fill: &FillingSettings,
+) {
+    let faded = gdk::RGBA::new(
+        color.red(),
+        color.green(),
+        color.blue(),
+        color.alpha() * FILL_FADE,
+    );
+    let bounds = path
+        .bounds()
+        .unwrap_or_else(|| gtk::graphene::Rect::new(0., 0., width, height));
+    let (line_side, baseline) = match fill {
+        FillingSettings::FillToTop => (bounds.y() + bounds.height(), bounds.y()),
+        _ => (bounds.y(), bounds.y() + bounds.height()),
+    };
+
+    snapshot.push_fill(path, FillRule::Winding);
+    snapshot.append_linear_gradient(
+        &gtk::graphene::Rect::new(0., 0., width, height),
+        &gtk::graphene::Point::new(0., line_side),
+        &gtk::graphene::Point::new(0., baseline),
+        &[ColorStop::new(0., *color), ColorStop::new(1., faded)],
+    );
+    snapshot.pop();
+}
