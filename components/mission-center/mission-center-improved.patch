+//! Colors the user picked for single devices, stored in the `performance-sidebar-device-colors`
+//! setting as `<device>:#rrggbb` entries joined by `;`. Device names are encoded as in the
+//! visibility overrides, so a name holding `;` or `:` survives the round trip.
+
+use std::collections::HashMap;
+
+use gtk::{gdk, gio, glib, prelude::*};
+
+use super::summary_graph::{decode_device_name, encode_device_name};
+
+pub const SETTINGS_KEY: &str = "performance-sidebar-device-colors";
+
+/// A color without transparency; graphs derive their fill and grid from it.
+#[derive(Debug, Clone, Copy, PartialEq, Eq)]
+pub struct Rgb(pub [u8; 3]);
+
+impl Rgb {
+    pub fn from_hex(hex: &str) -> Option<Self> {
+        let digits = hex.strip_prefix('#')?;
+        if digits.len() != 6 || !digits.is_ascii() {
+            return None;
+        }
+        let channel = |at: usize| u8::from_str_radix(&digits[at..at + 2], 16).ok();
+        Some(Self([channel(0)?, channel(2)?, channel(4)?]))
+    }
+
+    pub fn to_hex(self) -> String {
+        let [r, g, b] = self.0;
+        format!("#{r:02x}{g:02x}{b:02x}")
+    }
+
+    pub fn from_rgba(rgba: &gdk::RGBA) -> Self {
+        let channel = |value: f32| (value.clamp(0., 1.) * 255.).round() as u8;
+        Self([
+            channel(rgba.red()),
+            channel(rgba.green()),
+            channel(rgba.blue()),
+        ])
+    }
+
+    pub fn to_rgba(self) -> gdk::RGBA {
+        let [r, g, b] = self.0;
+        gdk::RGBA::new(r as f32 / 255., g as f32 / 255., b as f32 / 255., 1.)
+    }
+}
+
+/// Reads the stored colors. Entries that do not parse are skipped.
+pub fn parse(raw: &str) -> HashMap<String, Rgb> {
+    raw.split(';')
+        .filter(|entry| !entry.is_empty())
+        .filter_map(|entry| {
+            let (name, hex) = entry.rsplit_once(':')?;
+            Some((decode_device_name(name), Rgb::from_hex(hex)?))
+        })
+        .collect()
+}
+
+/// Writes the colors in name order, so equal maps give equal settings.
+pub fn serialize(colors: &HashMap<String, Rgb>) -> String {
+    let mut entries: Vec<String> = colors
+        .iter()
+        .map(|(name, color)| format!("{}:{}", encode_device_name(name), color.to_hex()))
+        .collect();
+    entries.sort_unstable();
+    entries.join(";")
+}
+
+/// The color the user picked for `device`, if any.
+pub fn custom_color(settings: &gio::Settings, device: &str) -> Option<Rgb> {
+    parse(&settings.string(SETTINGS_KEY)).get(device).copied()
+}
+
+/// Stores the color of `device`; `None` goes back to the default color.
+pub fn set_custom_color(settings: &gio::Settings, device: &str, color: Option<Rgb>) {
+    let mut colors = parse(&settings.string(SETTINGS_KEY));
+    let changed = match color {
+        Some(color) => colors.insert(device.to_owned(), color) != Some(color),
+        None => colors.remove(device).is_some(),
+    };
+    if !changed {
+        return;
+    }
+    if settings.set_string(SETTINGS_KEY, &serialize(&colors)).is_err() {
+        glib::g_warning!(
+            "MissionCenter::PerformancePage",
+            "Failed to set {} setting",
+            SETTINGS_KEY
+        );
+    }
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+
+    #[test]
+    fn colors_round_trip_through_the_settings_string() {
+        let mut colors = HashMap::new();
+        colors.insert("cpu".to_owned(), Rgb([0x1c, 0x71, 0xd8]));
+        colors.insert("gpu-0000:2B:00.0".to_owned(), Rgb([0xff, 0x00, 0x7f]));
+        colors.insert("net-a;b".to_owned(), Rgb([0, 0, 0]));
+
+        let raw = serialize(&colors);
+        assert_eq!(parse(&raw), colors);
+    }
+
+    #[test]
+    fn the_settings_string_is_sorted_and_lowercase() {
+        let mut colors = HashMap::new();
+        colors.insert("memory".to_owned(), Rgb([0xAB, 0xCD, 0xEF]));
+        colors.insert("cpu".to_owned(), Rgb([1, 2, 3]));
+        assert_eq!(serialize(&colors), "cpu:#010203;memory:#abcdef");
+    }
+
+    #[test]
+    fn a_pci_address_in_a_device_name_keeps_its_colons() {
+        let parsed = parse("gpu-0000%3A2B%3A00.0:#f66151");
+        assert_eq!(parsed.get("gpu-0000:2B:00.0"), Some(&Rgb([0xf6, 0x61, 0x51])));
+    }
+
+    #[test]
+    fn broken_entries_are_skipped() {
+        let parsed = parse("cpu:#12345;memory:blue;disk-sda:#00ff00;:#zzzzzz;fan-4-1");
+        assert_eq!(parsed.len(), 1);
+        assert_eq!(parsed.get("disk-sda"), Some(&Rgb([0, 0xff, 0])));
+    }
+
+    #[test]
+    fn a_color_survives_the_trip_through_gdk() {
+        for color in [Rgb([0, 0, 0]), Rgb([0x81, 0x3d, 0x9c]), Rgb([255, 255, 255])] {
+            assert_eq!(Rgb::from_rgba(&color.to_rgba()), color);
+        }
+    }
+}
