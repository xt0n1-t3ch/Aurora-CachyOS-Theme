@@ -0,0 +1,279 @@
+/* aurora-pages.css
+ *
+ * Copyright 2026 xt0n1-t3ch
+ *
+ * This program is free software: you can redistribute it and/or modify
+ * it under the terms of the GNU General Public License as published by
+ * the Free Software Foundation, either version 3 of the License, or
+ * (at your option) any later version.
+ *
+ * SPDX-License-Identifier: GPL-3.0-or-later
+ */
+
+/* Aurora: the glass look of what Mission Center's pages hold (tables, heat tint, filter chips, the Performance
+ * details), loaded with aurora.css above the user's sheet. Its rules apply only to a window with the `aurora-glass`
+ * class and use the colors aurora.css defines there. */
+
+/* Apps and Services: the table sits on a glass card under the page's heading, its column headings on the card's top
+ * edge. The card clips its rows to its corners. Its right edge lines up with the window buttons' capsule, 22 px from
+ * the window's edge, where the page itself keeps 8. */
+window.aurora-glass scrolledwindow.mc-table {
+    margin: 0 14px 16px 16px;
+    border-top: none;
+    border-radius: 14px;
+    background-color: var(--aurora-card);
+    box-shadow: inset 0 1px rgba(255, 255, 255, 0.12), inset 0 0 0 1px rgba(255, 255, 255, 0.05);
+}
+
+window.aurora-glass columnview {
+    background: none;
+}
+
+window.aurora-glass columnview > header {
+    padding-top: 4px;
+    padding-bottom: 2px;
+    border-bottom: 1px solid rgba(255, 255, 255, 0.07);
+}
+
+/* Column headings are buttons inside the page's stack too, so they undo the page pills' size: libadwaita's own
+ * 3 px by 6 px padding keeps each column as narrow as its heading. */
+window.aurora-glass columnview > header > button:not(.flat):not(.circular):not(.toggle-pane-button) {
+    min-height: 0;
+    padding: 3px 6px;
+    border: none;
+    border-image: none;
+    border-radius: 0;
+    background: none;
+    box-shadow: none;
+}
+
+window.aurora-glass columnview > header > button > box {
+    color: rgba(255, 255, 255, 0.62);
+    font-weight: 600;
+    border-spacing: 0;
+}
+
+window.aurora-glass columnview > header > button:hover > box {
+    color: rgba(255, 255, 255, 0.86);
+}
+
+/* A heading keeps no room for the sort arrow until its column is sorted: the empty 16 px slot made every reading
+ * column wider than its values and pushed the table past the window's width. */
+window.aurora-glass columnview > header > button sort-indicator:not(.ascending):not(.descending) {
+    min-width: 0;
+    min-height: 0;
+}
+
+window.aurora-glass columnview > header > button sort-indicator.ascending,
+window.aurora-glass columnview > header > button sort-indicator.descending {
+    margin: 0 4px;
+}
+
+/* Rows are capsules; the selected one is lit in the accent. Horizontal margins stay as the stock 2 px at the start:
+ * any more widens the table's minimum width. */
+window.aurora-glass columnview > listview > row {
+    border-radius: 10px;
+    margin: 1px 0 1px 2px;
+    background-color: transparent;
+    box-shadow: none;
+}
+
+window.aurora-glass columnview > listview > row:hover {
+    background-color: rgba(255, 255, 255, 0.05);
+}
+
+window.aurora-glass columnview > listview > row:selected {
+    background-color: rgba(10, 132, 255, 0.26);
+    box-shadow: inset 0 0 0 1px rgba(10, 132, 255, 0.55);
+    color: inherit;
+}
+
+/* Each level of the process tree steps in by 16 px instead of the theme's 22, so a tree ten levels deep (a terminal's
+ * shells and tools are often that deep) still leaves the table narrow enough for the device sidebar beside it. */
+window.aurora-glass columnview treeexpander {
+    border-spacing: 4px;
+}
+
+window.aurora-glass columnview treeexpander > indent {
+    -gtk-icon-size: 12px;
+}
+
+/* The section headings (Apps, Processes, User Services, System Services) read as headings, never as a selection:
+ * the table selects the first one when it opens (src/table_view/columns/name_cell.rs marks their rows). */
+window.aurora-glass columnview > listview > row.aurora-section,
+window.aurora-glass columnview > listview > row.aurora-section:hover,
+window.aurora-glass columnview > listview > row.aurora-section:selected {
+    background-color: transparent;
+    box-shadow: none;
+}
+
+window.aurora-glass columnview > listview > row.aurora-section label.heading {
+    font-size: 1.07em;
+}
+
+/* Heat tint (src/table_view/columns/heat.rs): a busy cell gets a rounded tint inset from its neighbours, as Windows
+ * 11's Task Manager shades a busy column. Shares of the CPU and the GPU are tinted in the accent blue, memory and
+ * throughput in amber; each deepens with its step. The borders take the inset out of the stock 8 px by 6 px padding,
+ * so a tinted cell is exactly as large as a clear one and no column moves. The 1 px start border stays the stock
+ * column separator. */
+window.aurora-glass columnview > listview > row > cell.heat-low,
+window.aurora-glass columnview > listview > row > cell.heat-medium,
+window.aurora-glass columnview > listview > row > cell.heat-high,
+window.aurora-glass columnview > listview > row > cell.heat-peak {
+    border-top: 2px solid transparent;
+    border-right: 2px solid transparent;
+    border-bottom: 2px solid transparent;
+    padding: 6px 4px 6px 6px;
+    border-radius: 8px;
+    background-clip: padding-box;
+}
+
+window.aurora-glass columnview cell.heat-low {
+    background-color: rgba(255, 176, 64, 0.10);
+}
+
+window.aurora-glass columnview cell.heat-medium {
+    background-color: rgba(255, 160, 52, 0.19);
+}
+
+window.aurora-glass columnview cell.heat-high {
+    background-color: rgba(255, 140, 44, 0.30);
+}
+
+window.aurora-glass columnview cell.heat-peak {
+    background-color: rgba(255, 96, 64, 0.40);
+}
+
+window.aurora-glass columnview cell.heat-share.heat-low {
+    background-color: rgba(10, 132, 255, 0.12);
+}
+
+window.aurora-glass columnview cell.heat-share.heat-medium {
+    background-color: rgba(10, 132, 255, 0.22);
+}
+
+window.aurora-glass columnview cell.heat-share.heat-high {
+    background-color: rgba(10, 132, 255, 0.34);
+}
+
+window.aurora-glass columnview cell.heat-share.heat-peak {
+    background-color: rgba(64, 120, 255, 0.48);
+}
+
+/* Services' state filters: one glass chip each; a chip that filters is lit in the accent. */
+window.aurora-glass .aurora-chips > button.toggle:not(.flat):not(.circular):not(.toggle-pane-button) {
+    border-radius: 9999px;
+    padding: 3px 12px;
+}
+
+window.aurora-glass .aurora-chips > button.toggle:checked {
+    background-color: rgba(10, 132, 255, 0.30);
+    box-shadow: inset 0 0 0 1px rgba(10, 132, 255, 0.60);
+}
+
+/* The Performance page's details column (src/performance_page/tiles.rs): each reading is a glass tile, and the facts
+ * below them sit on one card. The column itself is clear; its 4 px top margin lines the first tiles up with the top
+ * of the graphs, which sit 65 px below the column's top in every device's layout file (the `root` margin). Its right
+ * edge lines up with the window buttons' capsule, 22 px from the window's edge. */
+window.aurora-glass scrolledwindow.aurora-card {
+    margin: 4px 12px 10px 2px;
+    background: none;
+    box-shadow: none;
+}
+
+window.aurora-glass .aurora-stat {
+    padding: 8px 12px 10px 12px;
+    border-radius: 12px;
+    background-color: var(--aurora-tile);
+    box-shadow: inset 0 1px rgba(255, 255, 255, 0.12), inset 0 0 0 1px rgba(255, 255, 255, 0.05);
+}
+
+window.aurora-glass .aurora-stat label.caption {
+    color: rgba(255, 255, 255, 0.66);
+}
+
+window.aurora-glass .aurora-stat label.title-4 {
+    font-size: 1.15em;
+}
+
+/* The facts card spans the facts' rows and reaches 10 px past their first and last line; its start and end
+ * labels keep the tiles' 12 px inset. Its minimum height offsets the negative margins, as GTK refuses a negative
+ * size. */
+window.aurora-glass .aurora-facts {
+    margin: -10px 0;
+    min-height: 20px;
+    border-radius: 12px;
+    background-color: var(--aurora-card);
+    box-shadow: inset 0 1px rgba(255, 255, 255, 0.10), inset 0 0 0 1px rgba(255, 255, 255, 0.05);
+}
+
+window.aurora-glass label.aurora-fact-start {
+    padding-left: 12px;
+}
+
+window.aurora-glass label.aurora-fact-end {
+    padding-right: 12px;
+}
+
+/* A drive's partitions (disk_details.blp, src/performance_page/widgets/partition_usage_item.rs) sit on one card under
+ * the facts and as wide as theirs, a row each with a hairline between rows (style.h, HAIRLINE). Their heading is
+ * File Explorer's sidebar section title, 11 px semibold secondary text (sidebar.cpp), lined up with the card's text. */
+window.aurora-glass label.aurora-section-title {
+    margin-left: 12px;
+    font-size: 11px;
+    font-weight: 600;
+    color: rgba(235, 235, 245, 0.59);
+}
+
+window.aurora-glass list.aurora-partitions {
+    margin-top: 6px;
+    border-radius: 12px;
+    background-color: var(--aurora-card);
+    box-shadow: inset 0 1px rgba(255, 255, 255, 0.10), inset 0 0 0 1px rgba(255, 255, 255, 0.05);
+}
+
+window.aurora-glass list.aurora-partitions > row {
+    padding: 5px 12px;
+    border-bottom: 1px solid rgba(255, 255, 255, 0.078);
+    background: none;
+}
+
+window.aurora-glass list.aurora-partitions > row:last-child {
+    border-bottom: none;
+}
+
+window.aurora-glass list.aurora-partitions .dim-label {
+    opacity: 1;
+    color: rgba(235, 235, 245, 0.59);
+}
+
+/* The usage bar is File Explorer's capacity bar (sidebar.cpp): a round track, a fill that brightens toward its end in
+ * the accent, amber past 90 % used and red past 95 % (core/drives.h, `Capacity`). */
+window.aurora-glass list.aurora-partitions progressbar {
+    margin: 7px 0 5px 0;
+}
+
+window.aurora-glass list.aurora-partitions progressbar > trough,
+window.aurora-glass list.aurora-partitions progressbar > trough > progress {
+    min-height: 4px;
+    border: none;
+    border-radius: 9999px;
+    box-shadow: none;
+}
+
+window.aurora-glass list.aurora-partitions progressbar > trough {
+    background-color: rgba(255, 255, 255, 0.14);
+}
+
+window.aurora-glass list.aurora-partitions progressbar > trough > progress {
+    background-color: transparent;
+    background-image: linear-gradient(to right, #0a84ff, rgb(100, 182, 255));
+}
+
+window.aurora-glass list.aurora-partitions progressbar.aurora-capacity-low > trough > progress {
+    background-image: linear-gradient(to right, rgb(255, 159, 10), rgb(255, 196, 92));
+}
+
+window.aurora-glass list.aurora-partitions progressbar.aurora-capacity-critical > trough > progress {
+    background-image: linear-gradient(to right, rgb(255, 69, 58), rgb(255, 128, 112));
+}
diff --git a/resources/ui/aurora-popups.css b/resources/ui/aurora-popups.css
new file mode 100644
index 0000000..d33d18c
--- /dev/null
+++ b/resources/ui/aurora-popups.css
@@ -0,0 +1,195 @@
+/* aurora-popups.css
+ *
+ * Copyright 2026 xt0n1-t3ch
+ *
+ * This program is free software: you can redistribute it and/or modify
+ * it under the terms of the GNU General Public License as published by
+ * the Free Software Foundation, either version 3 of the License, or
+ * (at your option) any later version.
+ *
+ * SPDX-License-Identifier: GPL-3.0-or-later
+ */
+
+/* Aurora: what opens over Mission Center's glass window, as File Explorer draws it: menus, popovers and tooltips are
+ * glass that KWin blurs (components/file-explorer/src/finderstyle.cpp), dialogs are opaque in File Explorer's dialog
+ * colors (style.cpp, darkPalette). src/glass.rs loads it last; its rules apply only inside a window with the
+ * `aurora-glass` class. KWin blurs behind every popover and tooltip and draws its shadow (src/popups.rs): a shadow
+ * drawn here would widen the popup's surface past its body, and KWin 6.8 would put the blur off by as much. */
+
+/* Menus: one sheet of glass 11 px round, at least 180 px wide, with 5 px above the first row and below the last
+ * (style.h, MENU_RADIUS and MENU_FILL; finderstyle.cpp, MENU_MIN_WIDTH and PM_MenuVMargin). Its rim is lighter along
+ * the top, as style.cpp's paintGlass draws it. */
+window.aurora-glass popover.menu > contents {
+    min-width: 180px;
+    padding: 5px 0;
+    border: none;
+    border-radius: 11px;
+    background-color: rgba(36, 36, 40, 0.81);
+    box-shadow: inset 0 1px rgba(255, 255, 255, 0.13), inset 0 0 0 1px rgba(255, 255, 255, 0.09);
+}
+
+/* A row is 24 px tall with its text 14 px in from the menu's sides. The row under the pointer or the keyboard is an
+ * accent pill 6 px round and 5 px in from them (finderstyle.cpp, drawMenuItem; MENU_ITEM_HEIGHT). GTK marks a row
+ * `:selected` and focuses it, and as a menu opens it does so to the first row: that one alone, focused but neither
+ * under the pointer nor reached with the keys, gets no pill, so a menu opened with the mouse shows none, as File
+ * Explorer's. A row whose submenu is open keeps it, having handed the focus to the submenu (measured in the
+ * sandbox). The pill alone shows where the keyboard is, so the rows draw no focus ring. */
+window.aurora-glass popover.menu modelbutton {
+    min-height: 24px;
+    min-width: 0;
+    margin: 0 5px;
+    padding: 0 9px;
+    border-radius: 6px;
+    outline: none;
+    background: none;
+    box-shadow: none;
+    color: rgba(255, 255, 255, 0.925);
+    transition: none;
+}
+
+window.aurora-glass popover.menu modelbutton:selected:hover,
+window.aurora-glass popover.menu modelbutton:selected:focus-visible,
+window.aurora-glass popover.menu modelbutton:selected:not(:focus) {
+    background-color: #0a84ff;
+    color: white;
+}
+
+window.aurora-glass popover.menu modelbutton:disabled {
+    color: rgba(235, 235, 245, 0.32);
+}
+
+/* Shortcuts stand 28 px past their label and, with the submenu chevron, are secondary text, lighter on the pill
+ * (MENU_SHORTCUT_GAP, TEXT_SECONDARY). */
+window.aurora-glass popover.menu modelbutton accelerator {
+    margin-left: 28px;
+    color: rgba(235, 235, 245, 0.59);
+}
+
+window.aurora-glass popover.menu modelbutton arrow {
+    min-width: 12px;
+    min-height: 12px;
+    margin: 0 -3px 0 8px;
+    -gtk-icon-size: 12px;
+    background: none;
+    box-shadow: none;
+    color: rgba(235, 235, 245, 0.59);
+}
+
+window.aurora-glass popover.menu modelbutton:selected:hover accelerator,
+window.aurora-glass popover.menu modelbutton:selected:hover arrow,
+window.aurora-glass popover.menu modelbutton:selected:focus-visible accelerator,
+window.aurora-glass popover.menu modelbutton:selected:focus-visible arrow,
+window.aurora-glass popover.menu modelbutton:selected:not(:focus) accelerator,
+window.aurora-glass popover.menu modelbutton:selected:not(:focus) arrow {
+    color: rgba(255, 255, 255, 0.82);
+}
+
+/* A menu of choices keeps an 18 px column for the check mark, which only the chosen row shows (MENU_CHECK_WIDTH). */
+window.aurora-glass popover.menu modelbutton check,
+window.aurora-glass popover.menu modelbutton radio {
+    min-width: 12px;
+    min-height: 12px;
+    margin: 0 6px 0 0;
+    padding: 0;
+    border: none;
+    border-radius: 0;
+    background: none;
+    box-shadow: none;
+    -gtk-icon-source: none;
+    -gtk-icon-size: 12px;
+    color: inherit;
+}
+
+window.aurora-glass popover.menu modelbutton check:checked,
+window.aurora-glass popover.menu modelbutton radio:checked {
+    -gtk-icon-source: -gtk-icontheme("object-select-symbolic");
+}
+
+/* Sections part with a hairline 12 px in from the left side and 11 from the right, in an 11 px gap
+ * (MENU_SEPARATOR_HEIGHT, MENU_SEPARATOR). */
+window.aurora-glass popover.menu separator {
+    min-height: 1px;
+    margin: 5px 11px 5px 12px;
+    background-color: rgba(255, 255, 255, 0.10);
+}
+
+/* A drop-down's choices read as menu rows: the one under the pointer is the pill, the chosen one keeps its check
+ * mark only. */
+window.aurora-glass popover.menu listview > row {
+    min-height: 24px;
+    margin: 0 5px;
+    padding: 0 9px;
+    border-radius: 6px;
+    background: none;
+    color: rgba(255, 255, 255, 0.925);
+}
+
+window.aurora-glass popover.menu listview > row:hover {
+    background-color: #0a84ff;
+    color: white;
+}
+
+/* Other popovers are the same glass around what they hold. Popovers that keep their tail get it in the glass's
+ * color. */
+window.aurora-glass popover:not(.menu) > contents {
+    padding: 6px;
+    border: none;
+    border-radius: 11px;
+    background-color: rgba(36, 36, 40, 0.81);
+    box-shadow: inset 0 1px rgba(255, 255, 255, 0.13), inset 0 0 0 1px rgba(255, 255, 255, 0.09);
+}
+
+window.aurora-glass popover > arrow {
+    border: none;
+    background-color: rgba(36, 36, 40, 0.81);
+    box-shadow: none;
+}
+
+/* Tooltips: smaller glass, 8 px round and a step lighter (finderstyle.cpp, TOOLTIP_RADIUS and TOOLTIP_FILL). */
+window.aurora-glass tooltip {
+    padding: 4px 8px;
+    border: none;
+    border-radius: 8px;
+    background-color: rgba(44, 44, 48, 0.88);
+    box-shadow: inset 0 1px rgba(255, 255, 255, 0.13), inset 0 0 0 1px rgba(255, 255, 255, 0.09);
+    color: rgba(255, 255, 255, 0.925);
+}
+
+window.aurora-glass tooltip label {
+    padding: 0;
+}
+
+/* Dialogs are opaque in File Explorer's dialog window color, with the window's rim and corners. What they hold reads
+ * the same color, so no page or list inside paints the GTK theme's grey over it. */
+window.aurora-glass floating-sheet > sheet,
+window.aurora-glass bottom-sheet > sheet {
+    --window-bg-color: rgb(30, 30, 32);
+    --view-bg-color: rgb(30, 30, 32);
+    --dialog-bg-color: rgb(30, 30, 32);
+    background-color: rgb(30, 30, 32);
+}
+
+window.aurora-glass floating-sheet > sheet {
+    border-radius: 14px;
+    outline: none;
+    box-shadow: inset 0 1px var(--aurora-rim-top), inset 0 0 0 1px var(--aurora-rim), 0 14px 40px rgba(0, 0, 0, 0.45),
+                0 0 0 1px rgba(0, 0, 0, 0.35);
+}
+
+/* Grouped rows (a dialog's facts, Preferences' settings) sit on one card, as the pages' facts do (aurora-pages.css),
+ * with a hairline between rows (style.h, HAIRLINE). */
+window.aurora-glass list.boxed-list {
+    border: none;
+    border-radius: 12px;
+    background-color: rgba(255, 255, 255, 0.05);
+    box-shadow: inset 0 1px rgba(255, 255, 255, 0.10), inset 0 0 0 1px rgba(255, 255, 255, 0.05);
+}
+
+window.aurora-glass list.boxed-list > row {
+    border-bottom: 1px solid rgba(255, 255, 255, 0.078);
+    background-color: transparent;
+}
+
+window.aurora-glass list.boxed-list > row:last-child {
+    border-bottom: none;
+}
diff --git a/resources/ui/aurora.css b/resources/ui/aurora.css
new file mode 100644
index 0000000..5d92d37
--- /dev/null
+++ b/resources/ui/aurora.css
@@ -0,0 +1,167 @@
+/* aurora.css
+ *
+ * Copyright 2026 xt0n1-t3ch
+ *
+ * This program is free software: you can redistribute it and/or modify
+ * it under the terms of the GNU General Public License as published by
+ * the Free Software Foundation, either version 3 of the License, or
+ * (at your option) any later version.
+ *
+ * SPDX-License-Identifier: GPL-3.0-or-later
+ */
+
+/* Aurora: Mission Center's glass look, the window's shell; aurora-header.css styles the header bars, aurora-pages.css
+ * what the pages hold and aurora-popups.css what opens over them. src/glass.rs loads the four sheets, in that order,
+ * above the user's sheet (~/.config/gtk-4.0/gtk.css), because a user sheet outranks every app's own: a desktop theme's
+ * generic rules for rows and buttons would otherwise win over these.
+ * Every rule applies only to a window with the `aurora-glass` class, which src/window.rs sets in every style.
+ *
+ * The window is one sheet of dark glass, as File Explorer's (components/file-explorer/src/style.h): KWin blurs
+ * behind it and src/glass.rs paints File Explorer's tint over the blur. A window that is not in front turns opaque,
+ * as macOS materials do when their window is not key, so nothing behind shows through it. */
+window.aurora-glass {
+    /* libadwaita's own surfaces inside the window, such as a dialog's sheet; the window itself is clear below. */
+    --window-bg-color: rgba(24, 24, 27, 0.63);
+    --view-bg-color: transparent;
+    --headerbar-bg-color: transparent;
+    --headerbar-backdrop-color: transparent;
+    --headerbar-shade-color: transparent;
+    --headerbar-darker-shade-color: transparent;
+    --sidebar-bg-color: transparent;
+    --sidebar-backdrop-color: transparent;
+    --sidebar-shade-color: transparent;
+    --card-bg-color: rgba(255, 255, 255, 0.055);
+    --card-shade-color: rgba(0, 0, 0, 0.25);
+    --popover-bg-color: rgba(36, 36, 40, 0.81);
+    --dialog-bg-color: rgb(30, 30, 32);
+    --accent-bg-color: #0a84ff;
+    --accent-color: #4aa3ff;
+    /* File Explorer's capsules (style.h): the glass fill and its rim, lighter along the top edge, and the fills a
+     * button lays over it under the pointer, pressed and checked (CAPSULE_FILL, GLASS_RIM_TOP, CAPSULE_HOVER,
+     * CAPSULE_PRESSED, SEGMENT_CHECKED). */
+    --aurora-fill: rgba(255, 255, 255, 0.086);
+    --aurora-rim-top: rgba(255, 255, 255, 0.2);
+    --aurora-rim: rgba(255, 255, 255, 0.07);
+    --aurora-fill-hover: rgba(255, 255, 255, 0.118);
+    --aurora-fill-active: rgba(255, 255, 255, 0.196);
+    --aurora-fill-checked: rgba(255, 255, 255, 0.18);
+    --aurora-sidebar: rgba(56, 56, 62, 0.46);
+    /* The glass is dark in every style, so its text is light in every style too. */
+    --window-fg-color: rgba(255, 255, 255, 0.92);
+    --view-fg-color: rgba(255, 255, 255, 0.92);
+    --headerbar-fg-color: rgba(255, 255, 255, 0.92);
+    --sidebar-fg-color: rgba(255, 255, 255, 0.92);
+    --card-fg-color: rgba(255, 255, 255, 0.92);
+    --popover-fg-color: rgba(255, 255, 255, 0.92);
+    --dialog-fg-color: rgba(255, 255, 255, 0.92);
+    /* Cards on the pages (the table, the reading tiles, the facts): a step lighter than the window's glass. */
+    --aurora-card: rgba(255, 255, 255, 0.045);
+    --aurora-tile: rgba(255, 255, 255, 0.06);
+}
+
+/* src/glass.rs (`paint_tint`) paints the window's tint and leaves the sidebar's card out of it, as File Explorer does,
+ * so GTK's own window background stays clear: the GTK theme fills it at 96 % (`.background`), which hid the blur.
+ * src/glass.rs also asks KWin for the blur (`request_blur`) while the window is in front. `backdrop-filter` here asked
+ * for the same blur, but made GTK walk everything the window draws on every frame. */
+window.aurora-glass {
+    background: none;
+}
+
+window.aurora-glass:backdrop {
+    --window-bg-color: rgb(30, 30, 33);
+    --aurora-sidebar: rgb(42, 42, 46);
+}
+
+/* The rim of the glass, lighter along the top edge. KWin draws the shadow outside the window (src/shadow.rs): a shadow
+ * here would make GTK's surface reach past the window and put KWin's blur off by as much. */
+window.aurora-glass {
+    border-radius: 14px;
+    box-shadow: inset 0 1px var(--aurora-rim-top), inset 0 0 0 1px var(--aurora-rim);
+}
+
+window.aurora-glass.maximized,
+window.aurora-glass.fullscreen,
+window.aurora-glass.tiled,
+window.aurora-glass.tiled-top,
+window.aurora-glass.tiled-bottom,
+window.aurora-glass.tiled-left,
+window.aurora-glass.tiled-right {
+    border-radius: 0;
+}
+
+/* The device sidebar floats as the clearer glass, inset 6 px from the window's edges as File Explorer's sidebar
+ * (SIDEBAR_INSET). The card's own margin does it; the GTK theme's margin around the whole pane would double it. */
+window.aurora-glass .sidebar-pane {
+    margin: 0;
+    background: none;
+    box-shadow: none;
+    border: none;
+}
+
+window.aurora-glass .sidebar-pane > toolbarview {
+    margin: 6px 0 6px 6px;
+    border-radius: 12px;
+    background-color: var(--aurora-sidebar);
+    box-shadow: inset 0 1px var(--aurora-rim-top), inset 0 0 0 1px rgba(255, 255, 255, 0.06);
+}
+
+/* Each device's pill keeps 8 px from the card's sides and its graph 10 px from the pill's edge, as File Explorer's
+ * selection keeps 8 px from its sidebar's sides and its icons sit 11 px in. The device row (summary_graph.blp) keeps
+ * 10 px at its other end and above and below. */
+window.aurora-glass list.navigation-sidebar {
+    background: none;
+    padding: 2px 6px 8px 6px;
+}
+
+window.aurora-glass list.navigation-sidebar > row {
+    border-radius: 11px;
+    margin: 3px 2px;
+    padding: 2px 0 2px 10px;
+    background-color: transparent;
+    box-shadow: none;
+    transition: background-color 150ms ease-out;
+}
+
+window.aurora-glass list.navigation-sidebar > row:hover {
+    background-color: rgba(255, 255, 255, 0.06);
+}
+
+window.aurora-glass list.navigation-sidebar > row:selected {
+    background-color: rgba(255, 255, 255, 0.13);
+    box-shadow: inset 0 1px rgba(255, 255, 255, 0.10);
+    color: inherit;
+}
+
+/* Buttons on the pages (Collapse All, Stop, Force Stop, Details, Start, Restart): one glass pill each, also while
+ * they wait for a selection, only dimmer. Linked groups come apart into separate pills. Under the pointer and pressed,
+ * a fill lies over the glass, as on the header bar's round buttons. */
+window.aurora-glass .view button:not(.flat):not(.circular),
+window.aurora-glass stack button:not(.flat):not(.circular):not(.toggle-pane-button) {
+    min-height: 30px;
+    padding: 0 14px;
+    border: none;
+    border-radius: 9999px;
+    background-image: none;
+    background-color: var(--aurora-fill);
+    box-shadow: inset 0 1px var(--aurora-rim-top), inset 0 0 0 1px var(--aurora-rim);
+    color: inherit;
+}
+
+/* The page switcher's segments sit in a stack too; :not(.toggle) keeps these fills off them. */
+window.aurora-glass .view button:not(.flat):not(.circular):not(.toggle):hover,
+window.aurora-glass stack button:not(.flat):not(.circular):not(.toggle):hover {
+    background-image: image(var(--aurora-fill-hover));
+}
+
+window.aurora-glass .view button:not(.flat):not(.circular):not(.toggle):active,
+window.aurora-glass stack button:not(.flat):not(.circular):not(.toggle):active {
+    background-image: image(var(--aurora-fill-active));
+}
+
+window.aurora-glass stack button:disabled {
+    opacity: 0.55;
+}
+
+window.aurora-glass stack .linked > button:not(:first-child) {
+    margin-left: 6px;
+}
diff --git a/src/edges.rs b/src/edges.rs
new file mode 100644
index 0000000..b29a2ac
--- /dev/null
+++ b/src/edges.rs
@@ -0,0 +1,146 @@
+/* edges.rs
+ *
+ * Copyright 2026 xt0n1-t3ch
+ *
+ * This program is free software: you can redistribute it and/or modify
+ * it under the terms of the GNU General Public License as published by
+ * the Free Software Foundation, either version 3 of the License, or
+ * (at your option) any later version.
+ *
+ * SPDX-License-Identifier: GPL-3.0-or-later
+ */
+
+//! Aurora: resizing from the window's edges. window.blp turns GTK's decorations off, because GTK's client-side
+//! shadow makes the surface reach past the window, and KWin 6.8 places the blur region GTK asks for
+//! (ext-background-effect-v1, in surface coordinates) from the window's edge instead, so the blur sat as far off as
+//! the shadow reached, 68 by 50 pixels. GTK resized the window from that shadow; as File Explorer's window does
+//! (components/file-explorer/src/glasswindow.cpp), it now resizes from a band inside its edges, and KWin draws the
+//! shadow (src/shadow.rs).
+
+use gtk::{gdk, prelude::*};
+
+use crate::glass::is_square;
+
+/// The band inside the window's edges that resizes it, in logical pixels (File Explorer's style.h, RESIZE_BORDER).
+const RESIZE_BORDER: f64 = 6.0;
+
+/// The edge or corner of a `width` by `height` window that a press at `x`, `y` resizes: within RESIZE_BORDER of one
+/// edge, or of two at a corner. `None` farther in, and outside the window.
+pub fn resize_edge(x: f64, y: f64, width: f64, height: f64) -> Option<gdk::SurfaceEdge> {
+    if x < 0.0 || y < 0.0 || x >= width || y >= height {
+        return None;
+    }
+    let left = x < RESIZE_BORDER;
+    let right = !left && x >= width - RESIZE_BORDER;
+    let top = y < RESIZE_BORDER;
+    let bottom = !top && y >= height - RESIZE_BORDER;
+    match (left, right, top, bottom) {
+        (true, _, true, _) => Some(gdk::SurfaceEdge::NorthWest),
+        (_, true, true, _) => Some(gdk::SurfaceEdge::NorthEast),
+        (true, _, _, true) => Some(gdk::SurfaceEdge::SouthWest),
+        (_, true, _, true) => Some(gdk::SurfaceEdge::SouthEast),
+        (true, _, _, _) => Some(gdk::SurfaceEdge::West),
+        (_, true, _, _) => Some(gdk::SurfaceEdge::East),
+        (_, _, true, _) => Some(gdk::SurfaceEdge::North),
+        (_, _, _, true) => Some(gdk::SurfaceEdge::South),
+        _ => None,
+    }
+}
+
+/// The pointer's shape over an edge or corner, by its CSS name.
+fn cursor_name(edge: gdk::SurfaceEdge) -> &'static str {
+    match edge {
+        gdk::SurfaceEdge::NorthWest | gdk::SurfaceEdge::SouthEast => "nwse-resize",
+        gdk::SurfaceEdge::NorthEast | gdk::SurfaceEdge::SouthWest => "nesw-resize",
+        gdk::SurfaceEdge::West | gdk::SurfaceEdge::East => "ew-resize",
+        _ => "ns-resize",
+    }
+}
+
+/// The edge a pointer at `x`, `y` in `window` would resize, unless the window is maximized, tiled, full screen or
+/// fixed in size.
+fn edge_under(window: &gtk::Window, x: f64, y: f64) -> Option<gdk::SurfaceEdge> {
+    if is_square(window) || !window.is_resizable() {
+        return None;
+    }
+    resize_edge(x, y, f64::from(window.width()), f64::from(window.height()))
+}
+
+/// Lets `window` be resized from the band inside its edges, as GTK's decorations let it from the band outside them:
+/// the pointer takes the resize shape there, and a press there starts the compositor's resize.
+pub fn resize_from_edges(window: &gtk::Window) {
+    let motion = gtk::EventControllerMotion::new();
+    motion.set_propagation_phase(gtk::PropagationPhase::Capture);
+    motion.connect_motion(|controller, x, y| {
+        if let Some(window) = controller.widget().and_downcast::<gtk::Window>() {
+            window.set_cursor_from_name(edge_under(&window, x, y).map(cursor_name));
+        }
+    });
+    motion.connect_leave(|controller| {
+        if let Some(window) = controller.widget() {
+            window.set_cursor(None);
+        }
+    });
+    window.add_controller(motion);
+
+    let press = gtk::GestureClick::new();
+    press.set_button(gdk::BUTTON_PRIMARY);
+    press.set_propagation_phase(gtk::PropagationPhase::Capture);
+    press.connect_pressed(|gesture, _, x, y| {
+        let Some(window) = gesture.widget().and_downcast::<gtk::Window>() else {
+            return;
+        };
+        let (Some(edge), Some(toplevel), Some(device)) = (
+            edge_under(&window, x, y),
+            window.surface().and_downcast::<gdk::Toplevel>(),
+            gesture.device(),
+        ) else {
+            gesture.set_state(gtk::EventSequenceState::Denied);
+            return;
+        };
+        gesture.set_state(gtk::EventSequenceState::Claimed);
+        let (dx, dy) = window.surface_transform();
+        toplevel.begin_resize(
+            edge,
+            Some(&device),
+            gesture.current_button() as i32,
+            x + dx,
+            y + dy,
+            gesture.current_event_time(),
+        );
+    });
+    window.add_controller(press);
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+    use gdk::SurfaceEdge;
+
+    #[test]
+    fn the_band_inside_each_edge_resizes_and_the_inside_does_not() {
+        let (w, h) = (800.0, 600.0);
+        assert_eq!(resize_edge(2.0, 300.0, w, h), Some(SurfaceEdge::West));
+        assert_eq!(resize_edge(797.0, 300.0, w, h), Some(SurfaceEdge::East));
+        assert_eq!(resize_edge(400.0, 0.0, w, h), Some(SurfaceEdge::North));
+        assert_eq!(resize_edge(400.0, 599.0, w, h), Some(SurfaceEdge::South));
+        assert_eq!(resize_edge(6.0, 300.0, w, h), None, "the band is 6 px wide");
+        assert_eq!(resize_edge(400.0, 300.0, w, h), None);
+    }
+
+    #[test]
+    fn corners_resize_both_ways_and_outside_resizes_nothing() {
+        let (w, h) = (800.0, 600.0);
+        assert_eq!(resize_edge(1.0, 1.0, w, h), Some(SurfaceEdge::NorthWest));
+        assert_eq!(resize_edge(799.0, 1.0, w, h), Some(SurfaceEdge::NorthEast));
+        assert_eq!(resize_edge(1.0, 599.0, w, h), Some(SurfaceEdge::SouthWest));
+        assert_eq!(resize_edge(799.0, 599.0, w, h), Some(SurfaceEdge::SouthEast));
+        assert_eq!(resize_edge(-1.0, 300.0, w, h), None);
+        assert_eq!(resize_edge(800.0, 300.0, w, h), None);
+    }
+
+    #[test]
+    fn a_window_narrower_than_two_bands_resizes_from_its_left_and_top() {
+        assert_eq!(resize_edge(5.0, 5.0, 8.0, 8.0), Some(SurfaceEdge::NorthWest));
+    }
+}
diff --git a/src/glass.rs b/src/glass.rs
new file mode 100644
index 0000000..a87801a
--- /dev/null
+++ b/src/glass.rs
@@ -0,0 +1,348 @@
+/* glass.rs
+ *
+ * Copyright 2026 xt0n1-t3ch
+ *
+ * This program is free software: you can redistribute it and/or modify
+ * it under the terms of the GNU General Public License as published by
+ * the Free Software Foundation, either version 3 of the License, or
+ * (at your option) any later version.
+ *
+ * SPDX-License-Identifier: GPL-3.0-or-later
+ */
+
+//! Aurora: KWin's blur behind the window and its popups, so their translucent tint reads as glass, as File Explorer's
+//! does. Mission Center asks for it itself, on GTK's own Wayland connection: through ext-background-effect-v1, the
+//! only blur protocol KWin 6.8 offers apps, or Plasma's `org_kde_kwin_blur` on compositors from before it. It also
+//! paints the window's tint and loads the glass stylesheets.
+
+use gdk_wayland::prelude::*;
+use gtk::{gdk, glib, graphene, gsk, prelude::*};
+use wayland_client::{
+    delegate_noop,
+    globals::{registry_queue_init, GlobalListContents},
+    protocol::{wl_compositor::WlCompositor, wl_region::WlRegion, wl_registry::WlRegistry},
+    Connection, Dispatch, EventQueue, Proxy, QueueHandle,
+};
+use wayland_protocols::ext::background_effect::v1::client::{
+    ext_background_effect_manager_v1::ExtBackgroundEffectManagerV1,
+    ext_background_effect_surface_v1::ExtBackgroundEffectSurfaceV1,
+};
+use wayland_protocols_plasma::blur::client::{
+    org_kde_kwin_blur::OrgKdeKwinBlur, org_kde_kwin_blur_manager::OrgKdeKwinBlurManager,
+};
+
+/// The corner radius of the window body in logical pixels; aurora.css rounds `window.aurora-glass` the same.
+pub const WINDOW_RADIUS: i32 = 14;
+
+/// The corner radius of the sidebar's card in logical pixels; aurora.css rounds `.sidebar-pane > toolbarview` the same.
+pub const SIDEBAR_RADIUS: f32 = 12.0;
+
+/// File Explorer's window tint (components/file-explorer/src/style.h, WINDOW_TINT and WINDOW_TINT_INACTIVE): the
+/// denser glass over KWin's blur while the window is in front, and opaque while it is not, as macOS materials are
+/// while their window is not key.
+const TINT: gdk::RGBA = gdk::RGBA::new(24.0 / 255.0, 24.0 / 255.0, 27.0 / 255.0, 160.0 / 255.0);
+const TINT_INACTIVE: gdk::RGBA = gdk::RGBA::new(30.0 / 255.0, 30.0 / 255.0, 33.0 / 255.0, 1.0);
+
+/// The variable GDK reads, as it opens the display, for the Wayland globals it must not use (GTK's documented
+/// `GDK_WAYLAND_DISABLE`), and the blur protocol's global.
+const GDK_SKIPPED_GLOBALS: &str = "GDK_WAYLAND_DISABLE";
+const STANDARD_BLUR: &str = "ext_background_effect_manager_v1";
+
+/// Keeps GDK off ext-background-effect-v1, so the window and its popups can ask KWin for their blur themselves
+/// (`Glass`): a surface may hold only one effect object, and GTK 4.24 makes one for every surface. GTK asks for the
+/// blur from what each frame draws (CSS `backdrop-filter`), which costs every frame: with animated graphs the window
+/// used three times the CPU (docs/performance.md). Call it first thing in `main`, before any thread starts.
+pub fn claim_blur_protocol() {
+    let skipped = std::env::var(GDK_SKIPPED_GLOBALS).unwrap_or_default();
+    if let Some(skipped) = with_global(&skipped, STANDARD_BLUR) {
+        std::env::set_var(GDK_SKIPPED_GLOBALS, skipped);
+    }
+}
+
+/// `skipped`, a list in GDK_WAYLAND_DISABLE's form (names parted by `:`, `;`, `,`, spaces or tabs), with `global`
+/// added, or `None` when it is there already.
+fn with_global(skipped: &str, global: &str) -> Option<String> {
+    let mut names = skipped.split([':', ';', ',', ' ', '\t']).filter(|name| !name.is_empty());
+    if names.any(|name| name == global) {
+        return None;
+    }
+    Some(if skipped.is_empty() { global.to_owned() } else { format!("{skipped},{global}") })
+}
+
+/// Whether `window` shows square corners: maximized, tiled or full screen.
+pub fn is_square(window: &gtk::Window) -> bool {
+    window
+        .surface()
+        .and_then(|surface| surface.downcast::<gdk::Toplevel>().ok())
+        .is_some_and(|toplevel| {
+            toplevel.state().intersects(
+                gdk::ToplevelState::MAXIMIZED | gdk::ToplevelState::FULLSCREEN | gdk::ToplevelState::TILED,
+            )
+        })
+}
+
+/// Paints the window's tint as File Explorer's window does (components/file-explorer/src/glasswindow.cpp,
+/// `paintEvent`, and mainwindow.cpp, `glassCutout`): over the rounded body but for `card`, the sidebar's own clearer
+/// sheet of glass, which the tint must not darken twice. The window's CSS background stays clear for it (aurora.css).
+/// Around the card, the tint is the card's shadow with no blur and a spread past the window's far corner, which GTK
+/// draws on the GPU, where a path around the card had to be rasterized.
+pub fn paint_tint(snapshot: &gtk::Snapshot, window: &gtk::Window, card: Option<graphene::Rect>) {
+    let (width, height) = (window.width() as f32, window.height() as f32);
+    let bounds = graphene::Rect::new(0.0, 0.0, width, height);
+    let radius = if is_square(window) { 0.0 } else { WINDOW_RADIUS as f32 };
+    let tint = if window.is_active() { &TINT } else { &TINT_INACTIVE };
+    snapshot.push_rounded_clip(&gsk::RoundedRect::from_rect(bounds, radius));
+    match card {
+        Some(card) => {
+            let outline = gsk::RoundedRect::from_rect(card, SIDEBAR_RADIUS);
+            snapshot.append_outset_shadow(&outline, tint, 0.0, 0.0, width.max(height), 0.0);
+        }
+        None => snapshot.append_color(tint, &bounds),
+    }
+    snapshot.pop();
+}
+
+/// The glass stylesheets: the window's shell, its header bars, what the pages hold, then what opens over them. Of
+/// providers at the same priority, GTK lets the one added last win, so each sheet overrides the ones before it where
+/// their rules meet.
+const SHEETS: [&[u8]; 4] = [
+    include_bytes!("../resources/ui/aurora.css"),
+    include_bytes!("../resources/ui/aurora-header.css"),
+    include_bytes!("../resources/ui/aurora-pages.css"),
+    include_bytes!("../resources/ui/aurora-popups.css"),
+];
+
+/// Loads the glass stylesheets for every window on `display`, one step above the user's sheet
+/// (`~/.config/gtk-4.0/gtk.css`). A desktop theme loaded there outranks every app's own sheet, so its generic row and
+/// button rules would otherwise override the glass. The sheets style only windows with the `aurora-glass` class.
+pub fn load_style(display: &gdk::Display) {
+    for sheet in SHEETS {
+        let provider = gtk::CssProvider::new();
+        provider.load_from_bytes(&glib::Bytes::from_static(sheet));
+        gtk::style_context_add_provider_for_display(display, &provider, gtk::STYLE_PROVIDER_PRIORITY_USER + 1);
+    }
+}
+
+/// Holds no state: none of the objects used here sends events the code reads.
+pub struct Events;
+
+impl Dispatch<WlRegistry, GlobalListContents> for Events {
+    fn event(
+        _: &mut Self,
+        _: &WlRegistry,
+        _: <WlRegistry as Proxy>::Event,
+        _: &GlobalListContents,
+        _: &Connection,
+        _: &QueueHandle<Self>,
+    ) {
+    }
+}
+
+delegate_noop!(Events: ignore WlCompositor);
+delegate_noop!(Events: ignore WlRegion);
+delegate_noop!(Events: ignore ExtBackgroundEffectManagerV1);
+delegate_noop!(Events: ignore ExtBackgroundEffectSurfaceV1);
+delegate_noop!(Events: ignore OrgKdeKwinBlurManager);
+delegate_noop!(Events: ignore OrgKdeKwinBlur);
+
+/// The blur behind one surface, through the protocol the compositor offers.
+enum Blur {
+    /// ext-background-effect-v1: one effect object per surface, its region applied with the surface's next commit.
+    Standard(ExtBackgroundEffectSurfaceV1),
+    /// Plasma's own protocol, which KWin offered apps before 6.8.
+    Plasma(OrgKdeKwinBlurManager, OrgKdeKwinBlur),
+}
+
+/// Where KWin blurs behind a surface: a rounded rectangle in the surface's coordinates, in logical pixels.
+#[derive(Clone, Copy, Debug, PartialEq, Eq)]
+pub struct Body {
+    pub left: i32,
+    pub top: i32,
+    pub width: i32,
+    pub height: i32,
+    pub radius: i32,
+}
+
+impl Body {
+    /// The body of `native`: all of it, its corners rounded by `radius`, past the margins GTK keeps around it.
+    pub fn of(native: &impl IsA<gtk::Native>, radius: i32) -> Self {
+        let (x, y) = native.surface_transform();
+        let widget = native.as_ref().upcast_ref::<gtk::Widget>();
+        Self {
+            left: x as i32,
+            top: y as i32,
+            width: widget.width(),
+            height: widget.height(),
+            radius,
+        }
+    }
+}
+
+/// The blur behind one window's or popup's surface.
+pub struct Glass {
+    connection: Connection,
+    queue: EventQueue<Events>,
+    compositor: WlCompositor,
+    surface: gdk::Surface,
+    blur: Blur,
+}
+
+impl Glass {
+    /// Gets KWin's blur ready for `native`'s surface; [`Glass::fit`] says where. Returns `None` outside Wayland,
+    /// before `native` is realized, or where the compositor offers no blur protocol (another desktop, KWin's blur
+    /// effect off). GDK must leave the standard protocol to it ([`claim_blur_protocol`]): a second effect object for a
+    /// surface is a protocol error that closes the app.
+    pub fn attach(native: &impl IsA<gtk::Native>) -> Option<Self> {
+        let surface = native.surface()?;
+        let wayland = surface.downcast_ref::<gdk_wayland::WaylandSurface>()?;
+        let display = wayland.display().downcast::<gdk_wayland::WaylandDisplay>().ok()?;
+        let backend = display.wl_display()?.backend().upgrade()?;
+        let connection = Connection::from_backend(backend);
+        let (globals, queue) = registry_queue_init::<Events>(&connection).ok()?;
+        let handle = queue.handle();
+        let compositor: WlCompositor = globals.bind(&handle, 1..=4, ()).ok()?;
+        let wl_surface = wayland.wl_surface()?;
+        let blur = match globals.bind::<ExtBackgroundEffectManagerV1, _, _>(&handle, 1..=1, ()) {
+            Ok(manager) => Blur::Standard(manager.get_background_effect(&wl_surface, &handle, ())),
+            Err(_) => {
+                let manager: OrgKdeKwinBlurManager = globals.bind(&handle, 1..=1, ()).ok()?;
+                let blur = manager.create(&wl_surface, &handle, ());
+                Blur::Plasma(manager, blur)
+            }
+        };
+        Some(Self {
+            connection,
+            queue,
+            compositor,
+            surface,
+            blur,
+        })
+    }
+
+    /// Blurs behind `body`, or nowhere, as File Explorer turns its window's blur off while the window is not in front
+    /// (glasswindow.cpp, `updateBlurRegion`). KWin takes it with the surface's next commit, which this asks for.
+    pub fn fit(&self, body: Option<Body>) {
+        let region = body.map(|body| {
+            let region = self.compositor.create_region(&self.queue.handle(), ());
+            for (left, top, width, height) in rounded_rect(body.width, body.height, body.radius) {
+                region.add(body.left + left, body.top + top, width, height);
+            }
+            region
+        });
+        match &self.blur {
+            Blur::Standard(effect) => effect.set_blur_region(region.as_ref()),
+            Blur::Plasma(manager, blur) => match &region {
+                Some(region) => {
+                    blur.set_region(Some(region));
+                    blur.commit();
+                }
+                None => {
+                    if let Some(wl_surface) = self
+                        .surface
+                        .downcast_ref::<gdk_wayland::WaylandSurface>()
+                        .and_then(|surface| surface.wl_surface())
+                    {
+                        manager.unset(&wl_surface);
+                    }
+                }
+            },
+        }
+        if let Some(region) = region {
+            region.destroy();
+        }
+        let _ = self.connection.flush();
+        self.surface.queue_render();
+    }
+}
+
+impl Drop for Glass {
+    fn drop(&mut self) {
+        match &self.blur {
+            Blur::Standard(effect) => effect.destroy(),
+            Blur::Plasma(_, blur) => blur.release(),
+        }
+        let _ = self.connection.flush();
+    }
+}
+
+/// A rounded rectangle of `width` by `height` with corners of `radius`, as rectangles: one row per pixel in each
+/// corner band, inset to the arc, and one block between the bands.
+pub fn rounded_rect(width: i32, height: i32, radius: i32) -> Vec<(i32, i32, i32, i32)> {
+    let radius = radius.clamp(0, width.min(height) / 2);
+    let mut rects = Vec::with_capacity(radius as usize * 2 + 1);
+    for row in 0..radius {
+        // The arc's inset at the middle of this pixel row, measured from the corner's centre.
+        let dy = f64::from(radius - row) - 0.5;
+        let inset = radius - (f64::from(radius * radius) - dy * dy).max(0.0).sqrt().round() as i32;
+        rects.push((inset, row, width - 2 * inset, 1));
+        rects.push((inset, height - 1 - row, width - 2 * inset, 1));
+    }
+    rects.push((0, radius, width, height - 2 * radius));
+    rects
+}
+
+#[cfg(test)]
+mod tests {
+    use super::{rounded_rect, with_global};
+
+    /// The area the rectangles cover, counting a pixel covered twice twice.
+    fn area(rects: &[(i32, i32, i32, i32)]) -> i64 {
+        rects.iter().map(|&(_, _, w, h)| i64::from(w) * i64::from(h)).sum()
+    }
+
+    #[test]
+    fn square_corners_are_one_rectangle() {
+        assert_eq!(rounded_rect(800, 600, 0), vec![(0, 0, 800, 600)]);
+    }
+
+    #[test]
+    fn rounded_corners_cut_about_what_a_circle_leaves_out() {
+        let (w, h, r) = (800, 600, 14);
+        let rects = rounded_rect(w, h, r);
+        // Four corners together leave out r^2 * (4 - pi) of the full rectangle.
+        let missing = i64::from(w * h) - area(&rects);
+        let expected = f64::from(r * r) * (4.0 - std::f64::consts::PI);
+        assert!((missing as f64 - expected).abs() < expected * 0.15, "missing {missing}, expected about {expected}");
+    }
+
+    #[test]
+    fn rows_never_overlap_and_stay_inside() {
+        let (w, h) = (400, 300);
+        let rects = rounded_rect(w, h, 14);
+        let mut covered = vec![0u8; (w * h) as usize];
+        for (x, y, rw, rh) in rects {
+            assert!(x >= 0 && y >= 0 && x + rw <= w && y + rh <= h, "({x}, {y}, {rw}, {rh}) leaves the window");
+            for py in y..y + rh {
+                for px in x..x + rw {
+                    covered[(py * w + px) as usize] += 1;
+                }
+            }
+        }
+        assert!(covered.iter().all(|&c| c <= 1), "a pixel is covered twice");
+        assert_eq!(covered[(150 * w + 0) as usize], 1, "the middle of the left edge is covered");
+        assert_eq!(covered[0], 0, "the very corner is left out");
+    }
+
+    #[test]
+    fn a_radius_larger_than_the_window_is_clamped() {
+        let rects = rounded_rect(20, 10, 40);
+        assert!(rects.iter().all(|&(_, _, w, h)| w >= 0 && h >= 0));
+    }
+
+    #[test]
+    fn gdk_is_told_to_leave_the_blur_protocol_once() {
+        let global = "ext_background_effect_manager_v1";
+        assert_eq!(with_global("", global).as_deref(), Some(global));
+        assert_eq!(
+            with_global("wp_fractional_scale_manager_v1", global).as_deref(),
+            Some("wp_fractional_scale_manager_v1,ext_background_effect_manager_v1")
+        );
+        assert_eq!(with_global("xdg_activation_v1 ext_background_effect_manager_v1", global), None);
+        assert_eq!(with_global("ext_background_effect_manager_v1;", global), None);
+        assert_eq!(
+            with_global("ext_background_effect_manager_v1_x", global).as_deref(),
+            Some("ext_background_effect_manager_v1_x,ext_background_effect_manager_v1"),
+            "only the whole name counts"
+        );
+    }
+}
