+++ b/src/performance_page/device_colors.rs
@@ -0,0 +1,154 @@
+/* performance_page/device_colors.rs
+ *
+ * Copyright 2026 Mission Center Developers
+ *
+ * This program is free software: you can redistribute it and/or modify
+ * it under the terms of the GNU General Public License as published by
+ * the Free Software Foundation, either version 3 of the License, or
+ * (at your option) any later version.
+ *
+ * This program is distributed in the hope that it will be useful,
+ * but WITHOUT ANY WARRANTY; without even the implied warranty of
+ * MERCHANTABILITY or FITNESS FOR A PARTICULAR PURPOSE.  See the
+ * GNU General Public License for more details.
+ *
+ * You should have received a copy of the GNU General Public License
+ * along with this program.  If not, see <http://www.gnu.org/licenses/>.
+ *
+ * SPDX-License-Identifier: GPL-3.0-or-later
+ */
+
+//! Colors the user picked for single devices, stored in the `performance-sidebar-device-colors`
+//! setting as `<device>:#rrggbb` entries joined by `;`. Device names are encoded as in the
+//! visibility overrides, so a name holding `;` or `:` survives the round trip.
+
+use std::collections::HashMap;
+
+use gtk::{gdk, gio, glib, prelude::*};
+
+use super::summary_graph::{decode_device_name, encode_device_name};
+
+pub const SETTINGS_KEY: &str = "performance-sidebar-device-colors";
+
+/// A color without transparency; graphs derive their fill and grid from it.
+#[derive(Debug, Clone, Copy, PartialEq, Eq)]
+pub struct Rgb(pub [u8; 3]);
+
+impl Rgb {
+    pub fn from_hex(hex: &str) -> Option<Self> {
+        let digits = hex.strip_prefix('#')?;
+        if digits.len() != 6 || !digits.is_ascii() {
+            return None;
+        }
+        let channel = |at: usize| u8::from_str_radix(&digits[at..at + 2], 16).ok();
+        Some(Self([channel(0)?, channel(2)?, channel(4)?]))
+    }
+
+    pub fn to_hex(self) -> String {
+        let [r, g, b] = self.0;
+        format!("#{r:02x}{g:02x}{b:02x}")
+    }
+
+    pub fn from_rgba(rgba: &gdk::RGBA) -> Self {
+        let channel = |value: f32| (value.clamp(0., 1.) * 255.).round() as u8;
+        Self([
+            channel(rgba.red()),
+            channel(rgba.green()),
+            channel(rgba.blue()),
+        ])
+    }
+
+    pub fn to_rgba(self) -> gdk::RGBA {
+        let [r, g, b] = self.0;
+        gdk::RGBA::new(r as f32 / 255., g as f32 / 255., b as f32 / 255., 1.)
+    }
+}
+
+/// Reads the stored colors. Entries that do not parse are skipped.
+pub fn parse(raw: &str) -> HashMap<String, Rgb> {
+    raw.split(';')
+        .filter(|entry| !entry.is_empty())
+        .filter_map(|entry| {
+            let (name, hex) = entry.rsplit_once(':')?;
+            Some((decode_device_name(name), Rgb::from_hex(hex)?))
+        })
+        .collect()
+}
+
+/// Writes the colors in name order, so equal maps give equal settings.
+pub fn serialize(colors: &HashMap<String, Rgb>) -> String {
+    let mut entries: Vec<String> = colors
+        .iter()
+        .map(|(name, color)| format!("{}:{}", encode_device_name(name), color.to_hex()))
+        .collect();
+    entries.sort_unstable();
+    entries.join(";")
+}
+
+/// The color the user picked for `device`, if any.
+pub fn custom_color(settings: &gio::Settings, device: &str) -> Option<Rgb> {
+    parse(&settings.string(SETTINGS_KEY)).get(device).copied()
+}
+
+/// Stores the color of `device`; `None` goes back to the default color.
+pub fn set_custom_color(settings: &gio::Settings, device: &str, color: Option<Rgb>) {
+    let mut colors = parse(&settings.string(SETTINGS_KEY));
+    let changed = match color {
+        Some(color) => colors.insert(device.to_owned(), color) != Some(color),
+        None => colors.remove(device).is_some(),
+    };
+    if !changed {
+        return;
+    }
+    if settings.set_string(SETTINGS_KEY, &serialize(&colors)).is_err() {
+        glib::g_warning!(
+            "MissionCenter::PerformancePage",
+            "Failed to set {} setting",
+            SETTINGS_KEY
+        );
+    }
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+
+    #[test]
+    fn colors_round_trip_through_the_settings_string() {
+        let mut colors = HashMap::new();
+        colors.insert("cpu".to_owned(), Rgb([0x1c, 0x71, 0xd8]));
+        colors.insert("gpu-0000:2B:00.0".to_owned(), Rgb([0xff, 0x00, 0x7f]));
+        colors.insert("net-a;b".to_owned(), Rgb([0, 0, 0]));
+
+        let raw = serialize(&colors);
+        assert_eq!(parse(&raw), colors);
+    }
+
+    #[test]
+    fn the_settings_string_is_sorted_and_lowercase() {
+        let mut colors = HashMap::new();
+        colors.insert("memory".to_owned(), Rgb([0xAB, 0xCD, 0xEF]));
+        colors.insert("cpu".to_owned(), Rgb([1, 2, 3]));
+        assert_eq!(serialize(&colors), "cpu:#010203;memory:#abcdef");
+    }
+
+    #[test]
+    fn a_pci_address_in_a_device_name_keeps_its_colons() {
+        let parsed = parse("gpu-0000%3A2B%3A00.0:#f66151");
+        assert_eq!(parsed.get("gpu-0000:2B:00.0"), Some(&Rgb([0xf6, 0x61, 0x51])));
+    }
+
+    #[test]
+    fn broken_entries_are_skipped() {
+        let parsed = parse("cpu:#12345;memory:blue;disk-sda:#00ff00;:#zzzzzz;fan-4-1");
+        assert_eq!(parsed.len(), 1);
+        assert_eq!(parsed.get("disk-sda"), Some(&Rgb([0, 0xff, 0])));
+    }
+
+    #[test]
+    fn a_color_survives_the_trip_through_gdk() {
+        for color in [Rgb([0, 0, 0]), Rgb([0x81, 0x3d, 0x9c]), Rgb([255, 255, 255])] {
+            assert_eq!(Rgb::from_rgba(&color.to_rgba()), color);
+        }
+    }
+}
diff --git a/src/performance_page/tiles.rs b/src/performance_page/tiles.rs
new file mode 100644
index 0000000..e246283
--- /dev/null
+++ b/src/performance_page/tiles.rs
@@ -0,0 +1,335 @@
+/* performance_page/tiles.rs
+ *
+ * Copyright 2026 xt0n1-t3ch
+ *
+ * This program is free software: you can redistribute it and/or modify
+ * it under the terms of the GNU General Public License as published by
+ * the Free Software Foundation, either version 3 of the License, or
+ * (at your option) any later version.
+ *
+ * SPDX-License-Identifier: GPL-3.0-or-later
+ */
+
+//! Aurora: the Performance page's details column as glass tiles, as in Windows 11's Task Manager. Each reading (a
+//! caption over a value) becomes a tile, readings side by side share their row equally, and the facts below them
+//! (name and value labels laid out in a grid) sit together on one card. Every device's pane keeps its own layout
+//! file; this reads the panes' shape, so they all get the same look. aurora-pages.css draws the tiles and the card
+//! while the glass is on; without it the classes do nothing.
+
+use adw::prelude::*;
+
+/// Marks a pane already arranged: the page shows the same pane again each time its device is picked.
+const ARRANGED: &str = "aurora-arranged";
+/// The space between tiles, in logical pixels.
+const TILE_GAP: i32 = 8;
+
+/// One child of a box in a details pane, as far as its shape matters.
+#[derive(Clone, Debug, PartialEq)]
+pub enum Part {
+    /// A label in the `caption` style: a reading's name.
+    Caption,
+    /// A label in the `title-4` style: a reading's value.
+    Value,
+    /// Any other label, or an image.
+    Text,
+    /// A box that holds only labels and images, such as a caption beside a hint.
+    Group(Vec<Part>),
+    /// Anything else, such as a box of boxes.
+    Other,
+}
+
+/// Whether a vertical box made of `parts` is one reading: a caption and a value, either of them possibly inside a
+/// row of labels, and nothing else.
+pub fn is_reading(parts: &[Part]) -> bool {
+    let has = |wanted: &Part| {
+        parts
+            .iter()
+            .any(|part| part == wanted || matches!(part, Part::Group(inner) if inner.contains(wanted)))
+    };
+    !parts.contains(&Part::Other) && has(&Part::Caption) && has(&Part::Value)
+}
+
+/// Where a child sits in a grid, in grid lines.
+#[derive(Clone, Copy, Debug, PartialEq, Eq)]
+pub struct Place {
+    pub column: i32,
+    pub row: i32,
+    pub width: i32,
+    pub height: i32,
+}
+
+/// The block of grid cells that `places` cover together, or `None` when there are none.
+pub fn span(places: &[Place]) -> Option<Place> {
+    let first = places.first()?;
+    let (mut left, mut top) = (first.column, first.row);
+    let (mut right, mut bottom) = (first.column + first.width, first.row + first.height);
+    for place in places {
+        left = left.min(place.column);
+        top = top.min(place.row);
+        right = right.max(place.column + place.width);
+        bottom = bottom.max(place.row + place.height);
+    }
+    Some(Place {
+        column: left,
+        row: top,
+        width: right - left,
+        height: bottom - top,
+    })
+}
+
+/// Shows the details pane `content` in the details column `column`, arranged into tiles.
+pub fn show(column: &adw::Bin, content: Option<&gtk::Widget>) {
+    if let Some(content) = content {
+        arrange(content);
+    }
+    column.set_child(content);
+}
+
+/// The first index of each pair of tiles to set side by side, given which children of a column are lone tiles: two
+/// lone tiles one after the other share a row, and a tile already paired is not paired again.
+pub fn pairs(lone_tiles: &[bool]) -> Vec<usize> {
+    let mut starts = Vec::new();
+    let mut index = 0;
+    while index + 1 < lone_tiles.len() {
+        if lone_tiles[index] && lone_tiles[index + 1] {
+            starts.push(index);
+            index += 2;
+        } else {
+            index += 1;
+        }
+    }
+    starts
+}
+
+/// Turns the readings of the details pane `root` into tiles and puts its facts on a card. Arranging a pane twice
+/// changes nothing.
+pub fn arrange(root: &gtk::Widget) {
+    if root.has_css_class(ARRANGED) {
+        return;
+    }
+    root.add_css_class(ARRANGED);
+    visit(root);
+}
+
+fn children(widget: &gtk::Widget) -> impl Iterator<Item = gtk::Widget> {
+    std::iter::successors(widget.first_child(), |child| child.next_sibling())
+}
+
+fn part_of(widget: &gtk::Widget) -> Part {
+    if widget.is::<gtk::Label>() {
+        return label_part(widget);
+    }
+    if widget.is::<gtk::Image>() || widget.is::<gtk::Picture>() {
+        return Part::Text;
+    }
+    if !widget.is::<gtk::Box>() {
+        return Part::Other;
+    }
+    let inner: Vec<Part> = children(widget).map(|child| part_of(&child)).collect();
+    if inner.iter().any(|part| matches!(part, Part::Group(_) | Part::Other)) {
+        Part::Other
+    } else {
+        Part::Group(inner)
+    }
+}
+
+fn label_part(label: &gtk::Widget) -> Part {
+    if label.has_css_class("caption") {
+        Part::Caption
+    } else if label.has_css_class("title-4") {
+        Part::Value
+    } else {
+        Part::Text
+    }
+}
+
+fn visit(widget: &gtk::Widget) {
+    if let Some(reading) = widget.downcast_ref::<gtk::Box>() {
+        let parts: Vec<Part> = children(widget).map(|child| part_of(&child)).collect();
+        if reading.orientation() == gtk::Orientation::Vertical && is_reading(&parts) {
+            make_tile(reading);
+            return;
+        }
+    }
+    for child in children(widget).collect::<Vec<_>>() {
+        visit(&child);
+    }
+    if let Some(grid) = widget.downcast_ref::<gtk::Grid>() {
+        space_tile_columns(grid);
+        card_facts(grid);
+    } else if let Some(column) = widget.downcast_ref::<gtk::Box>() {
+        if column.orientation() == gtk::Orientation::Vertical {
+            arrange_column(column);
+        }
+    }
+}
+
+fn is_tile(widget: &gtk::Widget) -> bool {
+    widget.has_css_class("aurora-stat")
+}
+
+/// Whether `widget` is a row of tiles: a horizontal box holding at least one.
+fn is_tile_row(widget: &gtk::Widget) -> bool {
+    widget
+        .downcast_ref::<gtk::Box>()
+        .is_some_and(|row| row.orientation() == gtk::Orientation::Horizontal && children(widget).any(|c| is_tile(&c)))
+}
+
+/// Spaces a column of tiles and rows of tiles by the tile gap, and sets lone tiles side by side in pairs.
+fn arrange_column(column: &gtk::Box) {
+    let rows: Vec<gtk::Widget> = children(column.upcast_ref()).collect();
+    if !rows.iter().any(|row| is_tile(row) || is_tile_row(row)) {
+        return;
+    }
+    column.set_spacing(TILE_GAP);
+
+    let lone: Vec<bool> = rows.iter().map(is_tile).collect();
+    for start in pairs(&lone) {
+        let (first, second) = (&rows[start], &rows[start + 1]);
+        let pair = gtk::Box::new(gtk::Orientation::Horizontal, TILE_GAP);
+        pair.set_homogeneous(true);
+        column.insert_child_after(&pair, Some(first));
+        column.remove(first);
+        column.remove(second);
+        pair.append(first);
+        pair.append(second);
+    }
+}
+
+/// Makes `reading` a tile that fills its place; tiles side by side in a row share it equally, with the tile gap
+/// between them.
+fn make_tile(reading: &gtk::Box) {
+    reading.add_css_class("aurora-stat");
+    reading.set_hexpand(true);
+    reading.set_halign(gtk::Align::Fill);
+    let Some(row) = reading.parent().and_downcast::<gtk::Box>() else {
+        return;
+    };
+    if row.orientation() == gtk::Orientation::Horizontal {
+        row.set_homogeneous(true);
+        row.set_spacing(TILE_GAP);
+    }
+}
+
+/// Puts the tile gap between a grid's columns when its tiles stand in more than one of them. A grid with tiles in one
+/// column keeps its spacing, so a child spanning its empty columns stays as wide as the tiles.
+fn space_tile_columns(grid: &gtk::Grid) {
+    let mut columns: Vec<i32> = children(grid.upcast_ref())
+        .filter(is_tile)
+        .map(|tile| grid.query_child(&tile).0)
+        .collect();
+    columns.sort_unstable();
+    columns.dedup();
+    if columns.len() > 1 {
+        grid.set_column_spacing(grid.column_spacing().max(TILE_GAP.unsigned_abs()));
+    }
+}
+
+/// Lays one card behind the grid's facts: its labels that are not part of a reading. The card is the grid's first
+/// child, so it draws under them, and it starts where their first row's labels start.
+fn card_facts(grid: &gtk::Grid) {
+    let facts: Vec<(gtk::Label, Place)> = children(grid.upcast_ref())
+        .filter_map(|child| child.downcast::<gtk::Label>().ok())
+        .filter(|label| !label.has_css_class("title-4"))
+        .map(|label| {
+            let (column, row, width, height) = grid.query_child(&label);
+            (label, Place { column, row, width, height })
+        })
+        .collect();
+    if facts.len() < 2 {
+        return;
+    }
+    let places: Vec<Place> = facts.iter().map(|(_, place)| *place).collect();
+    let Some(block) = span(&places) else {
+        return;
+    };
+
+    let card = gtk::Box::new(gtk::Orientation::Vertical, 0);
+    card.add_css_class("aurora-facts");
+    card.set_can_target(false);
+    let first_row_margin = facts
+        .iter()
+        .filter(|(_, place)| place.row == block.row)
+        .map(|(label, _)| label.margin_top())
+        .max()
+        .unwrap_or(0);
+    card.set_margin_top(first_row_margin);
+    grid.attach(&card, block.column, block.row, block.width, block.height);
+    card.insert_after(grid, None::<&gtk::Widget>);
+
+    for (label, place) in &facts {
+        if place.column == block.column {
+            label.add_css_class("aurora-fact-start");
+        }
+        if place.column + place.width == block.column + block.width {
+            // The values take the column's spare width, so the card is as wide as the tiles above it.
+            label.add_css_class("aurora-fact-end");
+            label.set_hexpand(true);
+        }
+    }
+}
+
+#[cfg(test)]
+mod tests {
+    use super::{is_reading, pairs, span, Part, Place};
+
+    #[test]
+    fn a_caption_over_a_value_is_a_reading() {
+        assert!(is_reading(&[Part::Caption, Part::Value]));
+    }
+
+    #[test]
+    fn a_reading_may_hold_its_caption_or_value_in_a_row_of_labels() {
+        // The CPU's Speed has a hint beside its caption; a GPU clock shows its value in three labels.
+        assert!(is_reading(&[Part::Group(vec![Part::Caption, Part::Caption]), Part::Value]));
+        assert!(is_reading(&[Part::Caption, Part::Group(vec![Part::Value, Part::Text, Part::Value])]));
+    }
+
+    #[test]
+    fn a_box_of_readings_or_a_lone_label_is_not_a_reading() {
+        // The CPU's rows hold several readings each; the row is not a tile, the readings in it are.
+        assert!(!is_reading(&[Part::Other, Part::Other]));
+        assert!(!is_reading(&[Part::Caption, Part::Value, Part::Other]));
+        assert!(!is_reading(&[Part::Caption]));
+        assert!(!is_reading(&[Part::Value]));
+        assert!(!is_reading(&[]));
+    }
+
+    #[test]
+    fn the_facts_card_covers_every_fact_and_no_more() {
+        // Memory's facts: names in column 1, values in column 3, rows 4 to 7.
+        let facts = [
+            Place { column: 1, row: 4, width: 1, height: 1 },
+            Place { column: 3, row: 4, width: 1, height: 1 },
+            Place { column: 1, row: 7, width: 1, height: 1 },
+            Place { column: 3, row: 7, width: 1, height: 1 },
+        ];
+        assert_eq!(span(&facts), Some(Place { column: 1, row: 4, width: 3, height: 4 }));
+    }
+
+    #[test]
+    fn a_fact_spanning_columns_widens_the_card() {
+        let facts = [Place { column: 0, row: 0, width: 1, height: 1 }, Place { column: 1, row: 2, width: 3, height: 2 }];
+        assert_eq!(span(&facts), Some(Place { column: 0, row: 0, width: 4, height: 4 }));
+    }
+
+    #[test]
+    fn no_facts_means_no_card() {
+        assert_eq!(span(&[]), None);
+    }
+
+    #[test]
+    fn lone_tiles_one_after_the_other_share_a_row() {
+        // The CPU's column: a row of tiles, Power Draw, a row of tiles, Up time, Temperature.
+        assert_eq!(pairs(&[false, true, false, true, true]), vec![3]);
+        assert_eq!(pairs(&[true, true, true, true]), vec![0, 2]);
+    }
+
+    #[test]
+    fn a_tile_pairs_once_and_a_lone_one_stays_full_width() {
+        assert_eq!(pairs(&[true, true, true]), vec![0], "the third tile keeps its own row");
+        assert_eq!(pairs(&[true]), Vec::<usize>::new());
+        assert_eq!(pairs(&[true, false, true]), Vec::<usize>::new());
+        assert_eq!(pairs(&[]), Vec::<usize>::new());
+    }
+}
diff --git a/src/popups.rs b/src/popups.rs
new file mode 100644
index 0000000..473cdb5
--- /dev/null
+++ b/src/popups.rs
@@ -0,0 +1,125 @@
+/* popups.rs
+ *
+ * Copyright 2026 xt0n1-t3ch
+ *
+ * This program is free software: you can redistribute it and/or modify
+ * it under the terms of the GNU General Public License as published by
+ * the Free Software Foundation, either version 3 of the License, or
+ * (at your option) any later version.
+ *
+ * SPDX-License-Identifier: GPL-3.0-or-later
+ */
+
+//! Aurora: KWin's blur and shadow under every popover and tooltip that opens over a glass window, as File Explorer
+//! gives its menus and tooltips (components/file-explorer/src/finderstyle.cpp, `eventFilter`). aurora-popups.css
+//! draws them as translucent glass. A shadow drawn by GTK would widen their surface past the body, and KWin 6.8 would
+//! put the blur off by as much, as it did for the window (src/shadow.rs).
+
+use std::cell::RefCell;
+use std::sync::Once;
+
+use gtk::glib::translate::{from_glib_borrow, Borrowed, IntoGlib};
+use gtk::{gdk, glib, prelude::*};
+
+use crate::glass::{Body, Glass};
+use crate::shadow::{self, Shadow};
+
+/// The blur and the shadow of one popup surface.
+struct Popup {
+    surface: glib::WeakRef<gdk::Surface>,
+    glass: Option<Glass>,
+    _shadow: Option<Shadow>,
+}
+
+thread_local! {
+    /// The popups that have their blur and shadow. GDK keeps a popover's surface while it is hidden and KWin keeps the
+    /// shadow with the surface, so a popover opened again needs no new ones; a surface that is gone drops its own.
+    static POPUPS: RefCell<Vec<Popup>> = const { RefCell::new(Vec::new()) };
+}
+
+/// Gives every popover and tooltip that opens over a window with the `aurora-glass` class KWin's blur and shadow,
+/// from now on. Calling it again changes nothing.
+pub fn dress_popups() {
+    static HOOK: Once = Once::new();
+    HOOK.call_once(|| {
+        let Some(map) = glib::subclass::signal::SignalId::lookup("map", gtk::Widget::static_type()) else {
+            return;
+        };
+        // glib-rs wraps no emission hook, and only a hook sees the popovers GTK makes on its own: nested submenus, a
+        // text field's menu, tooltips. GtkWidget's `map` allows hooks (gtkwidget.c, G_SIGNAL_RUN_FIRST only).
+        unsafe {
+            glib::gobject_ffi::g_signal_add_emission_hook(map.into_glib(), 0, Some(on_map), std::ptr::null_mut(), None);
+        }
+    });
+}
+
+/// Runs as any widget maps: after GTK realized it, before the widget's own handlers put its surface on screen. Keeps
+/// the hook for the next one.
+unsafe extern "C" fn on_map(
+    _hint: *mut glib::gobject_ffi::GSignalInvocationHint,
+    n_params: u32,
+    params: *const glib::gobject_ffi::GValue,
+    _data: glib::ffi::gpointer,
+) -> glib::ffi::gboolean {
+    if n_params > 0 {
+        // The first value holds the instance that emits the signal, a widget for GtkWidget's `map`.
+        let instance = glib::gobject_ffi::g_value_get_object(params) as *mut gtk::ffi::GtkWidget;
+        if !instance.is_null() {
+            let widget: Borrowed<gtk::Widget> = from_glib_borrow(instance);
+            dress(&widget);
+        }
+    }
+    glib::ffi::GTRUE
+}
+
+/// Hands KWin a blur and a shadow for `widget` when it is a popover or tooltip over a glass window whose surface has
+/// none yet. The blur follows the popup's size as GTK lays it out.
+fn dress(widget: &gtk::Widget) {
+    if widget.is::<gtk::Window>() {
+        return;
+    }
+    let Some(native) = widget.downcast_ref::<gtk::Native>() else {
+        return;
+    };
+    if !widget.root().is_some_and(|root| root.has_css_class("aurora-glass")) {
+        return;
+    }
+    let Some(surface) = native.surface() else {
+        return;
+    };
+    let spec = if widget.css_name() == "tooltip" { shadow::TOOLTIP } else { shadow::MENU };
+    let known = POPUPS.with_borrow_mut(|popups| {
+        popups.retain(|popup| popup.surface.upgrade().is_some());
+        popups.iter().any(|popup| popup.surface.upgrade().as_ref() == Some(&surface))
+    });
+    if known {
+        return;
+    }
+    let shadow = Shadow::attach(native, spec);
+    if let Some(shadow) = &shadow {
+        shadow.show(widget, true);
+    }
+    let glass = Glass::attach(native);
+    // The surface is the popup's body and nothing more: aurora-popups.css gives popups no shadow and menus no tail.
+    surface.connect_layout(move |surface, width, height| {
+        POPUPS.with_borrow(|popups| {
+            let popup = popups.iter().find(|popup| popup.surface.upgrade().as_ref() == Some(surface));
+            if let Some(glass) = popup.and_then(|popup| popup.glass.as_ref()) {
+                glass.fit(Some(Body {
+                    left: 0,
+                    top: 0,
+                    width,
+                    height,
+                    radius: spec.radius,
+                }));
+            }
+        });
+    });
+    POPUPS.with_borrow_mut(|popups| {
+        popups.push(Popup {
+            surface: surface.downgrade(),
+            glass,
+            _shadow: shadow,
+        });
+    });
+}
diff --git a/src/shadow.rs b/src/shadow.rs
new file mode 100644
index 0000000..b9a513a
--- /dev/null
+++ b/src/shadow.rs
@@ -0,0 +1,385 @@
+/* shadow.rs
+ *
+ * Copyright 2026 xt0n1-t3ch
+ *
+ * This program is free software: you can redistribute it and/or modify
+ * it under the terms of the GNU General Public License as published by
+ * the Free Software Foundation, either version 3 of the License, or
+ * (at your option) any later version.
+ *
+ * SPDX-License-Identifier: GPL-3.0-or-later
+ */
+
+//! Aurora: the shadow KWin draws around the window and its popups, outside their surface, as it draws File Explorer's
+//! (components/file-explorer/src/shadow.cpp). GTK's own client-side shadow made a surface reach past its body, which
+//! put KWin's blur off by as much (src/edges.rs tells why window.blp turns it off for the window; src/popups.rs gives
+//! the popups theirs).
+
+use std::cell::RefCell;
+use std::io::Write;
+use std::os::fd::AsFd;
+use std::os::unix::fs::OpenOptionsExt;
+
+use gdk_wayland::prelude::*;
+use gtk::{cairo, glib, prelude::*};
+use wayland_client::{
+    delegate_noop,
+    globals::{registry_queue_init, GlobalListContents},
+    protocol::{
+        wl_buffer::WlBuffer,
+        wl_registry::WlRegistry,
+        wl_shm::{self, WlShm},
+        wl_shm_pool::WlShmPool,
+        wl_surface::WlSurface,
+    },
+    Connection, Dispatch, EventQueue, Proxy, QueueHandle,
+};
+use wayland_protocols_plasma::shadow::client::{
+    org_kde_kwin_shadow::OrgKdeKwinShadow, org_kde_kwin_shadow_manager::OrgKdeKwinShadowManager,
+};
+
+use crate::glass::WINDOW_RADIUS;
+
+/// A shadow's shape, as File Explorer's shadow.h takes it (`ShadowSpec`): the corner radius of the body that casts it,
+/// how far it reaches past the body, how far down the light pushes it, the radius of the box blur that softens it, and
+/// its darkness right under the body's edge, from 0 to 255. Lengths are in logical pixels.
+#[derive(Clone, Copy, Debug, PartialEq, Eq)]
+pub struct Spec {
+    pub radius: i32,
+    pub extent: i32,
+    pub offset_y: i32,
+    pub blur: usize,
+    pub alpha: u8,
+}
+
+/// File Explorer's window shadow (glasswindow.cpp, WINDOW_SHADOW).
+pub const WINDOW: Spec = Spec {
+    radius: WINDOW_RADIUS,
+    extent: 64,
+    offset_y: 14,
+    blur: 15,
+    alpha: 150,
+};
+
+/// File Explorer's menu shadow (finderstyle.cpp, `eventFilter`), around aurora-popups.css's 11 px menus.
+pub const MENU: Spec = Spec {
+    radius: 11,
+    extent: 28,
+    offset_y: 8,
+    blur: 9,
+    alpha: 115,
+};
+
+/// File Explorer's tooltip shadow: the menu's, around aurora-popups.css's 8 px tooltips.
+pub const TOOLTIP: Spec = Spec { radius: 8, ..MENU };
+
+/// Box blurs in a row, which together come close to a Gaussian blur.
+const BLUR_PASSES: usize = 3;
+
+/// ARGB8888: blue, green, red and alpha, one byte each.
+const BYTES_PER_PIXEL: i32 = 4;
+
+/// Holds no state: none of the objects used here sends events the code reads.
+pub struct ShadowEvents;
+
+impl Dispatch<WlRegistry, GlobalListContents> for ShadowEvents {
+    fn event(
+        _: &mut Self,
+        _: &WlRegistry,
+        _: <WlRegistry as Proxy>::Event,
+        _: &GlobalListContents,
+        _: &Connection,
+        _: &QueueHandle<Self>,
+    ) {
+    }
+}
+
+delegate_noop!(ShadowEvents: ignore WlShm);
+delegate_noop!(ShadowEvents: ignore WlShmPool);
+delegate_noop!(ShadowEvents: ignore WlBuffer);
+delegate_noop!(ShadowEvents: ignore OrgKdeKwinShadowManager);
+delegate_noop!(ShadowEvents: ignore OrgKdeKwinShadow);
+
+/// The shadow KWin draws around a window or popup, outside its surface.
+pub struct Shadow {
+    connection: Connection,
+    queue: EventQueue<ShadowEvents>,
+    manager: OrgKdeKwinShadowManager,
+    surface: WlSurface,
+    /// How far the shadow reaches past the body: KWin takes it as each edge's offset.
+    extent: i32,
+    /// The eight tiles in the protocol's order: top left, top, top right, right, bottom right, bottom, bottom left,
+    /// left. They live in one shared pool and stay as long as the shadow.
+    tiles: Vec<WlBuffer>,
+    pool: WlShmPool,
+    shadow: RefCell<Option<OrgKdeKwinShadow>>,
+}
+
+impl Shadow {
+    /// Gets a shadow of `spec`'s shape ready for `native`'s surface; [`Shadow::show`] hands it to KWin. Returns `None`
+    /// outside Wayland, before `native` is realized, or when the compositor does not draw shadows for windows (another
+    /// desktop).
+    pub fn attach(native: &impl IsA<gtk::Native>, spec: Spec) -> Option<Self> {
+        let surface = native.as_ref().surface()?.downcast::<gdk_wayland::WaylandSurface>().ok()?;
+        let display = surface.display().downcast::<gdk_wayland::WaylandDisplay>().ok()?;
+        let backend = display.wl_display()?.backend().upgrade()?;
+        let connection = Connection::from_backend(backend);
+        let (globals, queue) = registry_queue_init::<ShadowEvents>(&connection).ok()?;
+        let handle = queue.handle();
+        let manager: OrgKdeKwinShadowManager = globals.bind(&handle, 2..=2, ()).ok()?;
+        let shm: WlShm = globals.bind(&handle, 1..=1, ()).ok()?;
+
+        let (pixels, rects) = shadow_tiles(spec);
+        let file = shared_file(&pixels).ok()?;
+        let pool = shm.create_pool(file.as_fd(), pixels.len() as i32, &handle, ());
+        let tiles = rects
+            .iter()
+            .map(|&(offset, width, height)| {
+                pool.create_buffer(offset, width, height, width * BYTES_PER_PIXEL, wl_shm::Format::Argb8888, &handle, ())
+            })
+            .collect();
+        Some(Self {
+            connection,
+            queue,
+            manager,
+            surface: surface.wl_surface()?,
+            extent: spec.extent,
+            tiles,
+            pool,
+            shadow: RefCell::new(None),
+        })
+    }
+
+    /// Shows the shadow around `native` when `wanted`, and takes it away when not, such as from a maximized, tiled or
+    /// full screen window, as File Explorer does (glasswindow.cpp, `updateShadow`). Showing it again changes nothing.
+    pub fn show(&self, native: &impl IsA<gtk::Widget>, wanted: bool) {
+        let mut current = self.shadow.borrow_mut();
+        if wanted == current.is_some() {
+            return;
+        }
+        if let Some(old) = current.take() {
+            self.manager.unset(&self.surface);
+            old.destroy();
+        } else {
+            let shadow = self.manager.create(&self.surface, &self.queue.handle(), ());
+            let [top_left, top, top_right, right, bottom_right, bottom, bottom_left, left] = &self.tiles[..] else {
+                return;
+            };
+            shadow.attach_top_left(top_left);
+            shadow.attach_top(top);
+            shadow.attach_top_right(top_right);
+            shadow.attach_right(right);
+            shadow.attach_bottom_right(bottom_right);
+            shadow.attach_bottom(bottom);
+            shadow.attach_bottom_left(bottom_left);
+            shadow.attach_left(left);
+            let extent = f64::from(self.extent);
+            shadow.set_left_offset(extent);
+            shadow.set_top_offset(extent);
+            shadow.set_right_offset(extent);
+            shadow.set_bottom_offset(extent);
+            shadow.commit();
+            *current = Some(shadow);
+        }
+        let _ = self.connection.flush();
+        // KWin takes the new shadow with the surface's next commit.
+        native.as_ref().queue_draw();
+    }
+}
+
+impl Drop for Shadow {
+    /// Takes the shadow, its tiles and their pool back from KWin. The surface may be gone already, so this sends
+    /// nothing that names it.
+    fn drop(&mut self) {
+        if let Some(shadow) = self.shadow.take() {
+            shadow.destroy();
+        }
+        for tile in &self.tiles {
+            tile.destroy();
+        }
+        self.pool.destroy();
+        let _ = self.connection.flush();
+    }
+}
+
+/// The eight tiles of the shadow image back to back, as premultiplied ARGB8888, and each one's byte offset, width
+/// and height, in the protocol's order. They are cut from the image as File Explorer cuts them (shadow.cpp,
+/// `attachShadow`): square corners, and one row or column for each edge, which KWin repeats along it.
+fn shadow_tiles(spec: Spec) -> (Vec<u8>, [(i32, i32, i32); 8]) {
+    let (alpha, side) = shadow_image(spec);
+    let corner = spec.extent + spec.radius;
+    let extent = spec.extent;
+    let far = side - corner;
+    let cuts = [
+        (0, 0, corner, corner),
+        (corner, 0, 1, extent),
+        (far, 0, corner, corner),
+        (side - extent, corner, extent, 1),
+        (far, far, corner, corner),
+        (corner, side - extent, 1, extent),
+        (0, far, corner, corner),
+        (0, corner, extent, 1),
+    ];
+    let mut pixels = Vec::new();
+    let mut rects = [(0, 0, 0); 8];
+    for (index, &(x, y, width, height)) in cuts.iter().enumerate() {
+        rects[index] = (pixels.len() as i32, width, height);
+        for row in y..y + height {
+            for column in x..x + width {
+                // Premultiplied black: blue, green and red stay 0 and only the alpha byte, the last in memory, counts.
+                pixels.extend_from_slice(&[0, 0, 0, alpha[(row * side + column) as usize]]);
+            }
+        }
+    }
+    (pixels, rects)
+}
+
+/// File Explorer's shadow image (shadow.cpp, `shadowImage`) as an alpha mask, and its side: a body with `spec`'s
+/// corners, darkened, pushed down, blurred, then cut out where the body is, so the shadow never darkens the
+/// translucent glass. The side is odd so a middle row and column are left for the edge tiles.
+fn shadow_image(spec: Spec) -> (Vec<u8>, i32) {
+    let side = 2 * (spec.extent + spec.radius) + 1;
+    let body = f64::from(side - 2 * spec.extent);
+    let inset = f64::from(spec.extent);
+    let radius = f64::from(spec.radius);
+    let Ok(mut surface) = cairo::ImageSurface::create(cairo::Format::A8, side, side) else {
+        return (vec![0; (side * side) as usize], side);
+    };
+    if let Ok(cr) = cairo::Context::new(&surface) {
+        rounded_rect(&cr, inset, inset + f64::from(spec.offset_y), body, body, radius);
+        cr.set_source_rgba(0.0, 0.0, 0.0, f64::from(spec.alpha) / 255.0);
+        let _ = cr.fill();
+    }
+    surface.flush();
+    let stride = surface.stride() as usize;
+    let mut alpha = vec![0u8; (side * side) as usize];
+    if let Ok(data) = surface.data() {
+        for row in 0..side as usize {
+            let start = row * side as usize;
+            alpha[start..start + side as usize].copy_from_slice(&data[row * stride..row * stride + side as usize]);
+        }
+    }
+    box_blur(&mut alpha, side as usize, side as usize, spec.blur);
+    if let Ok(mut data) = surface.data() {
+        for row in 0..side as usize {
+            let start = row * side as usize;
+            data[row * stride..row * stride + side as usize].copy_from_slice(&alpha[start..start + side as usize]);
+        }
+    }
+    if let Ok(cr) = cairo::Context::new(&surface) {
+        cr.set_operator(cairo::Operator::DestOut);
+        rounded_rect(&cr, inset, inset, body, body, radius);
+        let _ = cr.fill();
+    }
+    surface.flush();
+    if let Ok(data) = surface.data() {
+        for row in 0..side as usize {
+            let start = row * side as usize;
+            alpha[start..start + side as usize].copy_from_slice(&data[row * stride..row * stride + side as usize]);
+        }
+    }
+    (alpha, side)
+}
+
+/// Adds a rounded rectangle to `cr`'s path.
+fn rounded_rect(cr: &cairo::Context, x: f64, y: f64, width: f64, height: f64, radius: f64) {
+    use std::f64::consts::{FRAC_PI_2, PI};
+    cr.new_sub_path();
+    cr.arc(x + width - radius, y + radius, radius, -FRAC_PI_2, 0.0);
+    cr.arc(x + width - radius, y + height - radius, radius, 0.0, FRAC_PI_2);
+    cr.arc(x + radius, y + height - radius, radius, FRAC_PI_2, PI);
+    cr.arc(x + radius, y + radius, radius, PI, PI + FRAC_PI_2);
+    cr.close_path();
+}
+
+/// Box-blurs a `width` by `height` alpha mask along its rows, then its columns, BLUR_PASSES times over (File
+/// Explorer's shadow.cpp, `boxBlurAlpha`). Pixels past either end repeat the edge pixel.
+fn box_blur(alpha: &mut [u8], width: usize, height: usize, radius: usize) {
+    let window = 2 * radius + 1;
+    let mut line = vec![0u32; width.max(height)];
+    let blur_line = |read: &dyn Fn(usize) -> u32, length: usize, out: &mut [u32]| {
+        let at = |i: isize| read(i.clamp(0, length as isize - 1) as usize);
+        let mut sum: u32 = (-(radius as isize)..=radius as isize).map(at).sum();
+        for i in 0..length {
+            out[i] = sum / window as u32;
+            sum = sum + at(i as isize + radius as isize + 1) - at(i as isize - radius as isize);
+        }
+    };
+    for _ in 0..BLUR_PASSES {
+        for y in 0..height {
+            let row: Vec<u32> = alpha[y * width..(y + 1) * width].iter().map(|&a| u32::from(a)).collect();
+            blur_line(&|x| row[x], width, &mut line);
+            for x in 0..width {
+                alpha[y * width + x] = line[x] as u8;
+            }
+        }
+        for x in 0..width {
+            let column: Vec<u32> = (0..height).map(|y| u32::from(alpha[y * width + x])).collect();
+            blur_line(&|y| column[y], height, &mut line);
+            for y in 0..height {
+                alpha[y * width + x] = line[y] as u8;
+            }
+        }
+    }
+}
+
+/// A file holding `pixels` that only this process can open, unlinked at once, for KWin to map: wl_shm takes pixels
+/// as a file.
+fn shared_file(pixels: &[u8]) -> std::io::Result<std::fs::File> {
+    let path = glib::user_runtime_dir().join(format!("missioncenter-shadow-{}", std::process::id()));
+    let mut file = std::fs::OpenOptions::new()
+        .read(true)
+        .write(true)
+        .create(true)
+        .truncate(true)
+        .mode(0o600)
+        .open(&path)?;
+    std::fs::remove_file(&path)?;
+    file.write_all(pixels)?;
+    Ok(file)
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+
+    #[test]
+    fn the_blur_spreads_a_point_and_keeps_an_even_field_even() {
+        let mut point = vec![0u8; 31 * 31];
+        point[15 * 31 + 15] = 255;
+        box_blur(&mut point, 31, 31, 2);
+        assert!(point[15 * 31 + 15] < 255, "the middle loses some of its alpha");
+        assert!(point[15 * 31 + 18] > 0, "its neighbours gain some");
+        let mut even = vec![150u8; 20 * 20];
+        box_blur(&mut even, 20, 20, 3);
+        assert!(even.iter().all(|&a| a == 150));
+    }
+
+    #[test]
+    fn the_shadow_is_cut_out_under_the_body_and_darker_below_it_than_above() {
+        for spec in [WINDOW, MENU, TOOLTIP] {
+            let (alpha, side) = shadow_image(spec);
+            let at = |x: i32, y: i32| alpha[(y * side + x) as usize];
+            let middle = side / 2;
+            assert_eq!(at(middle, middle), 0, "the body itself stays clear: {spec:?}");
+            assert!(
+                at(middle, side - spec.extent + 4) > at(middle, spec.extent - 4),
+                "the light pushes it down: {spec:?}"
+            );
+            assert_eq!(at(0, 0), 0, "it fades out before the image's corner: {spec:?}");
+        }
+    }
+
+    #[test]
+    fn the_tiles_cover_the_corners_and_one_line_per_edge() {
+        for spec in [WINDOW, MENU, TOOLTIP] {
+            let (pixels, rects) = shadow_tiles(spec);
+            let corner = spec.extent + spec.radius;
+            assert_eq!(rects[0].1, corner);
+            assert_eq!((rects[1].1, rects[1].2), (1, spec.extent));
+            assert_eq!((rects[3].1, rects[3].2), (spec.extent, 1));
+            let total: i32 = rects.iter().map(|&(_, w, h)| w * h * BYTES_PER_PIXEL).sum();
+            assert_eq!(total as usize, pixels.len());
+        }
+    }
+}
diff --git a/src/table_view/columns/heat.rs b/src/table_view/columns/heat.rs
new file mode 100644
index 0000000..1644618
--- /dev/null
+++ b/src/table_view/columns/heat.rs
@@ -0,0 +1,152 @@
+/* table_view/columns/heat.rs
+ *
+ * Copyright 2026 xt0n1-t3ch
+ *
+ * This program is free software: you can redistribute it and/or modify
+ * it under the terms of the GNU General Public License as published by
+ * the Free Software Foundation, either version 3 of the License, or
+ * (at your option) any later version.
+ *
+ * SPDX-License-Identifier: GPL-3.0-or-later
+ */
+
+//! Aurora: the heat tint of the Apps and Services tables, as Windows 11's Task Manager shades a busy cell. A value
+//! falls into one of five steps by what it measures; each step but the first gives the cell a CSS class that
+//! aurora-pages.css tints, deeper as the step rises: in the accent blue for a share of the CPU or the GPU, in amber
+//! for memory and throughput. The `apps-page-heat-tint` setting turns it off.
+
+use gtk::prelude::*;
+
+use super::LabelCell;
+use crate::table_view::settings::is_heat_tint_active;
+
+/// What a cell measures, with its value in the unit the table already reads.
+#[derive(Clone, Copy, Debug, PartialEq)]
+pub enum Load {
+    /// A share of the CPU or the GPU, in percent.
+    Percent(f32),
+    /// Memory, swap or GPU memory, in bytes.
+    Bytes(f32),
+    /// Drive throughput, in bytes per second.
+    DriveRate(f32),
+    /// Network throughput, in bytes per second.
+    NetworkRate(f32),
+}
+
+/// How heavily a value weighs, from nothing worth showing to the top step.
+#[derive(Clone, Copy, Debug, PartialEq, Eq, PartialOrd, Ord)]
+pub enum Heat {
+    None,
+    Low,
+    Medium,
+    High,
+    Peak,
+}
+
+const MIB: f32 = 1024. * 1024.;
+const MB: f32 = 1_000_000.;
+
+/// The lower bound of Low, Medium, High and Peak for a share in percent.
+const PERCENT_STEPS: [f32; 4] = [5., 20., 50., 80.];
+/// The same for memory: a quarter GiB is already noticeable on a desktop, 4 GiB is one app holding much of it.
+const MEMORY_STEPS: [f32; 4] = [256. * MIB, 1024. * MIB, 2048. * MIB, 4096. * MIB];
+/// The same for drive throughput: a busy desktop app writes a few MB/s, a copy or a build hundreds.
+const DRIVE_STEPS: [f32; 4] = [1. * MB, 10. * MB, 50. * MB, 200. * MB];
+/// The same for network throughput: a stream needs about 1 MB/s, a download runs at tens.
+const NETWORK_STEPS: [f32; 4] = [0.1 * MB, 1. * MB, 10. * MB, 50. * MB];
+
+/// The CSS class of each step above None, in the order of `Heat`.
+const CLASSES: [&str; 4] = ["heat-low", "heat-medium", "heat-high", "heat-peak"];
+/// The CSS class that turns a cell's tint from amber to the accent blue.
+const SHARE_CLASS: &str = "heat-share";
+
+/// Whether `load` is a share of a processor, tinted in the accent blue rather than amber.
+pub fn is_share(load: Load) -> bool {
+    matches!(load, Load::Percent(_))
+}
+
+/// The step `load` falls into.
+pub fn heat_of(load: Load) -> Heat {
+    let (value, steps) = match load {
+        Load::Percent(value) => (value, PERCENT_STEPS),
+        Load::Bytes(value) => (value, MEMORY_STEPS),
+        Load::DriveRate(value) => (value, DRIVE_STEPS),
+        Load::NetworkRate(value) => (value, NETWORK_STEPS),
+    };
+    match steps.iter().filter(|&&step| value >= step).count() {
+        0 => Heat::None,
+        1 => Heat::Low,
+        2 => Heat::Medium,
+        3 => Heat::High,
+        _ => Heat::Peak,
+    }
+}
+
+/// Tints the table cell that holds `label` for `load`, or clears its tint when the setting is off. The tint goes on
+/// the whole cell (the label's grandparent, past the tree expander), so it fills the column, not just the digits.
+pub fn set_label_heat(label: &LabelCell, load: Load) {
+    let heat = if is_heat_tint_active() { heat_of(load) } else { Heat::None };
+    let Some(cell) = label.parent().and_then(|expander| expander.parent()) else {
+        return;
+    };
+    for (step, class) in CLASSES.iter().enumerate() {
+        if heat as usize == step + 1 {
+            cell.add_css_class(class);
+        } else {
+            cell.remove_css_class(class);
+        }
+    }
+    if is_share(load) {
+        cell.add_css_class(SHARE_CLASS);
+    } else {
+        cell.remove_css_class(SHARE_CLASS);
+    }
+}
+
+#[cfg(test)]
+mod tests {
+    use super::{heat_of, is_share, Heat, Load, MB, MIB};
+
+    #[test]
+    fn an_idle_value_has_no_tint() {
+        assert_eq!(heat_of(Load::Percent(0.)), Heat::None);
+        assert_eq!(heat_of(Load::Bytes(30. * MIB)), Heat::None);
+        assert_eq!(heat_of(Load::NetworkRate(2_000.)), Heat::None);
+    }
+
+    #[test]
+    fn each_step_starts_at_its_bound() {
+        assert_eq!(heat_of(Load::Percent(4.9)), Heat::None);
+        assert_eq!(heat_of(Load::Percent(5.)), Heat::Low);
+        assert_eq!(heat_of(Load::Percent(20.)), Heat::Medium);
+        assert_eq!(heat_of(Load::Percent(50.)), Heat::High);
+        assert_eq!(heat_of(Load::Percent(80.)), Heat::Peak);
+        assert_eq!(heat_of(Load::Percent(400.)), Heat::Peak, "a multi-core share above 100% stays at the top");
+    }
+
+    #[test]
+    fn units_are_read_in_their_own_scale() {
+        // The same number means different loads: 2 GiB of memory is high, 2 GB/s of disk is the peak.
+        assert_eq!(heat_of(Load::Bytes(2048. * MIB)), Heat::High);
+        assert_eq!(heat_of(Load::DriveRate(2000. * MB)), Heat::Peak);
+        assert_eq!(heat_of(Load::NetworkRate(1. * MB)), Heat::Medium);
+    }
+
+    #[test]
+    fn processor_shares_are_tinted_blue_and_sizes_and_rates_amber() {
+        assert!(is_share(Load::Percent(30.)), "CPU and GPU shares");
+        assert!(!is_share(Load::Bytes(2048. * MIB)), "memory, swap and GPU memory");
+        assert!(!is_share(Load::DriveRate(50. * MB)));
+        assert!(!is_share(Load::NetworkRate(1. * MB)));
+    }
+
+    #[test]
+    fn heat_never_falls_as_the_value_rises() {
+        let mut last = Heat::None;
+        for step in 0..=200 {
+            let heat = heat_of(Load::Bytes(step as f32 * 32. * MIB));
+            assert!(heat >= last, "{step}: {heat:?} after {last:?}");
+            last = heat;
+        }
+    }
+}
