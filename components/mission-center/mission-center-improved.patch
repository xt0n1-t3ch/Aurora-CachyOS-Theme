+
+/// Aurora: the usage bar's style class over 90 % used.
+const CAPACITY_LOW: &str = "aurora-capacity-low";
+/// Aurora: the usage bar's style class over 95 % used.
+const CAPACITY_CRITICAL: &str = "aurora-capacity-critical";
+
+/// Aurora: turns `bar` amber, then red, as File Explorer turns a nearly full drive's bar; aurora-pages.css colors it.
+fn show_capacity(bar: &gtk::ProgressBar, used: f64) {
+    for class in [CAPACITY_LOW, CAPACITY_CRITICAL] {
+        bar.remove_css_class(class);
+    }
+    if let Some(class) = capacity_class(used) {
+        bar.add_css_class(class);
+    }
+}
+
+/// Aurora: the style class of a usage bar `used` full (0 to 1), at File Explorer's thresholds
+/// (components/file-explorer/src/core/drives.cpp, `capacityFor`), or none while there is room.
+fn capacity_class(used: f64) -> Option<&'static str> {
+    if used > 0.95 {
+        Some(CAPACITY_CRITICAL)
+    } else if used > 0.90 {
+        Some(CAPACITY_LOW)
+    } else {
+        None
+    }
+}
+
+#[cfg(test)]
+mod tests {
+    use super::{capacity_class, CAPACITY_CRITICAL, CAPACITY_LOW};
+
+    #[test]
+    fn a_partition_turns_amber_past_90_percent_and_red_past_95() {
+        assert_eq!(capacity_class(0.0), None);
+        assert_eq!(capacity_class(0.90), None, "90 % used still has room");
+        assert_eq!(capacity_class(0.91), Some(CAPACITY_LOW));
+        assert_eq!(capacity_class(0.95), Some(CAPACITY_LOW), "95 % used is not yet critical");
+        assert_eq!(capacity_class(0.96), Some(CAPACITY_CRITICAL));
+        assert_eq!(capacity_class(1.0), Some(CAPACITY_CRITICAL));
+    }
+}
