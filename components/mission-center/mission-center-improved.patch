diff --git a/resources/ui/aurora-header.css b/resources/ui/aurora-header.css
new file mode 100644
index 0000000..a177821
--- /dev/null
+++ b/resources/ui/aurora-header.css
@@ -0,0 +1,254 @@
+/* aurora-header.css
+ *
+ * Copyright 2026 xt0n1-t3ch
+ *
+ * This program is free software: you can redistribute it and/or modify
+ * it under the terms of the GNU General Public License as published by
+ * the Free Software Foundation, either version 3 of the License, or
+ * (at your option) any later version.
+ *
+ * SPDX-License-Identifier: GPL-3.0-or-later
+ */
+
+/* Aurora: the header bars of Mission Center's glass window, which hold File Explorer's toolbar row: its round and plain
+ * buttons, the page switcher, the search field and the window buttons. src/glass.rs loads it after aurora.css, whose
+ * colors (`--aurora-fill` and the rest) it uses, so its rules win where a rule there reaches a header bar widget too
+ * (the page switcher's segments sit in a stack, as the page buttons do). */
+/* Header bars: transparent over the glass. */
+window.aurora-glass headerbar {
+    background: none;
+    box-shadow: none;
+}
+
+/* A window that is not in front keeps its header bars as they are, as File Explorer keeps its toolbar; only the window
+ * buttons dim. libadwaita would halve the opacity of everything in them. */
+window.aurora-glass headerbar:backdrop > windowhandle {
+    filter: none;
+}
+
+/* The two header bars hold File Explorer's toolbar row (components/file-explorer/src/style.h, toolbar.cpp): 34 px
+ * capsules 15 px below the window's top edge, 9 px of bar below them, the window buttons 22 px in from the right edge,
+ * and at least 10 px between the sidebar's card and the first capsule, as File Explorer's 6 and 4 px margins. */
+window.aurora-glass overlay-split-view headerbar {
+    min-height: 0;
+}
+
+window.aurora-glass overlay-split-view headerbar > windowhandle > box {
+    padding: 15px 22px 9px 4px;
+}
+
+/* The header bar's sidebar button, shown while the sidebar is hidden, takes the exact place of the sidebar's own: 6 px
+ * of window and 12 px of card in, plus its 2 px margin. Its margin, not the bar's padding, keeps that room, so the
+ * page switcher has it while the sidebar shows. */
+window.aurora-glass headerbar button.aurora-plain.aurora-show-sidebar {
+    margin-left: 16px;
+}
+
+/* The sidebar's card starts 6 px down, so 9 px above its row put its buttons on the header bar's line; 3 px below it
+ * start the devices where File Explorer starts its sidebar's items. */
+window.aurora-glass overlay-split-view .sidebar-pane headerbar > windowhandle > box {
+    padding: 9px 10px 3px 12px;
+}
+
+/* Buttons with glass of their own, File Explorer's round toolbar buttons: 34 px circles. Under the pointer, pressed
+ * or checked, a fill lies over the glass, as File Explorer paints them. */
+window.aurora-glass headerbar button:not(.text-button):not(.aurora-plain),
+window.aurora-glass headerbar menubutton > button {
+    min-width: 34px;
+    min-height: 34px;
+    padding: 0;
+    border-radius: 9999px;
+    background-color: var(--aurora-fill);
+    background-image: none;
+    box-shadow: inset 0 1px var(--aurora-rim-top), inset 0 0 0 1px var(--aurora-rim);
+    opacity: 1;
+}
+
+window.aurora-glass headerbar button:not(.text-button):not(.aurora-plain):hover,
+window.aurora-glass headerbar menubutton > button:hover {
+    background-image: image(var(--aurora-fill-hover));
+}
+
+window.aurora-glass headerbar button:not(.text-button):not(.aurora-plain):checked,
+window.aurora-glass headerbar menubutton > button:checked {
+    background-image: image(var(--aurora-fill-checked));
+}
+
+window.aurora-glass headerbar button:not(.text-button):not(.aurora-plain):active,
+window.aurora-glass headerbar menubutton > button:active {
+    background-image: image(var(--aurora-fill-active));
+}
+
+/* Buttons without glass of their own, as File Explorer draws the buttons of its sidebar header and the sidebar button
+ * in its toolbar: a symbol in a 38 x 34 px place, and a 34 x 28 px pill under the pointer. */
+window.aurora-glass headerbar button.aurora-plain {
+    min-width: 34px;
+    min-height: 28px;
+    margin: 3px 2px;
+    padding: 0;
+    border-radius: 9999px;
+    background: none;
+    box-shadow: none;
+    opacity: 1;
+    transition: background-color 150ms ease-out;
+}
+
+window.aurora-glass headerbar button.aurora-plain:hover {
+    background-color: var(--aurora-fill-hover);
+}
+
+window.aurora-glass headerbar button.aurora-plain:checked {
+    background-color: var(--aurora-fill-checked);
+}
+
+window.aurora-glass headerbar button.aurora-plain:active {
+    background-color: var(--aurora-fill-active);
+}
+
+/* File Explorer draws its toolbar symbols at 18 px. */
+window.aurora-glass headerbar button:not(.text-button) > image,
+window.aurora-glass headerbar menubutton > button > image {
+    -gtk-icon-size: 18px;
+}
+
+/* The details button shows the sidebar symbol mirrored, for the panel at the other side; turning the whole button, as
+ * the stock `.flipped` class does, would turn its glass upside down with it. */
+window.aurora-glass headerbar button.flipped {
+    transform: none;
+}
+
+window.aurora-glass headerbar button.flipped > image {
+    transform: scaleX(-1);
+}
+
+/* The page switcher is a segmented capsule, as File Explorer's view buttons: each page is a pill inset 5 px from the
+ * capsule's ends and 3 px from its edges, and the page shown is the lighter one. libadwaita's 34 px minimum counts
+ * without the padding, so the capsule's 34 px leave 28 for the pills. */
+window.aurora-glass headerbar viewswitcher {
+    min-height: 28px;
+    padding: 3px;
+    border-radius: 9999px;
+    background-color: var(--aurora-fill);
+    box-shadow: inset 0 1px var(--aurora-rim-top), inset 0 0 0 1px var(--aurora-rim);
+}
+
+/* Each segment keeps the theme's own inset: the switcher pads the label box inside it by 12 px, and more padding on
+ * the button made the switcher wider than the header bar has room for, which cut its labels short. */
+window.aurora-glass headerbar viewswitcher button.toggle:not(.text-button):not(.aurora-plain) {
+    min-height: 28px;
+    margin: 0 2px;
+    padding: 0;
+    border-radius: 9999px;
+    background: none;
+    box-shadow: none;
+    opacity: 1;
+    transition: background-color 150ms ease-out;
+}
+
+window.aurora-glass headerbar viewswitcher > separator {
+    opacity: 0;
+}
+
+window.aurora-glass headerbar viewswitcher button.toggle:not(.text-button):not(.aurora-plain):hover {
+    background-color: var(--aurora-fill-hover);
+}
+
+window.aurora-glass headerbar viewswitcher button.toggle:not(.text-button):not(.aurora-plain):checked {
+    background-color: var(--aurora-fill-checked);
+}
+
+/* The search field is File Explorer's: a glass capsule that turns a step lighter, with the accent ring, while typing.
+ * It drops the GTK theme's vertical padding, which made it, and the whole row with it, 40 px tall. */
+window.aurora-glass entry.aurora-search {
+    min-height: 34px;
+    padding-top: 0;
+    padding-bottom: 0;
+    border-radius: 9999px;
+    background-color: var(--aurora-fill);
+    background-image: none;
+    box-shadow: inset 0 1px var(--aurora-rim-top), inset 0 0 0 1px var(--aurora-rim);
+    opacity: 1;
+}
+
+window.aurora-glass entry.aurora-search:focus-within {
+    background-color: var(--aurora-fill-hover);
+    box-shadow: inset 0 0 0 2px var(--accent-bg-color);
+}
+
+window.aurora-glass entry.aurora-search > image,
+window.aurora-glass entry.aurora-search > text > placeholder {
+    color: rgba(235, 235, 245, 0.59);
+}
+
+/* Window buttons: File Explorer's capsule (components/file-explorer/src/windowcontrols.cpp), minimize, maximize and
+ * close in 38 x 34 px places with a 3 px pad at each end, so 120 x 34 px, 12 px from the search field. Aurora's GTK
+ * theme draws the same one for every GTK 4 app (themes/gtk/gtk_theme.py) and installs the glyphs, File Explorer's
+ * 9.6 px strokes. Each button repeats the header bar's own selector and adds the capsule's, so it outranks the round
+ * header bar buttons above, which made each window button its own circle and piled them up. */
+window.aurora-glass headerbar windowcontrols:not(.empty) {
+    padding: 0 3px;
+    border-spacing: 0;
+    border-radius: 9999px;
+    background-color: var(--aurora-fill);
+    box-shadow: inset 0 1px var(--aurora-rim-top), inset 0 0 0 1px var(--aurora-rim);
+}
+
+window.aurora-glass headerbar windowcontrols.end:not(.empty) {
+    margin-left: 6px;
+}
+
+window.aurora-glass headerbar windowcontrols.start:not(.empty) {
+    margin-right: 6px;
+}
+
+window.aurora-glass headerbar windowcontrols > button:not(.text-button):not(.aurora-plain) {
+    min-width: 34px;
+    min-height: 28px;
+    margin: 3px 2px;
+    padding: 0;
+    border: none;
+    border-radius: 9999px;
+    background: none;
+    box-shadow: none;
+    color: rgba(255, 255, 255, 0.925);
+    transition: background-color 150ms ease-out;
+}
+
+window.aurora-glass headerbar windowcontrols > button:not(.text-button):not(.aurora-plain) > image {
+    -gtk-icon-size: 16px;
+    margin: 0;
+    padding: 0;
+    background: none;
+    box-shadow: none;
+}
+
+/* While the window is not in front, the glyphs dim to File Explorer's tertiary text (TEXT_TERTIARY) until the pointer
+ * comes over them: the hover rules below come later, so they win. */
+window.aurora-glass headerbar windowcontrols > button:not(.text-button):not(.aurora-plain):backdrop {
+    color: rgba(235, 235, 245, 0.32);
+}
+
+window.aurora-glass headerbar windowcontrols > button:not(.text-button):not(.aurora-plain):hover {
+    background-color: var(--aurora-fill-hover);
+    color: rgba(255, 255, 255, 0.925);
+}
+
+window.aurora-glass headerbar windowcontrols > button:not(.text-button):not(.aurora-plain):active {
+    background-color: var(--aurora-fill-active);
+}
+
+window.aurora-glass headerbar windowcontrols > button.close:not(.text-button):not(.aurora-plain):hover {
+    background-color: #ff453a;
+    color: white;
+}
+
+window.aurora-glass headerbar windowcontrols > button.close:not(.text-button):not(.aurora-plain):active {
+    background-color: #d6342c;
+    color: white;
+}
+
+/* Keyboard focus on a header bar button is a soft white ring, not the theme's accent ring around a round button. */
+window.aurora-glass headerbar button:focus-visible {
+    outline: 2px solid rgba(255, 255, 255, 0.35);
+    outline-offset: 1px;
+}
