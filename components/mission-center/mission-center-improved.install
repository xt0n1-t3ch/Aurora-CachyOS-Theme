# pacman's install script for Aurora's Mission Center: aurora-mission-center-nethogs.hook gives nethogs its two
# capabilities while this package is installed, and removing the package takes them away again.

post_remove() {
    if [ -x /usr/bin/nethogs ]; then
        setcap -r /usr/bin/nethogs 2> /dev/null || true
    fi
}
