+/// The processes that draw the desktop itself: the compositor, its X11 bridge and the shell. They are
+/// no app's, so without a row of their own the GPU and CPU they use (the compositor draws every blurred
+/// panel and window shadow) shows in the totals but in no app, like Desktop Window Manager on Windows.
+const DESKTOP_PROCESSES: &[&str] = &[
+    "kwin_wayland",
+    "kwin_x11",
+    "Xwayland",
+    "plasmashell",
+    "gnome-shell",
+];
+
+/// The id of the desktop row; not a desktop entry, so it cannot clash with an installed app.
+const DESKTOP_APP_ID: &str = "io.missioncenter.MissionCenter.Desktop";
+
+/// The icon of the desktop row, from the icon theme.
+const DESKTOP_APP_ICON: &str = "plasma";
+
+/// A row for the desktop's own processes that no app claimed, or `None` when there are none.
+fn desktop_app(processes: &HashMap<u32, Process>, claimed: &[App]) -> Option<App> {
+    let claimed: std::collections::HashSet<u32> = claimed
+        .iter()
+        .flat_map(|app| app.pids.iter().copied())
+        .collect();
+    let mut pids: Vec<u32> = processes
+        .values()
+        .filter(|process| DESKTOP_PROCESSES.contains(&process.name.as_str()))
+        .map(|process| process.pid)
+        .filter(|pid| !claimed.contains(pid))
+        .collect();
+    if pids.is_empty() {
+        return None;
+    }
+    pids.sort_unstable();
+    Some(App {
+        id: DESKTOP_APP_ID.to_owned(),
+        name: "Desktop".to_owned(),
+        command: String::new(),
+        pids,
+    })
+}
