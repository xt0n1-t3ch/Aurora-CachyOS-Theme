+/// Whether a GPU refresh must read the GPU usage of each process.
+#[derive(Clone, Copy, Debug, PartialEq, Eq)]
+pub enum ProcessUsage {
+    /// Someone shows processes, so their GPU usage is read.
+    Wanted,
+    /// Nobody shows processes (the window is hidden), so the per-process reads can be skipped.
+    NotWanted,
+}
+
+/// Shortest time a process request keeps the per-process GPU usage wanted.
+const PROCESSES_WANTED_MIN: Duration = Duration::from_millis(1500);
+
+/// When processes were last asked for, to tell whether anyone still shows them.
+///
+/// Mission Center asks for processes once per update tick while its window is visible, and stops
+/// while it is hidden. A tick lasts from 0.5 s to 10 s depending on the update speed setting, so
+/// processes stay wanted for two of the last measured ticks.
+#[derive(Debug, Default)]
+pub struct ProcessRequests {
+    last: Option<Instant>,
+    tick: Option<Duration>,
+}
+
+impl ProcessRequests {
+    pub fn record(&mut self, now: Instant) {
+        if let Some(last) = self.last {
+            self.tick = Some(now.saturating_duration_since(last));
+        }
+        self.last = Some(now);
+    }
+
+    pub fn usage(&self, now: Instant) -> ProcessUsage {
+        let Some(last) = self.last else {
+            return ProcessUsage::NotWanted;
+        };
+        let window = self.tick.map_or(PROCESSES_WANTED_MIN, |tick| {
+            (tick * 2).max(PROCESSES_WANTED_MIN)
+        });
+        if now.saturating_duration_since(last) <= window {
+            ProcessUsage::Wanted
+        } else {
+            ProcessUsage::NotWanted
+        }
+    }
