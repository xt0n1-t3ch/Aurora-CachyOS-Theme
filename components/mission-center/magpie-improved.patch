+/// Most files magpie asks to keep open: three `/proc` files per process with room to spare.
+const OPEN_FILE_LIMIT: libc::rlim_t = 16384;
+
+/// Raises the soft limit of open files toward the hard one, so the `/proc` files of every process can
+/// stay open between refreshes. magpie waits with epoll, never select(), so descriptors above 1024 are
+/// safe. On failure the files are opened on each refresh as before.
+fn raise_open_file_limit() {
+    let mut limit = libc::rlimit {
+        rlim_cur: 0,
+        rlim_max: 0,
+    };
+    // SAFETY: `limit` is a valid, writable rlimit and RLIMIT_NOFILE is a valid resource.
+    if unsafe { libc::getrlimit(libc::RLIMIT_NOFILE, &mut limit) } != 0 {
+        return;
+    }
+    let wanted = OPEN_FILE_LIMIT.min(limit.rlim_max);
+    if limit.rlim_cur >= wanted {
+        return;
+    }
+    limit.rlim_cur = wanted;
+    // SAFETY: `limit` is a valid rlimit whose soft value does not exceed its hard value.
+    if unsafe { libc::setrlimit(libc::RLIMIT_NOFILE, &limit) } != 0 {
+        log::warn!("Failed to raise the open file limit to {}", wanted);
+    }
