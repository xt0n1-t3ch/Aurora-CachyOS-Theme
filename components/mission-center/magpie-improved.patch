+
+use std::collections::HashMap;
+use std::time::{Duration, Instant};
+
+use magpie_platform::gpus::{Process, ProcessKind, ProcessUsage};
+
+/// Shortest time between two reads of the per-process GPU usage.
+///
+/// NVML answers a utilization query with the samples taken since the previous one
+/// (`nvmlDeviceGetProcessUtilization`, `lastSeenTimeStamp`); a second query a few milliseconds later
+/// finds no new sample and NVTop then reports 0% for every process. Mission Center refreshes at most
+/// once per update tick (1 s by default, 0.5 s at the fastest setting), so this gap only drops the
+/// extra refreshes that can arrive within one tick.
+const PROCESS_REFRESH_MIN_GAP: Duration = Duration::from_millis(450);
+
+/// Whether the per-process GPU usage should be read again now.
+pub fn process_refresh_due(last: Option<Instant>, now: Instant) -> bool {
+    last.is_none_or(|last| now.saturating_duration_since(last) >= PROCESS_REFRESH_MIN_GAP)
+}
+
+/// Whether this refresh reads the per-process GPU usage: when someone shows processes, or when a GPU
+/// needs its processes to compute its own utilization.
+pub fn processes_needed(processes: ProcessUsage, every_gpu_reports_utilization: bool) -> bool {
+    processes == ProcessUsage::Wanted || !every_gpu_reports_utilization
+}
+
+/// Adds one NVTop process entry to the per-PID map, merging it with an earlier entry for the same PID.
+///
+/// NVML lists a process that holds both a graphics and a compute context twice, once per list, and
+/// NVTop gives the utilization sample to the first copy only, setting the other copy to 0%
+/// (`gpuinfo_nvidia_get_process_utilization` in `extract_gpuinfo_nvidia.c`). Both copies carry the
+/// process's whole memory use. So the merged entry keeps the highest value of each field, which never
+/// counts one sample or one allocation twice, and a kind that covers both contexts.
+pub fn insert_process(processes: &mut HashMap<u32, Process>, pid: u32, process: Process) {
+    let Some(existing) = processes.get_mut(&pid) else {
+        processes.insert(pid, process);
+        return;
+    };
+
+    existing.kind = merge_kind(existing.kind, process.kind);
+    existing.memory_usage_bytes = max_of(existing.memory_usage_bytes, process.memory_usage_bytes);
+    existing.gpu_usage_percent = max_of(existing.gpu_usage_percent, process.gpu_usage_percent);
+    existing.encode_usage_percent =
+        max_of(existing.encode_usage_percent, process.encode_usage_percent);
+    existing.decode_usage_percent =
+        max_of(existing.decode_usage_percent, process.decode_usage_percent);
+}
+
+fn max_of<T: PartialOrd>(a: Option<T>, b: Option<T>) -> Option<T> {
+    match (a, b) {
+        (Some(a), Some(b)) => Some(if b > a { b } else { a }),
+        (a, None) => a,
+        (None, b) => b,
+    }
+}
+
+fn merge_kind(a: Option<i32>, b: Option<i32>) -> Option<i32> {
+    let (Some(a), Some(b)) = (a, b) else {
+        return a.or(b);
+    };
+    if a == b {
+        Some(a)
+    } else {
+        Some(ProcessKind::GraphicalCompute as i32)
+    }
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+
+    #[test]
+    fn a_hidden_window_skips_the_per_process_gpu_usage() {
+        assert!(processes_needed(ProcessUsage::Wanted, true));
+        assert!(!processes_needed(ProcessUsage::NotWanted, true));
+    }
+
+    #[test]
+    fn a_gpu_that_needs_its_processes_for_its_utilization_reads_them_anyway() {
+        assert!(processes_needed(ProcessUsage::NotWanted, false));
+    }
+
+    const RE9: u32 = 3216454;
+    const VRAM: u64 = 11_402 << 20;
+
+    fn entry(kind: ProcessKind, gpu: f32) -> Process {
+        Process {
+            kind: Some(kind as i32),
+            memory_usage_bytes: Some(VRAM),
+            gpu_usage_percent: Some(gpu),
+            encode_usage_percent: Some(0.),
+            decode_usage_percent: Some(0.),
+        }
+    }
+
+    // Recorded 2026-11-05 on an RTX 4070 Ti SUPER (nvidia-open 615.78.08): re9.exe was listed by NVML
+    // as graphics (89%) and as compute (0%), both with 11402 MiB.
+    #[test]
+    fn a_process_with_graphics_and_compute_contexts_keeps_its_utilization() {
+        let mut map = HashMap::new();
+        insert_process(&mut map, RE9, entry(ProcessKind::Graphical, 89.));
+        insert_process(&mut map, RE9, entry(ProcessKind::Compute, 0.));
+
+        let merged = &map[&RE9];
+        assert_eq!(merged.gpu_usage_percent, Some(89.));
+        assert_eq!(
+            merged.memory_usage_bytes,
+            Some(VRAM),
+            "memory is counted once"
+        );
+        assert_eq!(merged.kind, Some(ProcessKind::GraphicalCompute as i32));
+    }
+
+    #[test]
+    fn the_order_of_the_two_entries_does_not_matter() {
+        let mut map = HashMap::new();
+        insert_process(&mut map, RE9, entry(ProcessKind::Compute, 0.));
+        insert_process(&mut map, RE9, entry(ProcessKind::Graphical, 89.));
+
+        assert_eq!(map[&RE9].gpu_usage_percent, Some(89.));
+        assert_eq!(map[&RE9].kind, Some(ProcessKind::GraphicalCompute as i32));
+    }
+
+    #[test]
+    fn a_known_value_wins_over_a_missing_one() {
+        let mut map = HashMap::new();
+        let mut unknown = entry(ProcessKind::Graphical, 0.);
+        unknown.gpu_usage_percent = None;
+        unknown.decode_usage_percent = None;
+        insert_process(&mut map, RE9, unknown);
+        let mut decoding = entry(ProcessKind::Compute, 12.);
+        decoding.decode_usage_percent = Some(30.);
+        insert_process(&mut map, RE9, decoding);
+
+        assert_eq!(map[&RE9].gpu_usage_percent, Some(12.));
+        assert_eq!(map[&RE9].decode_usage_percent, Some(30.));
+    }
+
+    #[test]
+    fn the_first_refresh_reads_processes() {
+        assert!(process_refresh_due(None, Instant::now()));
+    }
+
+    #[test]
+    fn a_refresh_on_the_next_tick_reads_processes_again() {
+        let last = Instant::now();
+        assert!(process_refresh_due(
+            Some(last),
+            last + Duration::from_millis(500)
+        ));
+        assert!(process_refresh_due(
+            Some(last),
+            last + Duration::from_secs(1)
+        ));
+    }
+
+    #[test]
+    fn a_second_refresh_within_the_same_tick_keeps_the_last_reading() {
+        let last = Instant::now();
+        assert!(!process_refresh_due(
+            Some(last),
+            last + Duration::from_millis(5)
+        ));
+    }
+
+    #[test]
+    fn different_processes_stay_separate() {
+        let mut map = HashMap::new();
+        insert_process(&mut map, 1, entry(ProcessKind::Graphical, 5.));
+        insert_process(&mut map, 2, entry(ProcessKind::Compute, 7.));
+
+        assert_eq!(map.len(), 2);
+        assert_eq!(map[&1].kind, Some(ProcessKind::Graphical as i32));
+        assert_eq!(map[&2].gpu_usage_percent, Some(7.));
+    }
+}
