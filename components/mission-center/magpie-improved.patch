+
+//! Network use per process from nethogs' trace mode.
+//!
+//! `nethogs -t -v 2 -C` prints, after each "Refreshing:" line, one line per process with traffic:
+//! `<command line>/<pid>/<uid>\t<bytes sent>\t<bytes received>`, totals since nethogs started. The
+//! trace output is plain text, so it is read line by line instead of rendering nethogs' curses screen.
+
+use std::io::{BufRead, BufReader};
+use std::os::unix::process::CommandExt;
+use std::process::{Command, Stdio};
+
+use tokio::sync::mpsc::Sender;
+
+use super::NethogsRecord;
+
+/// Starts nethogs on a thread of its own and sends every record it prints. The sender is dropped
+/// when nethogs cannot start or exits (missing, or without its capture capabilities), which the
+/// process cache reports as a permissions error.
+pub fn spawn(sender: Sender<NethogsRecord>) {
+    let started = std::thread::Builder::new()
+        .name("nethogs".to_owned())
+        .spawn(move || read_nethogs(sender));
+    if let Err(err) = started {
+        log::warn!("Failed to start the nethogs thread: {err}");
+    }
+}
+
+fn read_nethogs(sender: Sender<NethogsRecord>) {
+    let mut command = Command::new("nethogs");
+    command
+        .args(["-t", "-v", "2", "-C"])
+        .stdin(Stdio::null())
+        .stdout(Stdio::piped())
+        .stderr(Stdio::null());
+    // SAFETY: prctl is async-signal-safe and touches no memory of the parent. The child dies with
+    // this thread, which lives as long as magpie reads it.
+    unsafe {
+        command.pre_exec(|| {
+            libc::prctl(libc::PR_SET_PDEATHSIG, libc::SIGTERM);
+            Ok(())
+        });
+    }
+    let mut child = match command.spawn() {
+        Ok(child) => child,
+        Err(err) => {
+            log::warn!("Failed to start nethogs: {err}");
+            return;
+        }
+    };
+    let Some(stdout) = child.stdout.take() else {
+        return;
+    };
+    for line in BufReader::new(stdout).lines() {
+        let Ok(line) = line else {
+            break;
+        };
+        if let Some(record) = parse_trace_line(&line) {
+            if sender.blocking_send(record).is_err() {
+                break;
+            }
+        }
+    }
+    let _ = child.kill();
+    let status = child.wait();
+    log::warn!("nethogs exited: {status:?}");
+}
+
+/// Parses one trace line; `None` for "Refreshing:", connections without a process and other text.
+pub fn parse_trace_line(line: &str) -> Option<NethogsRecord> {
+    let mut fields = line.rsplitn(3, '\t');
+    let received = fields.next()?.trim().parse::<f64>().ok()?;
+    let sent = fields.next()?.trim().parse::<f64>().ok()?;
+    let program = fields.next()?;
+
+    let mut ids = program.rsplitn(3, '/');
+    let _uid = ids.next()?;
+    let pid = ids.next()?.parse::<u32>().ok()?;
+    let name = ids.next()?;
+    if pid == 0 {
+        return None;
+    }
+    Some(NethogsRecord::new(
+        name.to_owned(),
+        pid,
+        String::new(),
+        sent as u64,
+        received as u64,
+    ))
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+
+    // Lines of `nethogs -t -v 2 -C`, nethogs 0.9.0 (CachyOS, 2026-11-05).
+    #[test]
+    fn a_process_line_gives_its_pid_and_byte_totals() {
+        let record = parse_trace_line(
+            "/home/user/.local/share/Steam/ubuntu12_32/steam/1041161/1000\t132\t936",
+        )
+        .expect("a process line parses");
+        assert_eq!(record.pid, 1041161);
+        assert_eq!(record.sent_bytes, 132);
+        assert_eq!(record.recv_bytes, 936);
+    }
+
+    #[test]
+    fn a_command_line_with_spaces_and_slashes_keeps_the_pid_at_its_end() {
+        let line = "/opt/microsoft/msedge/msedge --type=utility --lang=en-US --x=a/b/c/3109594/1000\t66\t2104";
+        let record = parse_trace_line(line).expect("a long command line parses");
+        assert_eq!(record.pid, 3109594);
+        assert_eq!((record.sent_bytes, record.recv_bytes), (66, 2104));
+    }
+
+    #[test]
+    fn connections_without_a_process_and_headers_are_skipped() {
+        assert!(parse_trace_line("unknown TCP/0/0\t0\t0").is_none());
+        assert!(parse_trace_line("Refreshing:").is_none());
+        assert!(
+            parse_trace_line("Unknown connection: 192.168.1.123:51870-140.82.114.5:443").is_none()
+        );
+        assert!(parse_trace_line("").is_none());
+    }
+}
