+
+//! Memory of each process as its proportional set size (PSS), kept exact at a small cost.
+//!
+//! PSS divides every shared page between the processes that map it, so the memory of all processes
+//! adds up to what they really use. The kernel computes it in `/proc/<pid>/smaps_rollup` by walking
+//! the page tables of the process: about 2 ms of CPU per process on average, and up to 37 ms for a
+//! large address space (157 processes, kernel 7.3, 2026-11-05). That is too much to repeat every
+//! second. `/proc/<pid>/status` counts resident pages exactly and cheaply (`get_mm_counter_sum()` in
+//! `fs/proc/task_mmu.c`), but counts shared pages in full.
+//!
+//! So the PSS of a process is read once, then follows the changes of its resident counters, each
+//! scaled by the share the last exact reading measured for its kind of memory. A process is read
+//! again when its counters drifted far enough, and the rereads of one refresh are capped.
+
+use std::collections::{HashMap, HashSet};
+use std::fmt::Write;
+use std::io::Read;
+use std::time::{Duration, Instant};
+
+use arrayvec::{ArrayString, ArrayVec};
+
+use crate::processes::MAX_U32_LEN;
+use crate::util::parse_u64;
+
+/// Smallest drift of the resident counters that makes a process worth reading again.
+const MIN_DRIFT: u64 = 1024 * 1024;
+
+/// A drift of this many hundredths of the last PSS also makes a process worth reading again.
+const DRIFT_PERCENT: u64 = 1;
+
+/// Shortest time between two exact readings of one process.
+const MIN_REREAD_INTERVAL: Duration = Duration::from_secs(10);
+
+/// Longest time a process goes without an exact reading: other processes that start or stop mapping
+/// the same files change its share without changing its counters.
+const RECHECK_INTERVAL: Duration = Duration::from_secs(60);
+
+/// A process is read at most once per this many times the CPU time its last reading took. The kernel
+/// holds the memory map lock of the process while it walks it, so a slow walk is repeated less often.
+const READ_COST_FACTOR: u32 = 1000;
+
+/// CPU time one refresh may spend reading known processes again. New processes are always read.
+const REREAD_BUDGET: Duration = Duration::from_millis(3);
+
+/// A process, told apart from an earlier one with the same PID by its start time.
+type Key = (u32, u64);
+
+/// The resident counters of `/proc/<pid>/status`, in bytes.
+#[derive(Clone, Copy, Debug, Default, PartialEq)]
+pub struct ProcStatus {
+    rss_anon: u64,
+    rss_file: u64,
+    rss_shmem: u64,
+    vm_swap: u64,
+}
+
+impl ProcStatus {
+    fn resident(&self) -> u64 {
+        self.rss_anon + self.rss_file + self.rss_shmem
+    }
+
+    pub fn swap(&self) -> u64 {
+        self.vm_swap
+    }
+}
+
+/// The PSS of each kind of memory, from `/proc/<pid>/smaps_rollup`, in bytes.
+#[derive(Clone, Copy, Debug, Default, PartialEq)]
+pub struct Rollup {
+    pss_anon: u64,
+    pss_file: u64,
+    pss_shmem: u64,
+}
+
+#[derive(Clone, Copy, Debug)]
+struct Reading {
+    rollup: Rollup,
+    /// The resident counters when the rollup was read.
+    status: ProcStatus,
+    read_at: Instant,
+    cost: Duration,
+}
+
+impl Reading {
+    fn pss(&self) -> u64 {
+        self.rollup.pss_anon + self.rollup.pss_file + self.rollup.pss_shmem
+    }
+
+    fn estimate(&self, now: &ProcStatus) -> u64 {
+        let then = &self.status;
+        follow_anon(self.rollup.pss_anon, then.rss_anon, now.rss_anon)
+            + follow(self.rollup.pss_file, then.rss_file, now.rss_file)
+            + follow(self.rollup.pss_shmem, then.rss_shmem, now.rss_shmem)
+    }
+
+    fn drift(&self, now: &ProcStatus) -> u64 {
+        let then = &self.status;
+        then.rss_anon.abs_diff(now.rss_anon)
+            + then.rss_file.abs_diff(now.rss_file)
+            + then.rss_shmem.abs_diff(now.rss_shmem)
+    }
+
+    /// The priority of reading the process again, or `None` when the estimate is still good. The
+    /// priority is the drift of the counters plus, for changes the counters cannot show, the PSS
+    /// prorated by the time since the last reading over [`RECHECK_INTERVAL`].
+    fn reread_priority(&self, now_status: &ProcStatus, now: Instant) -> Option<u64> {
+        let age = now.saturating_duration_since(self.read_at);
+        let cost_floor = self.cost * READ_COST_FACTOR;
+        let drift = self.drift(now_status);
+        let staleness =
+            (self.pss() as f64 * age.as_secs_f64() / RECHECK_INTERVAL.as_secs_f64()) as u64;
+
+        let threshold = MIN_DRIFT.max(self.pss() * DRIFT_PERCENT / 100);
+        let due = age >= RECHECK_INTERVAL.max(cost_floor)
+            || (drift >= threshold && age >= MIN_REREAD_INTERVAL.max(cost_floor));
+        due.then_some(drift + staleness)
+    }
+}
+
+/// Like [`follow`], but new anonymous pages belong to the process alone: an anonymous page is only
+/// shared after a fork, until either side writes to it.
+fn follow_anon(pss: u64, resident_then: u64, resident_now: u64) -> u64 {
+    match resident_now.checked_sub(resident_then) {
+        Some(grown) => pss + grown,
+        None => follow(pss, resident_then, resident_now),
+    }
+}
+
+/// Moves `pss` by the change of a resident counter, scaled by the share measured with `pss`.
+fn follow(pss: u64, resident_then: u64, resident_now: u64) -> u64 {
+    if resident_then == 0 {
+        return pss + resident_now;
+    }
+    let share = pss as f64 / resident_then as f64;
+    let moved = pss as f64 + (resident_now as f64 - resident_then as f64) * share;
+    moved.max(0.0) as u64
+}
+
+/// Exact PSS readings of every process that can be read, and which processes cannot.
+#[derive(Debug, Default)]
+pub struct ProportionalMemory {
+    readings: HashMap<Key, Reading>,
+    unreadable: HashSet<Key>,
+}
+
+impl ProportionalMemory {
+    /// Reads the processes that are new or whose estimate drifted. `processes` holds every live
+    /// process as (PID, start time, status); the others are forgotten.
+    pub fn refresh(&mut self, processes: &[(u32, u64, ProcStatus)], now: Instant) {
+        self.refresh_with(processes, now, |pid| {
+            let started = Instant::now();
+            read_rollup(pid).map(|rollup| (rollup, started.elapsed()))
+        });
+    }
+
+    fn refresh_with(
+        &mut self,
+        processes: &[(u32, u64, ProcStatus)],
+        now: Instant,
+        mut read: impl FnMut(u32) -> std::io::Result<(Rollup, Duration)>,
+    ) {
+        let alive: HashSet<Key> = processes
+            .iter()
+            .map(|(pid, start, _)| (*pid, *start))
+            .collect();
+        self.readings.retain(|key, _| alive.contains(key));
+        self.unreadable.retain(|key| alive.contains(key));
+
+        let mut rereads = Vec::new();
+        for (pid, start, status) in processes {
+            let key = (*pid, *start);
+            if self.unreadable.contains(&key) {
+                continue;
+            }
+            match self.readings.get(&key) {
+                None => {
+                    self.read(key, status, now, &mut read);
+                }
+                Some(reading) => {
+                    if let Some(priority) = reading.reread_priority(status, now) {
+                        rereads.push((priority, key, status));
+                    }
+                }
+            }
+        }
+
+        rereads.sort_unstable_by_key(|(priority, _, _)| std::cmp::Reverse(*priority));
+        let mut spent = Duration::ZERO;
+        for (_, key, status) in rereads {
+            if spent >= REREAD_BUDGET {
+                break;
+            }
+            spent += self.read(key, status, now, &mut read);
+        }
+    }
+
+    fn read(
+        &mut self,
+        key: Key,
+        status: &ProcStatus,
+        now: Instant,
+        read: &mut impl FnMut(u32) -> std::io::Result<(Rollup, Duration)>,
+    ) -> Duration {
+        match read(key.0) {
+            Ok((rollup, cost)) => {
+                self.readings.insert(
+                    key,
+                    Reading {
+                        rollup,
+                        status: *status,
+                        read_at: now,
+                        cost,
+                    },
+                );
+                cost
+            }
+            Err(err) if err.kind() == std::io::ErrorKind::PermissionDenied => {
+                self.readings.remove(&key);
+                self.unreadable.insert(key);
+                Duration::ZERO
+            }
+            // The process exited after its status was read; the next refresh forgets it.
+            Err(err) => {
+                log::debug!(
+                    "Failed to read `smaps_rollup` of process {}: {}",
+                    key.0,
+                    err
+                );
+                Duration::ZERO
+            }
+        }
+    }
+
+    /// The memory of a process: its PSS when it can be read, otherwise its resident set size.
+    pub fn memory(&self, pid: u32, start_time: u64, status: &ProcStatus) -> u64 {
+        match self.readings.get(&(pid, start_time)) {
+            Some(reading) => reading.estimate(status),
+            None => status.resident(),
+        }
+    }
+}
+
+pub fn parse_status(content: &[u8]) -> Option<ProcStatus> {
+    let mut result = ProcStatus::default();
+    for line in content.split(|byte| *byte == b'\n') {
+        if let Some(rest) = line.strip_prefix(b"RssAnon:") {
+            result.rss_anon = parse_kib(rest, "RssAnon")?;
+        } else if let Some(rest) = line.strip_prefix(b"RssFile:") {
+            result.rss_file = parse_kib(rest, "RssFile")?;
+        } else if let Some(rest) = line.strip_prefix(b"RssShmem:") {
+            result.rss_shmem = parse_kib(rest, "RssShmem")?;
+        } else if let Some(rest) = line.strip_prefix(b"VmSwap:") {
+            result.vm_swap = parse_kib(rest, "VmSwap")?;
+        }
+    }
+    Some(result)
+}
+
+fn read_rollup(pid: u32) -> std::io::Result<Rollup> {
+    let mut content = Vec::with_capacity(1024);
+    open_proc_file(pid, "smaps_rollup")?.read_to_end(&mut content)?;
+    parse_rollup(&content)
+        .ok_or_else(|| std::io::Error::new(std::io::ErrorKind::InvalidData, "bad smaps_rollup"))
+}
+
+/// A process without an address space (a kernel thread) has an empty rollup, which reads as zero.
+fn parse_rollup(content: &[u8]) -> Option<Rollup> {
+    let mut result = Rollup::default();
+    for line in content.split(|byte| *byte == b'\n') {
+        if let Some(rest) = line.strip_prefix(b"Pss_Anon:") {
+            result.pss_anon = parse_kib(rest, "Pss_Anon")?;
+        } else if let Some(rest) = line.strip_prefix(b"Pss_File:") {
+            result.pss_file = parse_kib(rest, "Pss_File")?;
+        } else if let Some(rest) = line.strip_prefix(b"Pss_Shmem:") {
+            result.pss_shmem = parse_kib(rest, "Pss_Shmem")?;
+        }
+    }
+    Some(result)
+}
+
+/// Parses the "  1234 kB" value of a `/proc` field into bytes.
+fn parse_kib(value: &[u8], what: &str) -> Option<u64> {
+    let mut c_buf: ArrayVec<u8, 65> = ArrayVec::new();
+    c_buf.extend(value.trim_ascii_start().iter().copied().take(64));
+    c_buf.push(0);
+    Some(parse_u64(c_buf.as_slice(), 10, what)? * 1024)
+}
+
+fn open_proc_file(pid: u32, name: &str) -> std::io::Result<std::fs::File> {
+    const MAX_PATH_LEN: usize = "/proc/".len() + "/smaps_rollup".len() + MAX_U32_LEN;
+
+    let mut path: ArrayString<MAX_PATH_LEN> = ArrayString::new();
+    let _ = write!(path, "/proc/{}/{}", pid, name);
+    std::fs::File::open(path.as_str())
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+
+    const MIB: u64 = 1024 * 1024;
+
+    fn status(anon_mib: u64, file_mib: u64, shmem_mib: u64) -> ProcStatus {
+        ProcStatus {
+            rss_anon: anon_mib * MIB,
+            rss_file: file_mib * MIB,
+            rss_shmem: shmem_mib * MIB,
+            vm_swap: 0,
+        }
+    }
+
+    fn rollup(anon_mib: u64, file_mib: u64, shmem_mib: u64) -> Rollup {
+        Rollup {
+            pss_anon: anon_mib * MIB,
+            pss_file: file_mib * MIB,
+            pss_shmem: shmem_mib * MIB,
+        }
+    }
+
+    fn fast(r: Rollup) -> std::io::Result<(Rollup, Duration)> {
+        Ok((r, Duration::from_micros(500)))
+    }
+
+    #[test]
+    fn a_new_process_shows_its_exact_pss_on_its_first_refresh() {
+        let mut memory = ProportionalMemory::default();
+        let now = Instant::now();
+        memory.refresh_with(&[(7, 1, status(100, 40, 8))], now, |_| {
+            fast(rollup(90, 10, 2))
+        });
+
+        assert_eq!(memory.memory(7, 1, &status(100, 40, 8)), 102 * MIB);
+    }
+
+    #[test]
+    fn between_readings_memory_follows_the_counters_at_the_measured_share() {
+        let mut memory = ProportionalMemory::default();
+        let now = Instant::now();
+        // Anonymous memory is all private, file memory is shared by four processes.
+        memory.refresh_with(&[(7, 1, status(100, 40, 0))], now, |_| {
+            fast(rollup(100, 10, 0))
+        });
+
+        // 20 MiB more anonymous memory counts in full, 8 MiB more file memory counts a quarter.
+        assert_eq!(memory.memory(7, 1, &status(120, 48, 0)), 132 * MIB);
+        // Memory that starts from nothing has no measured share yet and counts in full.
+        assert_eq!(memory.memory(7, 1, &status(100, 40, 3)), 113 * MIB);
+    }
+
+    #[test]
+    fn new_anonymous_memory_of_a_forked_process_counts_in_full() {
+        let mut memory = ProportionalMemory::default();
+        let now = Instant::now();
+        // Half of the anonymous memory is still shared with the parent after a fork.
+        memory.refresh_with(&[(7, 1, status(100, 0, 0))], now, |_| {
+            fast(rollup(50, 0, 0))
+        });
+
+        assert_eq!(memory.memory(7, 1, &status(120, 0, 0)), 70 * MIB);
+        // Freed pages were shared in the measured proportion.
+        assert_eq!(memory.memory(7, 1, &status(80, 0, 0)), 40 * MIB);
+    }
+
+    #[test]
+    fn a_drifted_process_is_read_again_after_the_reread_interval() {
+        let mut memory = ProportionalMemory::default();
+        let start = Instant::now();
+        memory.refresh_with(&[(7, 1, status(100, 0, 0))], start, |_| {
+            fast(rollup(100, 0, 0))
+        });
+
+        let mut reads = 0;
+        let grown = [(7, 1, status(150, 0, 0))];
+        memory.refresh_with(&grown, start + Duration::from_secs(1), |_| {
+            reads += 1;
+            fast(rollup(140, 0, 0))
+        });
+        assert_eq!(reads, 0, "too soon after the last reading");
+
+        memory.refresh_with(&grown, start + MIN_REREAD_INTERVAL, |_| {
+            reads += 1;
+            fast(rollup(140, 0, 0))
+        });
+        assert_eq!(reads, 1);
+        assert_eq!(memory.memory(7, 1, &status(150, 0, 0)), 140 * MIB);
+    }
+
+    #[test]
+    fn a_process_whose_counters_barely_moved_waits_for_the_recheck() {
+        let mut memory = ProportionalMemory::default();
+        let start = Instant::now();
+        memory.refresh_with(&[(7, 1, status(500, 0, 0))], start, |_| {
+            fast(rollup(500, 0, 0))
+        });
+
+        // 4 MiB is below 1% of 500 MiB.
+        let barely = [(7, 1, status(504, 0, 0))];
+        let mut reads = 0;
+        memory.refresh_with(&barely, start + MIN_REREAD_INTERVAL, |_| {
+            reads += 1;
+            fast(rollup(504, 0, 0))
+        });
+        assert_eq!(reads, 0);
+
+        memory.refresh_with(&barely, start + RECHECK_INTERVAL, |_| {
+            reads += 1;
+            fast(rollup(504, 0, 0))
+        });
+        assert_eq!(reads, 1);
+    }
+
+    #[test]
+    fn a_process_that_is_slow_to_read_is_read_less_often() {
+        let mut memory = ProportionalMemory::default();
+        let start = Instant::now();
+        memory.refresh_with(&[(7, 1, status(100, 0, 0))], start, |_| {
+            Ok((rollup(100, 0, 0), Duration::from_millis(40)))
+        });
+
+        let grown = [(7, 1, status(300, 0, 0))];
+        let mut reads = 0;
+        memory.refresh_with(&grown, start + MIN_REREAD_INTERVAL, |_| {
+            reads += 1;
+            fast(rollup(300, 0, 0))
+        });
+        assert_eq!(reads, 0, "40 ms of reading allows one reading per 40 s");
+
+        memory.refresh_with(&grown, start + Duration::from_secs(40), |_| {
+            reads += 1;
+            fast(rollup(300, 0, 0))
+        });
+        assert_eq!(reads, 1);
+    }
+
+    #[test]
+    fn one_refresh_rereads_within_its_budget_the_largest_drift_first() {
+        let mut memory = ProportionalMemory::default();
+        let start = Instant::now();
+        let pids: Vec<u32> = (1..=6).collect();
+        let first: Vec<_> = pids.iter().map(|pid| (*pid, 0, status(10, 0, 0))).collect();
+        memory.refresh_with(&first, start, |_| fast(rollup(10, 0, 0)));
+
+        // Process N grew by N MiB.
+        let grown: Vec<_> = pids
+            .iter()
+            .map(|pid| (*pid, 0, status(10 + u64::from(*pid), 0, 0)))
+            .collect();
+        // Each reading takes 1 ms, so the budget allows three.
+        let mut read = Vec::new();
+        memory.refresh_with(&grown, start + MIN_REREAD_INTERVAL, |pid| {
+            read.push(pid);
+            Ok((rollup(10, 0, 0), Duration::from_millis(1)))
+        });
+        read.sort_unstable();
+        assert_eq!(read, vec![4, 5, 6]);
+    }
+
+    #[test]
+    fn a_process_of_another_user_shows_its_resident_memory_and_is_not_retried() {
+        let mut memory = ProportionalMemory::default();
+        let start = Instant::now();
+        let denied = || Err(std::io::Error::from(std::io::ErrorKind::PermissionDenied));
+        memory.refresh_with(&[(7, 1, status(10, 20, 1))], start, |_| denied());
+
+        assert_eq!(memory.memory(7, 1, &status(10, 20, 1)), 31 * MIB);
+
+        let mut reads = 0;
+        memory.refresh_with(
+            &[(7, 1, status(50, 20, 1))],
+            start + RECHECK_INTERVAL,
+            |_| {
+                reads += 1;
+                denied()
+            },
+        );
+        assert_eq!(reads, 0);
+    }
+
+    #[test]
+    fn a_reused_pid_is_read_as_a_new_process() {
+        let mut memory = ProportionalMemory::default();
+        let start = Instant::now();
+        memory.refresh_with(&[(7, 1, status(100, 0, 0))], start, |_| {
+            fast(rollup(100, 0, 0))
+        });
+        memory.refresh_with(
+            &[(7, 2, status(5, 0, 0))],
+            start + Duration::from_secs(1),
+            |_| fast(rollup(4, 0, 0)),
+        );
+
+        assert_eq!(memory.memory(7, 2, &status(5, 0, 0)), 4 * MIB);
+        assert_eq!(memory.readings.len(), 1, "the exited process is forgotten");
+    }
+
+    // A real /proc/<pid>/smaps_rollup (CachyOS, kernel 7.3, 2026-11-05).
+    #[test]
+    fn rollup_fields_are_read_in_bytes() {
+        let content = b"557366de5000-7ffc44245000 ---p 00000000 00:00 0      [rollup]\n\
+Rss:                2504 kB\nPss:                 253 kB\nPss_Dirty:           120 kB\n\
+Pss_Anon:            120 kB\nPss_File:            133 kB\nPss_Shmem:             0 kB\n\
+Shared_Clean:       2364 kB\nPrivate_Dirty:       120 kB\nSwapPss:               0 kB\n";
+        assert_eq!(
+            parse_rollup(content),
+            Some(Rollup {
+                pss_anon: 120 * 1024,
+                pss_file: 133 * 1024,
+                pss_shmem: 0,
+            })
+        );
+        assert_eq!(parse_rollup(b""), Some(Rollup::default()));
+    }
+
+    // Lines of a real /proc/<pid>/status (CachyOS, kernel 7.3, 2026-11-05).
+    #[test]
+    fn status_fields_are_read_in_bytes() {
+        let status = b"Name:\tbash\nVmPeak:\t   10000 kB\nVmSize:\t    9312 kB\nVmRSS:\t    5400 kB\n\
+RssAnon:\t    1820 kB\nRssFile:\t    3580 kB\nRssShmem:\t       0 kB\nVmSwap:\t      12 kB\nThreads:\t1\n";
+        let parsed = parse_status(status).expect("a valid status file parses");
+        assert_eq!(
+            parsed,
+            ProcStatus {
+                rss_anon: 1820 * 1024,
+                rss_file: 3580 * 1024,
+                rss_shmem: 0,
+                vm_swap: 12 * 1024,
+            }
+        );
+    }
+}
