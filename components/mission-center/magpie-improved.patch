+//! Files of `/proc/<pid>` kept open from one refresh to the next.
+//!
+//! Opening a `/proc` file resolves the path and sets up a file each time, which was half the cost of
+//! reading `stat`, `io` and `status` for every process (9.8 ms against 4.8 ms for 625 processes). A
+//! read at offset 0 makes the kernel generate the content again, so one open per process lifetime
+//! is enough. A file opened for a process that exited answers `ESRCH`, also after its PID was reused,
+//! so a failed read closes the file and opens the path once more.
+
+use std::collections::HashMap;
+use std::fmt::Write;
+use std::fs::File;
+use std::os::unix::fs::FileExt;
+
+use arrayvec::ArrayString;
+
+use crate::processes::MAX_U32_LEN;
+
+/// File descriptors kept free for everything else magpie opens.
+const RESERVED_DESCRIPTORS: usize = 256;
+
+#[derive(Clone, Copy, Debug, PartialEq, Eq)]
+pub enum ProcFile {
+    Stat,
+    Io,
+    Status,
+}
+
+impl ProcFile {
+    const COUNT: usize = 3;
+
+    fn name(self) -> &'static str {
+        match self {
+            ProcFile::Stat => "stat",
+            ProcFile::Io => "io",
+            ProcFile::Status => "status",
+        }
+    }
+}
+
+#[derive(Debug)]
+pub struct OpenFiles {
+    files: HashMap<u32, [Option<File>; ProcFile::COUNT]>,
+    open: usize,
+    max_open: usize,
+}
+
+impl Default for OpenFiles {
+    fn default() -> Self {
+        Self::new(descriptor_budget())
+    }
+}
+
+impl OpenFiles {
+    fn new(max_open: usize) -> Self {
+        Self {
+            files: HashMap::new(),
+            open: 0,
+            max_open,
+        }
+    }
+
+    /// Reads `kind` of `pid` into `buf`. Returns false when the process is gone or the file cannot be
+    /// read (another user's `io`, for instance).
+    pub fn read(&mut self, pid: u32, kind: ProcFile, buf: &mut Vec<u8>) -> bool {
+        self.read_with(pid, kind, buf, open)
+    }
+
+    fn read_with(
+        &mut self,
+        pid: u32,
+        kind: ProcFile,
+        buf: &mut Vec<u8>,
+        open: impl Fn(u32, ProcFile) -> std::io::Result<File>,
+    ) -> bool {
+        let slots = self.files.entry(pid).or_default();
+        let slot = &mut slots[kind as usize];
+        if let Some(file) = slot {
+            if read_whole(file, buf) {
+                return true;
+            }
+            *slot = None;
+            self.open -= 1;
+        }
+
+        let Ok(file) = open(pid, kind) else {
+            return false;
+        };
+        if !read_whole(&file, buf) {
+            return false;
+        }
+        if self.open < self.max_open {
+            *slot = Some(file);
+            self.open += 1;
+        }
+        true
+    }
+
+    /// Closes the files of the processes for which `alive` is false.
+    pub fn retain(&mut self, mut alive: impl FnMut(u32) -> bool) {
+        let open = &mut self.open;
+        self.files.retain(|pid, slots| {
+            let keep = alive(*pid);
+            if !keep {
+                *open -= slots.iter().filter(|slot| slot.is_some()).count();
+            }
+            keep
+        });
+    }
+}
+
+/// Reads the whole file from offset 0; false on an error or an empty file.
+fn read_whole(file: &File, buf: &mut Vec<u8>) -> bool {
+    const CHUNK: usize = 4096;
+
+    buf.clear();
+    loop {
+        let start = buf.len();
+        buf.resize(start + CHUNK, 0);
+        match file.read_at(&mut buf[start..], start as u64) {
+            Ok(0) => {
+                buf.truncate(start);
+                return start > 0;
+            }
+            Ok(read) => buf.truncate(start + read),
+            Err(_) => {
+                buf.clear();
+                return false;
+            }
+        }
+    }
+}
+
+fn open(pid: u32, kind: ProcFile) -> std::io::Result<File> {
+    const MAX_PATH_LEN: usize = "/proc/".len() + "/status".len() + MAX_U32_LEN;
+
+    let mut path: ArrayString<MAX_PATH_LEN> = ArrayString::new();
+    let _ = write!(path, "/proc/{}/{}", pid, kind.name());
+    File::open(path.as_str())
+}
+
+/// How many files may stay open: the soft descriptor limit, which magpie raises at start, minus a
+/// reserve for everything else.
+fn descriptor_budget() -> usize {
+    let mut limit = libc::rlimit {
+        rlim_cur: 0,
+        rlim_max: 0,
+    };
+    // SAFETY: `limit` is a valid, writable rlimit and RLIMIT_NOFILE is a valid resource.
+    if unsafe { libc::getrlimit(libc::RLIMIT_NOFILE, &mut limit) } != 0 {
+        return 0;
+    }
+    (limit.rlim_cur as usize).saturating_sub(RESERVED_DESCRIPTORS)
+}
+
+#[cfg(test)]
+mod tests {
+    use std::cell::Cell;
+    use std::process::{Command, Stdio};
+
+    use super::*;
+
+    fn counting_open(opens: &Cell<u32>) -> impl Fn(u32, ProcFile) -> std::io::Result<File> + '_ {
+        move |pid, kind| {
+            opens.set(opens.get() + 1);
+            open(pid, kind)
+        }
+    }
+
+    #[test]
+    fn a_file_is_opened_once_and_read_again_on_every_refresh() {
+        let mut files = OpenFiles::new(16);
+        let opens = Cell::new(0);
+        let mut buf = Vec::new();
+        let pid = std::process::id();
+
+        for _ in 0..3 {
+            assert!(files.read_with(pid, ProcFile::Status, &mut buf, counting_open(&opens)));
+            assert!(buf.starts_with(b"Name:"), "a whole status file is read");
+        }
+        assert_eq!(opens.get(), 1);
+    }
+
+    #[test]
+    fn the_file_of_an_exited_process_is_closed() {
+        let mut child = Command::new("sleep")
+            .arg("30")
+            .stdout(Stdio::null())
+            .spawn()
+            .expect("start a child process");
+        let pid = child.id();
+        let mut files = OpenFiles::new(16);
+        let mut buf = Vec::new();
+        assert!(files.read(pid, ProcFile::Stat, &mut buf));
+        assert_eq!(files.open, 1);
+
+        child.kill().expect("stop the child process");
+        child.wait().expect("reap the child process");
+
+        assert!(!files.read(pid, ProcFile::Stat, &mut buf));
+        assert_eq!(files.open, 0, "the stale file is closed");
+    }
+
+    #[test]
+    fn files_beyond_the_budget_are_read_without_being_kept() {
+        let mut files = OpenFiles::new(1);
+        let opens = Cell::new(0);
+        let mut buf = Vec::new();
+        let pid = std::process::id();
+
+        for _ in 0..3 {
+            assert!(files.read_with(pid, ProcFile::Stat, &mut buf, counting_open(&opens)));
+            assert!(files.read_with(pid, ProcFile::Status, &mut buf, counting_open(&opens)));
+        }
+        assert_eq!(
+            opens.get(),
+            1 + 3,
+            "stat stays open, status is opened on every read"
+        );
+    }
+
+    #[test]
+    fn processes_that_are_gone_give_back_their_files() {
+        let mut files = OpenFiles::new(16);
+        let mut buf = Vec::new();
+        let pid = std::process::id();
+        assert!(files.read(pid, ProcFile::Stat, &mut buf));
+        assert!(files.read(pid, ProcFile::Status, &mut buf));
+
+        files.retain(|alive| alive != pid);
+        assert_eq!(files.open, 0);
+        assert!(files.files.is_empty());
+    }
+}
