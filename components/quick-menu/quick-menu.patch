diff -ruN -x '*.qsb' a/qml/QuickMenuGlass.qml b/qml/QuickMenuGlass.qml
--- a/qml/QuickMenuGlass.qml	1969-12-31 19:00:00.000000000 -0500
+++ b/qml/QuickMenuGlass.qml	2026-11-04 22:56:30.594648380 -0500
@@ -0,0 +1,37 @@
+/*
+    SPDX-FileCopyrightText: 2026 xt0n1-t3ch
+    SPDX-License-Identifier: GPL-2.0-or-later
+*/
+// Quick Menu's Liquid Glass, the material of the Control Center and the notification banners (glass.frag): frosted by
+// KWin behind its rounded shape (the BlurBehind in RunCommand.qml finds it through glassBlur), tinted, with a rim
+// lit from above and a soft shadow drawn into the window's transparent margin.
+import QtQuick
+
+Item {
+    id: glass
+
+    property real radius: 26
+    property real shadowSize: 18
+    readonly property bool glassBlur: true
+
+    ShaderEffect {
+        readonly property real pad: Math.ceil(glass.shadowSize * 1.6)
+        z: -1
+        x: -pad
+        y: -pad
+        width: glass.width + 2 * pad
+        height: glass.height + 2 * pad
+        property size boxSize: Qt.size(glass.width, glass.height)
+        property real radius: glass.radius
+        // Between the Control Center's clear modules and the banners' dense glass (0.78): Quick Menu floats over
+        // whatever is open, white pages included, and its white text has to stay readable there.
+        property vector4d tint: Qt.vector4d(0.12, 0.12, 0.14, 0.74)
+        property vector4d rimLight: Qt.vector4d(1, 1, 1, 0.5)
+        property vector4d rimShade: Qt.vector4d(1, 1, 1, 0.08)
+        property real rimWidth: 1.0
+        property real sheen: 0.05
+        property real shadowAlpha: 0.32
+        property real shadowSize: glass.shadowSize
+        fragmentShader: Qt.resolvedUrl("shaders/glass.frag.qsb")
+    }
+}
diff -ruN -x '*.qsb' a/qml/quickmenu.js b/qml/quickmenu.js
--- a/qml/quickmenu.js	1969-12-31 19:00:00.000000000 -0500
+++ b/qml/quickmenu.js	2026-11-04 22:57:08.778412588 -0500
@@ -0,0 +1,303 @@
+/*
+    SPDX-FileCopyrightText: 2026 xt0n1-t3ch
+    SPDX-License-Identifier: GPL-2.0-or-later
+*/
+// Quick Menu's Applications view as macOS Tahoe draws it: Suggestions first, then the apps by section, one row of
+// each until "Show More". The catalog is Plasma's own menu (Kicker's RootModel); a menu category is keyed by its
+// icon from /usr/share/desktop-directories, which does not change with the language.
+.pragma library
+
+// Plasma menu category icon (without "-symbolic") -> the Tahoe section it joins.
+const SECTION_OF = {
+    "applications-office": "Productivity & Finance",
+    "applications-graphics": "Creativity",
+    "applications-internet": "Internet",
+    "applications-multimedia": "Entertainment",
+    "applications-games": "Games",
+    "applications-development": "Developer Tools",
+    "applications-education": "Education",
+    "applications-science": "Education",
+    "applications-system": "Utilities",
+    "applications-utilities": "Utilities",
+    "preferences-system": "Utilities",
+    "help-about": "Utilities",
+    "applications-other": "Other",
+};
+// Tahoe's own order; a menu of its own (a "Wine" folder) keeps its name and comes just before Other.
+const ORDER = ["Productivity & Finance", "Creativity", "Internet", "Entertainment", "Games", "Developer Tools",
+               "Education", "Utilities"];
+const LAST = "Other";
+
+function sectionTitle(icon, name) {
+    return SECTION_OF[String(icon).replace(/-symbolic$/, "")] || name;
+}
+
+function rank(title) {
+    const known = ORDER.indexOf(title);
+    if (known >= 0) {
+        return [0, known, ""];
+    }
+    return title === LAST ? [2, 0, ""] : [1, 0, title.toLocaleLowerCase()];
+}
+
+function compareRanks(a, b) {
+    for (let i = 0; i < a.length; ++i) {
+        if (a[i] !== b[i]) {
+            return a[i] < b[i] ? -1 : 1;
+        }
+    }
+    return 0;
+}
+
+// order: the app ids of a section in the order the user dragged them into. Apps it names come first, in that
+// order; apps it does not name (installed since) follow in their own order; ids of apps that are gone are skipped.
+function applyOrder(apps, order) {
+    if (!order || order.length === 0) {
+        return apps;
+    }
+    const position = new Map(order.map((id, i) => [id, i]));
+    const named = apps.filter(entry => position.has(entry.id)).sort((a, b) => position.get(a.id) - position.get(b.id));
+    return named.concat(apps.filter(entry => !position.has(entry.id)));
+}
+
+// ids with the one at `from` moved to `to`, the place of the app it was dropped on; a move outside the list or onto
+// itself changes nothing.
+function reorder(ids, from, to) {
+    if (from === to || from < 0 || to < 0 || from >= ids.length || to >= ids.length) {
+        return ids.slice();
+    }
+    const next = ids.slice();
+    const moved = next.splice(from, 1)[0];
+    next.splice(to, 0, moved);
+    return next;
+}
+
+// categories: [{icon, name, apps: [{id, name, ...}]}] -> [{title, apps, reorderable}], merged, without duplicates,
+// alphabetical unless `orders` ({section title: [app ids]}) holds an order the user dragged the apps into.
+function buildSections(categories, orders) {
+    const byTitle = new Map();
+    for (const category of categories) {
+        const title = sectionTitle(category.icon, category.name);
+        let section = byTitle.get(title);
+        if (!section) {
+            section = {title: title, apps: [], ids: new Set()};
+            byTitle.set(title, section);
+        }
+        for (const entry of category.apps) {
+            if (!section.ids.has(entry.id)) {
+                section.ids.add(entry.id);
+                section.apps.push(entry);
+            }
+        }
+    }
+    const sections = [...byTitle.values()].filter(section => section.apps.length > 0);
+    for (const section of sections) {
+        section.apps.sort((a, b) => a.name.localeCompare(b.name, undefined, {sensitivity: "base"}));
+        section.apps = applyOrder(section.apps, (orders || {})[section.title]);
+        section.reorderable = true;
+        delete section.ids;
+    }
+    return sections.sort((a, b) => compareRanks(rank(a.title), rank(b.title)));
+}
+
+// The apps pinned with "Pin to Top", in pin order, as the first section of Quick Menu; null when none of them is
+// installed. Like Windows' pinned apps, they stay there whatever their category or how often they are used.
+function pinnedSection(categories, pins) {
+    const byId = new Map();
+    for (const category of categories) {
+        for (const entry of category.apps) {
+            if (!byId.has(entry.id)) {
+                byId.set(entry.id, entry);
+            }
+        }
+    }
+    const apps = (pins || []).filter(id => byId.has(id)).map(id => byId.get(id));
+    return apps.length > 0 ? {title: "Pinned", apps: apps, pinned: true, reorderable: true} : null;
+}
+
+// The pin list with `id` pinned at the end, or unpinned when it was there.
+function togglePin(pins, id) {
+    return pins.indexOf(id) >= 0 ? pins.filter(pin => pin !== id) : pins.concat([id]);
+}
+
+// Plasma's actions that Aurora leaves out: its pins (Kicker only offers them inside a panel widget) and Kicker's
+// forget actions, which "Remove from Suggestions" replaces; "Forget All Applications" would empty Suggestions from
+// one app's menu.
+const REPLACED_ACTIONS = ["addToTaskManager", "addToDesktop", "addToPanel", "hideApplication", "forget", "forgetAll"];
+
+// Symbolic icons for Plasma's own actions, by action id; any other action gets its icon's symbolic version.
+const ACTION_ICONS = {editApplication: "document-edit-symbolic", manageApplication: "edit-delete-symbolic"};
+// The icon shown when an action's own symbolic icon does not exist, by action id.
+const FALLBACK_ICONS = {
+    _kicker_jumpListAction: "window-new-symbolic",
+    _kicker_recentDocument: "text-x-generic-symbolic",
+};
+
+// The right-click menu of an app, top to bottom. `app` says whether the app is in Suggestions, pinned and in the
+// Dock, and holds Plasma's actions for it (Kicker's ActionListRole: jump list items, Edit Application, Uninstall).
+// Each item is {label, icon, fallback, action}, {title: true, label} for a heading such as Kicker's "Recent Files", or
+// {separator: true}; icons are symbolic, as in macOS Tahoe's menus, and there is never a separator at an end or two
+// in a row.
+function menuItems(app) {
+    const plasma = (app.actions || []).filter(action => REPLACED_ACTIONS.indexOf(action.actionId) < 0);
+    const isJump = action => action.actionId === "_kicker_jumpListAction";
+    const entry = (label, icon, action, fallback) =>
+        ({label: label, icon: icon, fallback: fallback || "", action: action});
+    const plasmaItem = action => {
+        if (action.type === "separator") {
+            return {separator: true};
+        }
+        if (action.type === "title") {
+            return {title: true, label: action.text};
+        }
+        const icon = ACTION_ICONS[action.actionId] || (action.icon ? action.icon + "-symbolic" : "");
+        return entry(action.text, icon, {kind: "plasma", action: action}, FALLBACK_ICONS[action.actionId]);
+    };
+    const items = [entry("Open", "external-link-symbolic", {kind: "open"})];
+    plasma.filter(action => action.type !== "separator" && isJump(action))
+        .forEach(action => items.push(plasmaItem(action)));
+    items.push({separator: true});
+    items.push(app.pinned ? entry("Unpin from Top", "window-unpin-symbolic", {kind: "pin"})
+                          : entry("Pin to Top", "view-pin-symbolic", {kind: "pin"}));
+    items.push(entry(app.inDock ? "Unpin from Dock" : "Pin to Dock", "dock-symbolic", {kind: "dock"}));
+    if (app.suggested) {
+        items.push(entry("Remove from Suggestions", "view-hidden-symbolic", {kind: "forget"}));
+    }
+    items.push({separator: true});
+    plasma.filter(action => !isJump(action)).forEach(action => items.push(plasmaItem(action)));
+    return items.filter((item, i, all) => !item.separator
+                        || (i > 0 && !all[i - 1].separator && all.slice(i + 1).some(next => !next.separator)));
+}
+
+// The Dock's launchers, from the shell's answer to the reading script (several Docks are separated by "|").
+function launchers(text) {
+    return String(text || "").split(/[|,]/).map(part => part.trim()).filter(part => part.length > 0);
+}
+
+// The Plasma script that pins `id` to every Dock (at its end) or unpins it, for org.kde.PlasmaShell.evaluateScript.
+// Empty when `id` is not a desktop file id, so nothing but a launcher name can reach the script.
+function dockScript(id, pin) {
+    if (!/^applications:[A-Za-z0-9._+-]+\.desktop$/.test(id)) {
+        return "";
+    }
+    return "var id = '" + id + "'; var changed = 0;\n"
+        + "panels().forEach(function (p) { p.widgets('org.kde.plasma.icontasks').forEach(function (w) {\n"
+        + "  w.currentConfigGroup = ['General'];\n"
+        + "  var list = String(w.readConfig('launchers', '')).split(',')\n"
+        + "      .filter(function (l) { return l.length > 0 && l !== id; });\n"
+        + (pin ? "  list.push(id);\n" : "")
+        + "  w.writeConfig('launchers', list.join(',')); changed++; }); });\n"
+        + "print(changed);";
+}
+
+// The Plasma script that prints every Dock's launchers, for launchers().
+function dockReadScript() {
+    return "var out = []; panels().forEach(function (p) { p.widgets('org.kde.plasma.icontasks').forEach(function (w) {"
+        + " w.currentConfigGroup = ['General']; out.push(String(w.readConfig('launchers', ''))); }); });"
+        + " print(out.join('|'));";
+}
+
+function visibleApps(section, expanded, columns) {
+    return expanded ? section.apps : section.apps.slice(0, columns);
+}
+
+function canExpand(section, columns) {
+    return section.apps.length > columns;
+}
+
+// counts: how many apps each section shows; current: {section, index} or null for the search field.
+// Left and right walk the apps in reading order across sections; up and down keep the column, landing on the
+// nearest app of a shorter row. Up from the first row leaves the grid (null); the edges otherwise hold.
+function move(counts, current, key, columns) {
+    const sections = counts.map((count, section) => ({section: section, count: count})).filter(s => s.count > 0);
+    if (sections.length === 0) {
+        return null;
+    }
+    if (!current) {
+        return key === "down" || key === "right" ? {section: sections[0].section, index: 0} : null;
+    }
+    const at = sections.findIndex(s => s.section === current.section);
+    const here = sections[at];
+    const column = current.index % columns;
+    const row = Math.floor(current.index / columns);
+    const lastRow = Math.floor((here.count - 1) / columns);
+    const clamp = (s, r) => ({section: s.section, index: Math.min(r * columns + column, s.count - 1)});
+
+    if (key === "right") {
+        if (current.index + 1 < here.count) {
+            return {section: here.section, index: current.index + 1};
+        }
+        return at + 1 < sections.length ? {section: sections[at + 1].section, index: 0} : current;
+    }
+    if (key === "left") {
+        if (current.index > 0) {
+            return {section: here.section, index: current.index - 1};
+        }
+        return at > 0 ? {section: sections[at - 1].section, index: sections[at - 1].count - 1} : current;
+    }
+    if (key === "down") {
+        if (row < lastRow) {
+            return clamp(here, row + 1);
+        }
+        return at + 1 < sections.length ? clamp(sections[at + 1], 0) : current;
+    }
+    if (key === "up") {
+        if (row > 0) {
+            return clamp(here, row - 1);
+        }
+        if (at === 0) {
+            return null;
+        }
+        const previous = sections[at - 1];
+        return clamp(previous, Math.floor((previous.count - 1) / columns));
+    }
+    return current;
+}
+
+// The power rail's menus (QuickMenuRail.qml), from what Plasma's session manager allows (its can* properties). Items have
+// the menu's {label, icon, fallback, action} form; the action names the entry for runSessionAction().
+function accountItems(can) {
+    const items = [];
+    if (can.canLock) {
+        items.push({label: "Lock", icon: "system-lock-screen-symbolic", fallback: "system-lock-screen", action: "lock"});
+    }
+    if (can.canSwitchUser) {
+        items.push({label: "Switch User", icon: "system-switch-user-symbolic", fallback: "system-switch-user", action: "switch-user"});
+    }
+    if (can.canLogout) {
+        items.push({label: "Log Out", icon: "system-log-out-symbolic", fallback: "system-log-out", action: "log-out"});
+    }
+    return items;
+}
+
+function powerItems(can) {
+    const items = [];
+    if (can.canSuspend) {
+        items.push({label: "Sleep", icon: "system-suspend-symbolic", fallback: "system-suspend", action: "sleep"});
+    }
+    if (can.canHibernate) {
+        items.push({label: "Hibernate", icon: "system-suspend-hibernate-symbolic", fallback: "system-suspend-hibernate", action: "hibernate"});
+    }
+    if (can.canReboot) {
+        items.push({label: "Restart", icon: "system-reboot-symbolic", fallback: "system-reboot", action: "restart"});
+    }
+    if (can.canShutdown) {
+        items.push({label: "Shut Down", icon: "system-shutdown-symbolic", fallback: "system-shutdown", action: "shut-down"});
+    }
+    return items;
+}
+
+// The session manager's method for each entry. Log Out, Restart and Shut Down go through Plasma's own prompt when the
+// user keeps it on (System Settings > Session > Desktop Session).
+const SESSION_METHODS = {"lock": "lock", "switch-user": "switchUser", "log-out": "requestLogout", "sleep": "suspend",
+                         "hibernate": "hibernate", "restart": "requestReboot", "shut-down": "requestShutdown"};
+
+// Calls `action`'s method on `session`; false, calling nothing, for an action it does not know.
+function runSessionAction(session, action) {
+    const method = SESSION_METHODS[action];
+    if (!method) {
+        return false;
+    }
+    session[method]();
+    return true;
+}
diff -ruN -x '*.qsb' a/qml/QuickMenuPopup.qml b/qml/QuickMenuPopup.qml
--- a/qml/QuickMenuPopup.qml	1969-12-31 19:00:00.000000000 -0500
+++ b/qml/QuickMenuPopup.qml	2026-11-04 22:56:30.596012463 -0500
@@ -0,0 +1,220 @@
+/*
+    SPDX-FileCopyrightText: 2026 xt0n1-t3ch
+    SPDX-License-Identifier: GPL-2.0-or-later
+*/
+// The menu an app of the Applications view opens on a right-click or the Menu key, drawn like macOS Tahoe's context
+// menus: rounded dark glass with a soft shadow, a symbolic icon before each entry, the accent color under the
+// pointer. It lists the items quickmenu.js's menuItems() builds. The arrow keys move through it, Return chooses,
+// Escape or a click elsewhere closes it.
+import QtQuick
+import QtQuick.Controls as QQC2
+import org.kde.kirigami as Kirigami
+
+QQC2.Popup {
+    id: menu
+
+    // Each item is {label, icon, fallback, action}, {title: true, label} or {separator: true}.
+    property var items: []
+    // The app the menu is for, passed back with the chosen action.
+    property var entry: null
+    // The highlighted item, or -1.
+    property int currentIndex: -1
+
+    readonly property int rowHeight: Math.round(Kirigami.Units.gridUnit * 1.4)
+    readonly property int titleHeight: Math.round(Kirigami.Units.gridUnit * 1.2)
+    readonly property int separatorHeight: Kirigami.Units.smallSpacing * 2 + 1
+    readonly property int iconSize: Kirigami.Units.iconSizes.small
+    // Space between the row's edge and its icon, and between the icon and the label.
+    readonly property int rowPadding: Kirigami.Units.mediumSpacing + Kirigami.Units.smallSpacing
+    readonly property int iconGap: Kirigami.Units.mediumSpacing + Kirigami.Units.smallSpacing
+    readonly property TextMetrics metrics: TextMetrics {
+        font: Kirigami.Theme.defaultFont
+    }
+
+    signal chosen(var entry, var action)
+
+    padding: Kirigami.Units.smallSpacing + 1
+    // Qt keeps the menu inside the window by this much, should the placement below not manage it.
+    margins: Kirigami.Units.smallSpacing
+    focus: true
+    modal: false
+    closePolicy: QQC2.Popup.CloseOnEscape | QQC2.Popup.CloseOnPressOutside
+
+    // The menu's size for `list`, known before it opens, so openAt() can place it.
+    function measure(list) {
+        let widest = 0
+        let height = 0
+        for (const item of list) {
+            if (item.separator) {
+                height += separatorHeight
+                continue
+            }
+            metrics.text = item.label
+            widest = Math.max(widest, metrics.advanceWidth)
+            height += item.title ? titleHeight : rowHeight
+        }
+        const width = Math.max(Kirigami.Units.gridUnit * 9, Math.ceil(widest) + iconSize + iconGap + rowPadding * 2)
+        return Qt.size(width + leftPadding + rightPadding, height + topPadding + bottomPadding)
+    }
+
+    // Opens the menu for `app` at (x, y) of its parent: below and to the right of that point, as macOS does, or to
+    // its left or above it where the parent ends. `byKey` highlights the first entry, as Windows does for a menu
+    // opened from the keyboard.
+    function openAt(app, list, x, y, byKey) {
+        entry = app
+        items = list
+        currentIndex = byKey ? 0 : -1
+        const size = measure(list)
+        const gap = Kirigami.Units.smallSpacing
+        width = size.width
+        height = size.height
+        const left = x + size.width + gap <= parent.width ? x : x - size.width
+        const top = y + size.height + gap <= parent.height ? y : y - size.height
+        menu.x = Math.max(gap, Math.min(left, parent.width - size.width - gap))
+        menu.y = Math.max(gap, Math.min(top, parent.height - size.height - gap))
+        open()
+    }
+
+    // Whether the item at `index` can be chosen: separators and titles cannot.
+    function choosable(index) {
+        const item = items[index]
+        return !!item && !item.separator && !item.title
+    }
+
+    function step(direction) {
+        for (let i = 1; i <= items.length; ++i) {
+            const next = ((currentIndex + direction * i) % items.length + items.length) % items.length
+            if (choosable(next)) {
+                currentIndex = next
+                return
+            }
+        }
+    }
+
+    function choose(index) {
+        if (choosable(index)) {
+            close()
+            chosen(entry, items[index].action)
+        }
+    }
+
+    enter: Transition {
+        NumberAnimation {
+            property: "opacity"; from: 0; to: 1
+            duration: Kirigami.Units.shortDuration; easing.type: Easing.OutCubic
+        }
+    }
+    exit: Transition {
+        NumberAnimation {
+            property: "opacity"; from: 1; to: 0
+            duration: Kirigami.Units.shortDuration; easing.type: Easing.InCubic
+        }
+    }
+
+    background: Kirigami.ShadowedRectangle {
+        radius: Math.round(Kirigami.Units.gridUnit * 0.7)
+        color: Qt.rgba(0.16, 0.155, 0.19, 0.97)
+        border.width: 1
+        border.color: Qt.rgba(1, 1, 1, 0.13)
+        shadow.size: Kirigami.Units.gridUnit * 1.5
+        shadow.yOffset: Kirigami.Units.smallSpacing * 2
+        shadow.color: Qt.rgba(0, 0, 0, 0.45)
+    }
+
+    contentItem: Column {
+        focus: true
+        Keys.onUpPressed: menu.step(-1)
+        Keys.onDownPressed: menu.step(1)
+        Keys.onReturnPressed: menu.choose(menu.currentIndex)
+        Keys.onEnterPressed: menu.choose(menu.currentIndex)
+
+        Repeater {
+            model: menu.items
+
+            delegate: Item {
+                id: row
+
+                required property var modelData
+                required property int index
+                readonly property bool separator: modelData.separator === true
+                readonly property bool title: modelData.title === true
+                readonly property bool highlighted: menu.currentIndex === index
+
+                width: menu.availableWidth
+                height: separator ? menu.separatorHeight : title ? menu.titleHeight : menu.rowHeight
+
+                Rectangle {
+                    visible: row.separator
+                    anchors.verticalCenter: parent.verticalCenter
+                    x: menu.rowPadding
+                    width: parent.width - x * 2
+                    height: 1
+                    color: Qt.rgba(1, 1, 1, 0.12)
+                }
+
+                Rectangle {
+                    visible: !row.separator && row.highlighted
+                    anchors.fill: parent
+                    radius: Math.round(Kirigami.Units.gridUnit * 0.4)
+                    color: Kirigami.Theme.highlightColor
+                }
+
+                // A heading among Plasma's actions, such as "Recent Files": small and dim, like macOS's section titles.
+                QQC2.Label {
+                    visible: row.title
+                    anchors.verticalCenter: parent.verticalCenter
+                    x: menu.rowPadding
+                    width: parent.width - x * 2
+                    text: row.modelData.label || ""
+                    elide: Text.ElideRight
+                    textFormat: Text.PlainText
+                    font.pointSize: Kirigami.Theme.smallFont.pointSize
+                    font.weight: Font.DemiBold
+                    color: Qt.rgba(1, 1, 1, 0.5)
+                }
+
+                Kirigami.Icon {
+                    id: icon
+                    visible: !row.separator && !row.title
+                    anchors.verticalCenter: parent.verticalCenter
+                    x: menu.rowPadding
+                    width: menu.iconSize
+                    height: menu.iconSize
+                    source: row.modelData.icon || ""
+                    fallback: row.modelData.fallback || ""
+                    isMask: true
+                    color: label.color
+                }
+
+                QQC2.Label {
+                    id: label
+                    visible: !row.separator && !row.title
+                    anchors.verticalCenter: parent.verticalCenter
+                    x: icon.x + icon.width + menu.iconGap
+                    width: parent.width - x - menu.rowPadding
+                    text: row.modelData.label || ""
+                    elide: Text.ElideRight
+                    textFormat: Text.PlainText
+                    color: row.highlighted ? Kirigami.Theme.highlightedTextColor : Qt.rgba(1, 1, 1, 0.92)
+                }
+
+                MouseArea {
+                    anchors.fill: parent
+                    enabled: menu.choosable(row.index)
+                    hoverEnabled: true
+                    cursorShape: Qt.PointingHandCursor
+                    onEntered: menu.currentIndex = row.index
+                    onExited: if (menu.currentIndex === row.index) menu.currentIndex = -1
+                    onClicked: menu.choose(row.index)
+                }
+
+                Accessible.role: row.separator ? Accessible.Separator
+                               : row.title ? Accessible.StaticText : Accessible.MenuItem
+                Accessible.name: row.modelData.label || ""
+                Accessible.onPressAction: menu.choose(row.index)
+            }
+        }
+    }
+
+    onOpened: contentItem.forceActiveFocus()
+}
diff -ruN -x '*.qsb' a/qml/QuickMenuRail.qml b/qml/QuickMenuRail.qml
--- a/qml/QuickMenuRail.qml	1969-12-31 19:00:00.000000000 -0500
+++ b/qml/QuickMenuRail.qml	2026-11-04 22:57:04.480906873 -0500
@@ -0,0 +1,171 @@
+/*
+    SPDX-FileCopyrightText: 2026 xt0n1 (https://github.com/xt0n1-t3ch)
+    SPDX-License-Identifier: GPL-2.0-or-later
+*/
+// The rail along the bottom of the Applications view, as in Windows 11's Start: the user's picture and name on the
+// left open the account menu (Lock, Switch User, Log Out), the power button on the right opens the power menu
+// (Sleep, Hibernate, Restart, Shut Down). Both menus are the Applications view's own menu (QuickMenuPopup.qml) and
+// list only what the session allows. Plasma's session manager does the work, with its own confirmation.
+import QtQuick
+import QtQuick.Controls as QQC2
+import QtQuick.Layouts
+import QtQuick.Templates as T
+
+import org.kde.coreaddons as KCoreAddons
+import org.kde.kirigami as Kirigami
+import org.kde.plasma.private.sessions as Sessions
+
+import "quickmenu.js" as QuickMenu
+
+Item {
+    id: rail
+
+    // The item the menus open in: the whole panel, so they can rise above the rail.
+    required property Item menuParent
+    // Asked before an action that leaves the desktop, so the panel can close first.
+    signal leaving()
+
+    implicitHeight: Math.round(Kirigami.Units.gridUnit * 3.2)
+
+    KCoreAddons.KUser {
+        id: user
+    }
+
+    Sessions.SessionManagement {
+        id: session
+    }
+
+    function run(action) {
+        rail.leaving()
+        QuickMenu.runSessionAction(session, action)
+    }
+
+    // Opens `list` above `button`, its left edge (or right edge, for the power menu) lined up with the button's.
+    function openMenu(button, list, alignRight) {
+        const corner = button.mapToItem(menuParent, alignRight ? button.width : 0, 0)
+        const size = menu.measure(list)
+        menu.openAt(null, list, alignRight ? corner.x - size.width : corner.x, corner.y - size.height - Kirigami.Units.smallSpacing, false)
+    }
+
+    QuickMenuPopup {
+        id: menu
+        parent: rail.menuParent
+        onChosen: (entry, action) => {
+            menu.close()
+            rail.run(action)
+        }
+    }
+
+    Rectangle {
+        id: hairline
+        x: Math.round(Kirigami.Units.gridUnit * 1.1)
+        width: parent.width - 2 * x
+        height: 1
+        color: Qt.rgba(1, 1, 1, 0.14)
+    }
+
+    RowLayout {
+        anchors {
+            fill: parent
+            topMargin: 1
+            leftMargin: Math.round(Kirigami.Units.gridUnit * 0.7)
+            rightMargin: Math.round(Kirigami.Units.gridUnit * 0.7)
+        }
+        spacing: Kirigami.Units.largeSpacing
+
+        // The account: picture and name, one rounded hover area, as Windows draws it.
+        T.AbstractButton {
+            id: account
+            Layout.alignment: Qt.AlignVCenter
+            implicitHeight: Math.round(Kirigami.Units.gridUnit * 2.3)
+            implicitWidth: accountRow.implicitWidth + 2 * Kirigami.Units.mediumSpacing
+            Accessible.name: i18n("Account: %1", nameLabel.text)
+            background: Rectangle {
+                radius: height / 2
+                color: Qt.rgba(1, 1, 1, account.down ? 0.16 : account.hovered ? 0.10 : 0)
+                Behavior on color { ColorAnimation { duration: Kirigami.Units.shortDuration } }
+            }
+            contentItem: RowLayout {
+                id: accountRow
+                spacing: Kirigami.Units.mediumSpacing + Kirigami.Units.smallSpacing
+                Item {
+                    Layout.preferredWidth: Math.round(Kirigami.Units.gridUnit * 1.75)
+                    Layout.preferredHeight: Layout.preferredWidth
+                    Rectangle {
+                        anchors.fill: parent
+                        radius: width / 2
+                        color: Kirigami.Theme.highlightColor
+                        visible: face.status !== Image.Ready
+                        Kirigami.Icon {
+                            anchors.centerIn: parent
+                            width: Math.round(parent.width * 0.62)
+                            height: width
+                            source: "user-symbolic"
+                            color: "white"
+                            isMask: true
+                        }
+                    }
+                    Kirigami.ShadowedImage {
+                        id: face
+                        anchors.fill: parent
+                        source: user.faceIconUrl
+                        radius: width / 2
+                        sourceSize: Qt.size(width * 2, height * 2)
+                        fillMode: Image.PreserveAspectCrop
+                        visible: status === Image.Ready
+                    }
+                }
+                QQC2.Label {
+                    id: nameLabel
+                    text: user.fullName || user.loginName
+                    color: Qt.rgba(1, 1, 1, 0.92)
+                    font.weight: Font.Medium
+                    textFormat: Text.PlainText
+                    elide: Text.ElideRight
+                    Layout.maximumWidth: Kirigami.Units.gridUnit * 12
+                }
+            }
+            HoverHandler {
+                cursorShape: Qt.PointingHandCursor
+            }
+            onClicked: rail.openMenu(account, QuickMenu.accountItems(session), false)
+        }
+
+        Item {
+            Layout.fillWidth: true
+        }
+
+        // The power button: a round glass button, as the Control Center's.
+        T.AbstractButton {
+            id: power
+            Layout.alignment: Qt.AlignVCenter
+            implicitWidth: Math.round(Kirigami.Units.gridUnit * 2.3)
+            implicitHeight: implicitWidth
+            Accessible.name: i18n("Power")
+            QQC2.ToolTip.visible: hovered && !menu.opened
+            QQC2.ToolTip.text: Accessible.name
+            QQC2.ToolTip.delay: Kirigami.Units.toolTipDelay
+            background: Rectangle {
+                radius: width / 2
+                color: Qt.rgba(1, 1, 1, power.down ? 0.18 : power.hovered ? 0.12 : 0.06)
+                border.width: 1
+                border.color: Qt.rgba(1, 1, 1, 0.10)
+                Behavior on color { ColorAnimation { duration: Kirigami.Units.shortDuration } }
+            }
+            contentItem: Item {
+                Kirigami.Icon {
+                    anchors.centerIn: parent
+                    width: Kirigami.Units.iconSizes.smallMedium
+                    height: width
+                    source: "system-shutdown-symbolic"
+                    color: Qt.rgba(1, 1, 1, 0.9)
+                    isMask: true
+                }
+            }
+            HoverHandler {
+                cursorShape: Qt.PointingHandCursor
+            }
+            onClicked: rail.openMenu(power, QuickMenu.powerItems(session), true)
+        }
+    }
+}
diff -ruN -x '*.qsb' a/qml/QuickMenuResult.qml b/qml/QuickMenuResult.qml
--- a/qml/QuickMenuResult.qml	1969-12-31 19:00:00.000000000 -0500
+++ b/qml/QuickMenuResult.qml	2026-11-04 22:29:45.209073783 -0500
@@ -0,0 +1,184 @@
+/*
+    SPDX-FileCopyrightText: 2013-2014 Vishesh Handa <me@vhanda.in>
+    SPDX-FileCopyrightText: 2015-2016 Kai Uwe Broulik <kde@privat.broulik.de>
+    SPDX-FileCopyrightText: 2026 xt0n1-t3ch
+    SPDX-License-Identifier: LGPL-2.1-only OR LGPL-3.0-only OR LicenseRef-KDE-Accepted-LGPL
+*/
+// A search result as Tahoe's Spotlight lists it: icon, name and a quieter second line, the selected row filled
+// with the accent colour. It keeps Milou's ResultDelegate contract (actions, activeAction and the activate*Action
+// functions that Milou.ResultsView calls on Tab), its click-to-run and its drag-out of files and links.
+import QtQuick
+import QtQuick.Layouts
+import QtQuick.Templates as T
+import QtQuick.Controls as QQC2
+import org.kde.kirigami as Kirigami
+import org.kde.milou as Milou
+
+T.ItemDelegate {
+    id: result
+
+    required property int index
+    required property var model
+    required property var actions
+
+    property int activeAction: -1
+    readonly property bool isCurrent: ListView.isCurrentItem
+    readonly property color ink: isCurrent ? Kirigami.Theme.highlightedTextColor : Qt.rgba(1, 1, 1, 0.94)
+
+    width: ListView.view ? ListView.view.width - ListView.view.leftMargin - ListView.view.rightMargin : implicitWidth
+    implicitHeight: Math.max(Kirigami.Units.iconSizes.medium, labels.implicitHeight) + 2 * Kirigami.Units.mediumSpacing
+    hoverEnabled: true
+
+    Accessible.role: Accessible.ListItem
+    Accessible.name: title.text
+    Accessible.description: String(model.subtext || "")
+
+    onIsCurrentChanged: if (!isCurrent) activeAction = -1
+
+    function activateNextAction() {
+        if (activeAction === actionButtons.count - 1) {
+            return false
+        }
+        ++activeAction
+        return true
+    }
+    function activatePreviousAction() {
+        if (activeAction < 0) {
+            return false
+        }
+        --activeAction
+        return true
+    }
+    function activateLastAction() {
+        activeAction = actionButtons.count - 1
+    }
+
+    onClicked: {
+        ListView.view.currentIndex = index
+        ListView.view.runCurrentIndex()
+    }
+    onHoveredChanged: if (hovered) ListView.view.currentIndex = index
+
+    background: Rectangle {
+        radius: Kirigami.Units.cornerRadius * 2
+        color: result.isCurrent ? Kirigami.Theme.highlightColor : "transparent"
+    }
+
+    HoverHandler {
+        cursorShape: Qt.PointingHandCursor
+    }
+
+    Item {
+        id: dragHelper
+        Drag.dragType: Drag.Automatic
+        Drag.supportedActions: Qt.CopyAction | Qt.LinkAction
+        Drag.onDragFinished: {
+            Drag.mimeData = {}
+            Drag.imageSource = ""
+        }
+    }
+    DragHandler {
+        id: drag
+        target: null
+        grabPermissions: PointerHandler.TakeOverForbidden
+        onActiveChanged: if (active) {
+            icon.grabToImage(grab => {
+                const view = result.ListView.view
+                const mimeData = view.model.getMimeData(view.model.index(result.index, 0))
+                if (!mimeData) {
+                    return
+                }
+                dragHelper.Drag.imageSource = grab.url
+                dragHelper.Drag.mimeData = Milou.MouseHelper.generateMimeDataMap(mimeData)
+                dragHelper.Drag.active = drag.active
+            })
+        } else {
+            dragHelper.Drag.active = false
+        }
+    }
+
+    leftPadding: Kirigami.Units.mediumSpacing
+    rightPadding: Kirigami.Units.mediumSpacing
+
+    contentItem: RowLayout {
+        spacing: Kirigami.Units.largeSpacing
+
+        Kirigami.Icon {
+            id: icon
+            Layout.preferredWidth: Kirigami.Units.iconSizes.medium
+            Layout.preferredHeight: Kirigami.Units.iconSizes.medium
+            Layout.alignment: Qt.AlignVCenter
+            source: result.model.decoration
+            animated: false
+        }
+
+        ColumnLayout {
+            id: labels
+            Layout.fillWidth: true
+            spacing: 0
+
+            QQC2.Label {
+                id: title
+                Layout.fillWidth: true
+                text: result.model.display
+                color: result.ink
+                elide: Text.ElideMiddle
+                wrapMode: result.model.multiLine ? Text.WordWrap : Text.NoWrap
+                maximumLineCount: result.model.multiLine ? 20 : 1
+                // Multi-line answers (a calculation, a definition) come styled; one-liners are plain names.
+                textFormat: result.model.multiLine ? Text.StyledText : Text.PlainText
+            }
+            QQC2.Label {
+                Layout.fillWidth: true
+                visible: text.length > 0
+                text: String(result.model.subtext || "")
+                color: result.ink
+                opacity: 0.62
+                font: Kirigami.Theme.smallFont
+                elide: Text.ElideMiddle
+                maximumLineCount: 1
+                textFormat: Text.PlainText
+            }
+        }
+
+        Row {
+            Layout.alignment: Qt.AlignVCenter
+            spacing: Kirigami.Units.smallSpacing
+            visible: result.isCurrent && actionButtons.count > 0
+
+            Repeater {
+                id: actionButtons
+                model: result.actions
+
+                T.AbstractButton {
+                    id: actionButton
+                    required property var modelData
+                    required property int index
+                    width: Kirigami.Units.iconSizes.medium
+                    height: width
+                    Accessible.role: Accessible.Button
+                    Accessible.name: modelData.text || ""
+                    QQC2.ToolTip.visible: hovered
+                    QQC2.ToolTip.text: index === 0 ? i18ndc("milou", "placeholder is action e.g. run in terminal, in parenthesis is shortcut",
+                                                            "%1 (Shift+Return)", modelData.text || "")
+                                                   : (modelData.text || "")
+                    background: Rectangle {
+                        radius: width / 2
+                        color: Qt.rgba(1, 1, 1, result.activeAction === actionButton.index || actionButton.hovered ? 0.28 : 0.14)
+                    }
+                    contentItem: Kirigami.Icon {
+                        source: actionButton.modelData.iconSource || ""
+                        implicitWidth: Kirigami.Units.iconSizes.small
+                        implicitHeight: Kirigami.Units.iconSizes.small
+                        color: result.ink
+                        isMask: true
+                    }
+                    HoverHandler {
+                        cursorShape: Qt.PointingHandCursor
+                    }
+                    onClicked: result.ListView.view.runAction(index)
+                }
+            }
+        }
+    }
+}
diff -ruN -x '*.qsb' a/qml/QuickMenuScrollBar.qml b/qml/QuickMenuScrollBar.qml
--- a/qml/QuickMenuScrollBar.qml	1969-12-31 19:00:00.000000000 -0500
+++ b/qml/QuickMenuScrollBar.qml	2026-11-04 22:29:45.209073783 -0500
@@ -0,0 +1,28 @@
+/*
+    SPDX-FileCopyrightText: 2026 xt0n1-t3ch
+    SPDX-License-Identifier: GPL-2.0-or-later
+*/
+// macOS's overlay scroll bar: a slim rounded thumb over the content, shown while scrolling or under the pointer and
+// faded out otherwise.
+import QtQuick
+import QtQuick.Templates as T
+import org.kde.kirigami as Kirigami
+
+T.ScrollBar {
+    id: bar
+
+    implicitWidth: Kirigami.Units.smallSpacing * 2 + padding * 2
+    padding: Kirigami.Units.smallSpacing / 2
+    minimumSize: 0.1
+    visible: size < 1
+
+    contentItem: Rectangle {
+        implicitWidth: Kirigami.Units.smallSpacing * (bar.hovered || bar.pressed ? 2 : 1.4)
+        radius: width / 2
+        color: Qt.rgba(1, 1, 1, bar.pressed ? 0.55 : 0.38)
+        opacity: bar.active || bar.hovered ? 1 : 0
+        Behavior on opacity {
+            NumberAnimation { duration: Kirigami.Units.longDuration }
+        }
+    }
+}
diff -ruN -x '*.qsb' a/qml/QuickMenuTile.qml b/qml/QuickMenuTile.qml
--- a/qml/QuickMenuTile.qml	1969-12-31 19:00:00.000000000 -0500
+++ b/qml/QuickMenuTile.qml	2026-11-04 22:56:30.597975363 -0500
@@ -0,0 +1,151 @@
+/*
+    SPDX-FileCopyrightText: 2026 xt0n1-t3ch
+    SPDX-License-Identifier: GPL-2.0-or-later
+*/
+// One app of the Applications view: its large icon over its name, as Tahoe's Spotlight shows apps. One soft rounded
+// highlight marks the selected app, which the pointer takes only when it moves (an app that happens to lie under a
+// resting pointer when Quick Menu opens is not selected, so Return cannot launch it by surprise); the icon dips a
+// little while pressed. A draggable tile can be dragged onto another app of its section: its icon follows the
+// pointer, the app under it lights up, and the drop moves the app there.
+import QtQuick
+import QtQuick.Controls as QQC2
+import org.kde.kirigami as Kirigami
+
+Item {
+    id: tile
+
+    property var icon
+    property string label
+    property bool current: false
+    property int iconSize: Kirigami.Units.iconSizes.huge
+    // Its place in its section, whether it may be dragged, and the key only tiles of the same section share.
+    property int position: -1
+    property bool draggable: false
+    property string dropKey: ""
+    readonly property bool dragging: pointer.drag.active
+    readonly property bool dropTarget: drop.containsDrag && drop.drag.source !== tile
+
+    signal activated()
+    // An app of the same section, at `from`, was dropped on this one, at `to`.
+    signal moved(int from, int to)
+    // The pointer moved over the tile, at this global position (QuickMenuApps tells real motion from the hover
+    // events Qt sends when the content moves under a resting pointer).
+    signal pointed(point position)
+    // A right-click asked for the app's menu, at this global position.
+    signal menuRequested(point position)
+
+    implicitHeight: Kirigami.Units.largeSpacing + iconSize + Kirigami.Units.mediumSpacing + name.implicitHeight
+                    + Kirigami.Units.largeSpacing
+    // The dragged icon draws above the tiles after it in the grid.
+    z: dragging ? 10 : 0
+
+    Accessible.role: Accessible.Button
+    Accessible.name: label
+    Accessible.onPressAction: tile.activated()
+
+    Rectangle {
+        anchors.fill: parent
+        anchors.margins: Kirigami.Units.smallSpacing / 2
+        radius: Kirigami.Units.cornerRadius * 2.5
+        color: Qt.rgba(1, 1, 1, tile.dropTarget ? 0.22 : tile.current ? 0.16 : 0)
+        Behavior on color {
+            ColorAnimation { duration: Kirigami.Units.shortDuration }
+        }
+    }
+
+    Kirigami.Icon {
+        id: image
+        anchors.horizontalCenter: parent.horizontalCenter
+        y: Kirigami.Units.largeSpacing
+        width: tile.iconSize
+        height: tile.iconSize
+        source: tile.icon
+        animated: false
+        opacity: tile.dragging ? 0.35 : 1
+        scale: pointer.pressed ? 0.92 : 1
+        Behavior on scale {
+            NumberAnimation { duration: Kirigami.Units.shortDuration; easing.type: Easing.OutCubic }
+        }
+    }
+
+    QQC2.Label {
+        id: name
+        anchors.top: image.bottom
+        anchors.topMargin: Kirigami.Units.mediumSpacing
+        anchors.horizontalCenter: parent.horizontalCenter
+        width: parent.width - 2 * Kirigami.Units.smallSpacing
+        horizontalAlignment: Text.AlignHCenter
+        elide: Text.ElideRight
+        maximumLineCount: 1
+        textFormat: Text.PlainText
+        text: tile.label
+        color: Qt.rgba(1, 1, 1, 0.92)
+    }
+
+    // What follows the pointer while the app is dragged.
+    Kirigami.Icon {
+        id: ghost
+        x: image.x
+        y: image.y
+        width: tile.iconSize
+        height: tile.iconSize
+        visible: tile.dragging
+        source: tile.icon
+        animated: false
+        Drag.active: tile.dragging
+        Drag.source: tile
+        Drag.keys: [tile.dropKey]
+        Drag.hotSpot.x: width / 2
+        Drag.hotSpot.y: height / 2
+    }
+
+    DropArea {
+        id: drop
+        anchors.fill: parent
+        keys: [tile.dropKey]
+        onDropped: event => {
+            if (event.source !== tile && event.source.position >= 0) {
+                event.accept()
+                tile.moved(event.source.position, tile.position)
+            }
+        }
+    }
+
+    MouseArea {
+        id: pointer
+        // A drag is a move, not a click: the release that ends it must not launch the app.
+        property bool dragged: false
+        anchors.fill: parent
+        hoverEnabled: true
+        acceptedButtons: Qt.LeftButton | Qt.RightButton
+        cursorShape: tile.dragging ? Qt.ClosedHandCursor : Qt.PointingHandCursor
+        // Only the left button drags; the right one opens the menu.
+        drag.target: tile.draggable && pressedButtons === Qt.LeftButton ? ghost : null
+        // Inside the scrolling view a drag on a tile moves the app; the wheel and the scroll bar still scroll.
+        preventStealing: tile.draggable
+        onPressed: mouse => {
+            dragged = false
+            if (mouse.button === Qt.RightButton) {
+                tile.menuRequested(mapToGlobal(mouse.x, mouse.y))
+            }
+        }
+        onPositionChanged: mouse => {
+            if (drag.active) {
+                dragged = true
+            }
+            tile.pointed(mapToGlobal(mouse.x, mouse.y))
+        }
+        onReleased: {
+            if (dragged) {
+                ghost.Drag.drop()
+            }
+            ghost.x = image.x
+            ghost.y = image.y
+        }
+        onClicked: mouse => {
+            if (mouse.button === Qt.LeftButton && !dragged) {
+                tile.activated()
+            }
+        }
+    }
+}
