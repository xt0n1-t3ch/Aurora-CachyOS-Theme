diff -ruN a/components/BannerButton.qml b/components/BannerButton.qml
--- a/components/BannerButton.qml	1969-12-31 19:00:00.000000000 -0500
+++ b/components/BannerButton.qml	2026-11-07 07:28:42.269702146 -0500
@@ -0,0 +1,52 @@
+/*
+    SPDX-FileCopyrightText: 2026 xt0n1-t3ch
+    SPDX-License-Identifier: GPL-2.0-only OR GPL-3.0-only OR LicenseRef-KDE-Accepted-GPL
+*/
+// The small round glass button that a notification shows on hover, overhanging one of its corners as macOS does:
+// Clear at the top-left, Plasma's per-app settings at the top-right. Banners and the popover's rows share it.
+import QtQuick
+
+import org.kde.kirigami as Kirigami
+
+Rectangle {
+    id: button
+
+    // How far the button reaches past the corner it sits on.
+    readonly property int overhang: Math.round(width / 3)
+    property string iconName
+    property string text
+    // Whether the button is shown; it fades rather than pops, and takes no clicks while hidden.
+    property bool shown
+    signal clicked
+
+    width: Kirigami.Units.iconSizes.small + Kirigami.Units.smallSpacing * 2
+    height: width
+    radius: width / 2
+    color: buttonArea.containsMouse ? Qt.rgba(0.30, 0.30, 0.33, 0.96) : Qt.rgba(0.20, 0.20, 0.22, 0.94)
+    border.color: Qt.rgba(1, 1, 1, 0.16)
+    border.width: 1
+    opacity: shown ? 1 : 0
+    enabled: opacity > 0
+    Behavior on opacity {
+        NumberAnimation { duration: Kirigami.Units.shortDuration; easing.type: Easing.OutCubic }
+    }
+    Accessible.role: Accessible.Button
+    Accessible.name: text
+
+    Kirigami.Icon {
+        anchors.centerIn: parent
+        width: Math.round(parent.width * 0.55)
+        height: width
+        source: button.iconName
+        color: "#ffffff"
+        isMask: true
+    }
+
+    MouseArea {
+        id: buttonArea
+        anchors.fill: parent
+        hoverEnabled: true
+        cursorShape: Qt.PointingHandCursor
+        onClicked: button.clicked()
+    }
+}
diff -ruN a/components/BannerGlass.qml b/components/BannerGlass.qml
--- a/components/BannerGlass.qml	1969-12-31 19:00:00.000000000 -0500
+++ b/components/BannerGlass.qml	2026-11-05 02:44:25.329077389 -0500
@@ -0,0 +1,36 @@
+/*
+    SPDX-FileCopyrightText: 2026 xt0n1-t3ch
+    SPDX-License-Identifier: GPL-2.0-only OR GPL-3.0-only OR LicenseRef-KDE-Accepted-GPL
+*/
+// The notification banner's Liquid Glass, the same material as the Control Center's modules (its Glass.qml and
+// glass.frag): frosted by KWin behind its rounded shape (BannerBlur finds it through glassBlur), tinted, with a rim
+// lit from above and a soft shadow drawn into the window's transparent margin.
+import QtQuick
+
+Item {
+    id: glass
+
+    property real radius: 22
+    readonly property bool glassBlur: true
+
+    ShaderEffect {
+        readonly property real pad: Math.ceil(shadowSize * 1.6)
+        z: -1
+        x: -pad
+        y: -pad
+        width: glass.width + 2 * pad
+        height: glass.height + 2 * pad
+        property size boxSize: Qt.size(glass.width, glass.height)
+        property real radius: glass.radius
+        // Darker and denser than the Control Center's modules: a banner lands on any window, white pages included,
+        // and its white text has to stay readable there, as macOS's notification material does.
+        property vector4d tint: Qt.vector4d(0.13, 0.13, 0.15, 0.78)
+        property vector4d rimLight: Qt.vector4d(1, 1, 1, 0.55)
+        property vector4d rimShade: Qt.vector4d(1, 1, 1, 0.09)
+        property real rimWidth: 1.0
+        property real sheen: 0.06
+        property real shadowAlpha: 0.22
+        property real shadowSize: 12
+        fragmentShader: Qt.resolvedUrl("../shaders/glass.frag.qsb")
+    }
+}
