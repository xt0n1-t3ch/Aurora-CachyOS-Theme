# Aurora: tells xdg-desktop-portal that File Explorer provides the FileChooser portal in KDE sessions. The D-Bus
# service that starts it is written by installer/install.py.
[portal]
DBusName=org.freedesktop.impl.portal.desktop.aurora
Interfaces=org.freedesktop.impl.portal.FileChooser
UseIn=KDE
