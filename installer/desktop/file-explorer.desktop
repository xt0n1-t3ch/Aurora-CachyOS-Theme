# Aurora: the launcher of File Explorer. installer/install.py writes the path of the installed binary into Exec.
[Desktop Entry]
Type=Application
Name=File Explorer
Comment=Browse your files
Exec=@FILE_EXPLORER@ %U
Icon=file-explorer-mac
Categories=System;FileManager;
MimeType=inode/directory;
StartupWMClass=file-explorer
