# Aurora: the menu bar's Quick Menu button runs this entry, which toggles KRunner's window through D-Bus.
# NoDisplay keeps it out of the application menus.
[Desktop Entry]
Type=Application
Name=Quick Menu
Exec=qdbus6 org.kde.krunner /App org.kde.krunner.App.toggleDisplay
Icon=system-search-symbolic
NoDisplay=true
