# File Explorer's whole-disk search: systemd holds this socket and starts aurora-search on the first connection,
# so nothing runs until File Explorer is used (docs/search.md).
[Unit]
Description=File Explorer's whole-disk search (Aurora)

[Socket]
ListenSequentialPacket=/run/aurora/search.sock
# Every user may ask; the helper shows each one only what that user may reach.
SocketMode=0666
DirectoryMode=0755

[Install]
WantedBy=sockets.target
