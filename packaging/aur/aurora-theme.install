# Aurora installs per user: the package holds the files, `aurora` sets up the desktop of whoever runs it.

post_install() {
    echo ':: Aurora is installed. Run `aurora` as your own user (not with sudo) to set up your desktop,'
    echo '   then log out and back in.'
}

post_upgrade() {
    echo ':: Aurora was updated. `aurora update` applies it by itself; after a plain pacman -Syu, run'
    echo '   `aurora install --yes` as your own user. Then log out and back in.'
}

pre_remove() {
    echo ':: Before removing the package, run `aurora uninstall` as each user who installed Aurora, so their'
    echo '   desktop goes back to how it was.'
}
